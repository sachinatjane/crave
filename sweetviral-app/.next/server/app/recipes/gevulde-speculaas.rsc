10:T1100,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/gevulde-speculaas/","name":"Gevulde speculaas","image":["https://crave.devyy.com/ai-images/gevulde-speculaas.jpg","https://crave.devyy.com/ai-images/gevulde-speculaas.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Netherlands-inspired gevulde speculaas with 10 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (4 servings). 4.7★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"4 servings","recipeCategory":"Global Classics","recipeCuisine":"Netherlands","keywords":"Gevulde speculaas, Netherlands, Global Classics, #Gevuldespecul, #CraveMadeMeDoIt, #ViralDesserts, #NetherlandsSweets","nutrition":{"@type":"NutritionInformation","calories":"339 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.7,"reviewCount":89},"recipeIngredient":["1.33 cup Self-raising Flour","10 tbsp Brown Sugar","2 tsp Speculaas Spice Mix","1 pinch Salt","8.3 tbsp Butter","10 tbsp Milk","1.33 cup Almond Paste","1 whole Egg","1 for brushing Milk","1 garnish Almonds"],"recipeInstructions":[{"@type":"HowToStep","name":"Shape & Press Dough Evenly","text":"Mix the self-rising flour, sugar, speculaas spice mix and salt. Add the butter and milk and knead into a firm ball of dough. Start with 6 tablespoons of milk, if the dough is too stiff you can add more milk. Wrap the dough in plastic wrap and refrigerate overnight. You can process and bake it immediately, but the flavor will be much better if you let it rest. Incorporate 1.33 cup self-raising flour, 10 tbsp brown sugar, 2 tsp speculaas spice mix, and 1 pinch salt smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/gevulde-speculaas/#step-1"},{"@type":"HowToStep","name":"Shape & Press Dough Evenly","text":"Mix the almond paste with half of the beaten egg and knead well. This makes it easier to work with and gives it a better and tastier texture. Take half of the dough and roll it out to 20 x 20 cm. Place in a baking pan lined with parchment paper. Spread the almond paste mixture evenly. Roll out the remaining dough and place on top of the almond paste. Incorporate 8.3 tbsp butter, 10 tbsp milk, 1.33 cup almond paste, 1 whole egg, 1 for brushing milk, and 1 garnish almonds smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/gevulde-speculaas/#step-2"},{"@type":"HowToStep","name":"Bake Gevulde speculaas & Check Doneness","text":"Bake for 30 minutes until the edges turn golden and set while the center remains tender. Test with a toothpick—if it comes out with a few moist crumbs rather than wet batter, it is ready.","url":"https://crave.devyy.com/recipes/gevulde-speculaas/#step-3"},{"@type":"HowToStep","name":"Cool, Garnish & Serve","text":"Brush the top with the remaining beaten egg. Garnish with almonds and top with another layer of egg wash. Bake the filled speculaas for 40 minutes at 180°C/350℉ (conventional oven) or until done.","url":"https://crave.devyy.com/recipes/gevulde-speculaas/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"Gevulde speculaas","item":"https://crave.devyy.com/recipes/gevulde-speculaas/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Gevulde speculaas?","acceptedAnswer":{"@type":"Answer","text":"Gevulde speculaas takes 45 minutes total (15 minutes prep) and yields 4 servings at 339 calories per serving."}},{"@type":"Question","name":"Can I make Gevulde speculaas healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Gevulde speculaas recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
