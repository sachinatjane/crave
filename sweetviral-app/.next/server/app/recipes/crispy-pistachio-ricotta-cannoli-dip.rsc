10:T103c,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/crispy-pistachio-ricotta-cannoli-dip/","name":"Crispy Pistachio Ricotta Cannoli Dip","image":["https://crave.devyy.com/ai-images/crispy-pistachio-ricotta-cannoli-dip.jpg","https://crave.devyy.com/ai-images/crispy-pistachio-ricotta-cannoli-dip.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_kitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"All the flavor of Sicilian cannoli in a 5-minute no-bake whipped ricotta dip with waffle chips. Ready in 8 mins (6 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT8M","cookTime":"PT0M","totalTime":"PT8M","recipeYield":"6 servings","recipeCategory":"Cheesecake & Tiramisu","recipeCuisine":"Italian","keywords":"Crispy Pistachio Ricotta Cannoli Dip, Italian, Cheesecake & Tiramisu, #CannoliDip, #CraveMadeMeDoIt, #ViralDesserts, #ItalianSweets","nutrition":{"@type":"NutritionInformation","calories":"270 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":167},"recipeIngredient":["1 cup Whole-milk ricotta (drained)","0.5 cup Mascarpone or cream cheese + 1/2 cup powdered sugar","0.5 cup Mini chocolate chips + crushed pistachios"],"recipeInstructions":[{"@type":"HowToStep","name":"Preheat Waffle Iron & Prep Batter","text":"Preheat your waffle iron or griddle to medium-high heat and brush lightly with butter or neutral oil. Measure out 1 cup whole-milk ricotta (drained) and 0.5 cup mascarpone or cream cheese + 1/2 cup powdered sugar in a mixing bowl so the batter or dough is ready as soon as the iron is hot.","url":"https://crave.devyy.com/recipes/crispy-pistachio-ricotta-cannoli-dip/#step-1"},{"@type":"HowToStep","name":"Whip Ricotta Smooth & Fold Chips","text":"Whip 1 cup whole-milk ricotta (drained) and 0.5 cup mascarpone or cream cheese + 1/2 cup powdered sugar with a pinch of cinnamon until fluffy. Fold in 0.5 cup mini chocolate chips + crushed pistachios and serve immediately with broken waffle cones!","url":"https://crave.devyy.com/recipes/crispy-pistachio-ricotta-cannoli-dip/#step-2"},{"@type":"HowToStep","name":"Combine Wet & Dry Smoothly","text":"Fold 0.5 cup mini chocolate chips + crushed pistachios into the base in two additions using gentle strokes until glossy and uniform with zero dry pockets. Avoid overmixing so the final texture stays light and tender.","url":"https://crave.devyy.com/recipes/crispy-pistachio-ricotta-cannoli-dip/#step-3"},{"@type":"HowToStep","name":"Cool 1 Minute on Rack & Plate","text":"Transfer Crispy Pistachio Ricotta Cannoli Dip onto a wire rack for 60 seconds so steam escapes and the outside stays crisp. Top with 0.5 cup mini chocolate chips + crushed pistachios and serve immediately into 6 portions.","url":"https://crave.devyy.com/recipes/crispy-pistachio-ricotta-cannoli-dip/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Cheesecake & Tiramisu","item":"https://crave.devyy.com/category/cheesecake-tiramisu/"},{"@type":"ListItem","position":3,"name":"Crispy Pistachio Ricotta Cannoli Dip","item":"https://crave.devyy.com/recipes/crispy-pistachio-ricotta-cannoli-dip/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Crispy Pistachio Ricotta Cannoli Dip?","acceptedAnswer":{"@type":"Answer","text":"Crispy Pistachio Ricotta Cannoli Dip takes 8 minutes total (8 minutes prep) and yields 6 servings at 270 calories per serving."}},{"@type":"Question","name":"Can I make Crispy Pistachio Ricotta Cannoli Dip healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Crispy Pistachio Ricotta Cannoli Dip recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
