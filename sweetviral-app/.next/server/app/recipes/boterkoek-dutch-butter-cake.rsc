10:T11c7,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/boterkoek-dutch-butter-cake/","name":"Boterkoek (Dutch Butter Cake)","image":["https://crave.devyy.com/ai-images/boterkoek-dutch-butter-cake.jpg","https://crave.devyy.com/ai-images/boterkoek-dutch-butter-cake.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Netherlands-inspired boterkoek (dutch butter cake) with 7 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (6 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"6 servings","recipeCategory":"Cakes & Mug Cakes","recipeCuisine":"Netherlands","keywords":"Boterkoek (Dutch Butter Cake), Netherlands, Cakes & Mug Cakes, #BoterkoekDut, #CraveMadeMeDoIt, #ViralDesserts, #NetherlandsSweets","nutrition":{"@type":"NutritionInformation","calories":"283 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":231},"recipeIngredient":["0.89 cup Butter","0.89 cup Sugar","1.11 cup All purpose flour","1 whole Salt","0.89 cup Dulce de leche","5 tbsp Dark Chocolate","1 beaten Egg"],"recipeInstructions":[{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Preheat the oven to 180°C/350˚F (conventional oven). Place the softened butter and sugar in the bowl of a stand mixer and whisk until creamy. Add the flour and salt and knead by hand until you have a smooth dough. Divide into two pieces. Incorporate 0.89 cup butter, 0.89 cup sugar, 1.11 cup all purpose flour, and 1 whole salt smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/boterkoek-dutch-butter-cake/#step-1"},{"@type":"HowToStep","name":"Fold In Flavorings & Mix-Ins","text":"Line the base of a square or round cake tin with baking parchment (not a springform tin) and place the first half of the pastry on top. Flatten with your fingers and a spoon. Using a teaspoon, sprinkle dollops of dulce de leche over the base. Sprinkle with the chopped chocolate and cover with the second half of the pastry. This is a bit trickier, but if you don’t get it right, don’t worry, it’ll be fine once it’s baked! Brush the pastry with the beaten egg. Incorporate 0.89 cup dulce de leche, 5 tbsp dark chocolate, and 1 beaten egg smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/boterkoek-dutch-butter-cake/#step-2"},{"@type":"HowToStep","name":"Bake Boterkoek (Dutch Butter Cake) & Check Doneness","text":"Bake for 30 minutes until the edges turn golden and set while the center remains tender. Test with a toothpick—if it comes out with a few moist crumbs rather than wet batter, it is ready.","url":"https://crave.devyy.com/recipes/boterkoek-dutch-butter-cake/#step-3"},{"@type":"HowToStep","name":"Cool, Garnish & Serve","text":"Bake in the oven for about 30 minutes or until golden brown. It will be wobbly. That's because butter cake only firms up when it cools. Cut into small pieces when it has cooled completely! Storing: Store in an airtight container outside of the fridge for about 2-3 days or in the fridge for 5 days. Freeze for up to three months.","url":"https://crave.devyy.com/recipes/boterkoek-dutch-butter-cake/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Cakes & Mug Cakes","item":"https://crave.devyy.com/category/cakes-cupcakes/"},{"@type":"ListItem","position":3,"name":"Boterkoek (Dutch Butter Cake)","item":"https://crave.devyy.com/recipes/boterkoek-dutch-butter-cake/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Boterkoek (Dutch Butter Cake)?","acceptedAnswer":{"@type":"Answer","text":"Boterkoek (Dutch Butter Cake) takes 45 minutes total (15 minutes prep) and yields 6 servings at 283 calories per serving."}},{"@type":"Question","name":"Can I make Boterkoek (Dutch Butter Cake) healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Boterkoek (Dutch Butter Cake) recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
