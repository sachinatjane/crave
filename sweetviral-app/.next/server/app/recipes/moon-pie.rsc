10:Tf4d,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/moon-pie/","name":"Moon Pie","image":["https://crave.devyy.com/ai-images/moon-pie.jpg","https://crave.devyy.com/ai-images/moon-pie.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_us_eu"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Viral American moon pie crafted for mobile Cook Mode & 1-tap Story sharing. Ready in 50 mins (8 servings). 4.8★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT35M","totalTime":"PT50M","recipeYield":"8 servings","recipeCategory":"Pies, Tarts & Crumbles","recipeCuisine":"American","keywords":"Moon Pie, American, Pies, Tarts & Crumbles, #MoonPie, #CraveMadeMeDoIt, #ViralDesserts, #AmericanSweets","nutrition":{"@type":"NutritionInformation","calories":"340 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":221},"recipeIngredient":["1 batch All-butter pastry crust (or crisp biscuit topping)","4 tbsp Cold unsalted butter (cubed)","3 cups Pure Madagascar vanilla bean paste","0.67 cup Brown sugar + 2 tbsp cornstarch","1 egg Egg wash or heavy cream glaze"],"recipeInstructions":[{"@type":"HowToStep","name":"Toss Filling & Line Baking Dish","text":"Toss 3 cups pure madagascar vanilla bean paste with 0.67 cup brown sugar + 2 tbsp cornstarch. Fit 1 batch all-butter pastry crust (or crisp biscuit topping) into your dish and dot with 4 tbsp cold unsalted butter (cubed). Line your baking pan with parchment paper or grease lightly, and make sure 1 batch all-butter pastry crust (or crisp biscuit topping) and 4 tbsp cold unsalted butter (cubed) are measured and at room temperature so they blend smoothly.","url":"https://crave.devyy.com/recipes/moon-pie/#step-1"},{"@type":"HowToStep","name":"Bake Until Jammy & Deep Golden","text":"Brush top with 1 egg egg wash or heavy cream glaze and bake at 375°F (190°C) for 35 minutes until golden brown and bubbling. Let Moon Pie cool for 10–15 minutes so the crumb sets cleanly before slicing into 8 portions, then garnish and serve.","url":"https://crave.devyy.com/recipes/moon-pie/#step-2"},{"@type":"HowToStep","name":"Bake Moon Pie & Check Doneness","text":"Bake for 35 minutes until the edges turn golden and set while the center remains tender. Test with a toothpick—if it comes out with a few moist crumbs rather than wet batter, it is ready.","url":"https://crave.devyy.com/recipes/moon-pie/#step-3"},{"@type":"HowToStep","name":"Cool Completely, Garnish & Serve","text":"Transfer Moon Pie to a wire cooling rack and let it cool for 15–20 minutes so the interior sets cleanly without crumbling. Lift out using the parchment overhang, garnish as desired, and slice into 8 portions.","url":"https://crave.devyy.com/recipes/moon-pie/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Pies, Tarts & Crumbles","item":"https://crave.devyy.com/category/pies-tarts/"},{"@type":"ListItem","position":3,"name":"Moon Pie","item":"https://crave.devyy.com/recipes/moon-pie/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Moon Pie?","acceptedAnswer":{"@type":"Answer","text":"Moon Pie takes 50 minutes total (15 minutes prep) and yields 8 servings at 340 calories per serving."}},{"@type":"Question","name":"Can I make Moon Pie healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Moon Pie recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
