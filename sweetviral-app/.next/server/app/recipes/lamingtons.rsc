10:T1342,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/lamingtons/","name":"Lamingtons","image":["https://crave.devyy.com/ai-images/lamingtons.jpg","https://crave.devyy.com/ai-images/lamingtons.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Australian-inspired lamingtons with 14 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (4 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"4 servings","recipeCategory":"Global Classics","recipeCuisine":"Australian","keywords":"Lamingtons, Australian, Global Classics, #Lamingtons, #CraveMadeMeDoIt, #ViralDesserts, #AustralianSweets","nutrition":{"@type":"NutritionInformation","calories":"411 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":166},"recipeIngredient":["8.3 tbsp Salted Butter","1.11 cup Golden Caster Sugar","3 pcs Egg","1.11 cup Self-raising Flour","3 tbsp Milk","0.5 tsp Salt","1.04 cup Double Cream","2 tbsp Icing Sugar","0.89 cup Raspberry Jam","1.56 cup Desiccated Coconut","5.3 tbsp Unsalted Butter","1.04 cup Milk","3.3 tbsp Cocoa Powder","1.78 cup Icing Sugar"],"recipeInstructions":[{"@type":"HowToStep","name":"Prep & Mix: Lamingtons","text":"Heat the oven to 200C/180C fan/gas 6. Butter and line a 20 x 30cm rectangle tin. Beat the butter and sugar in a free-standing mixer until pale and fluffy. Add the eggs one at a time and beat well. Beat through the flour, milk and salt until fully combined, then spoon into the tin. Bake in the oven for 25 mins or until golden and firm to the touch. Set aside to cool completely. Incorporate 8.3 tbsp salted butter, 1.11 cup golden caster sugar, 3 pcs egg, and 1.11 cup self-raising flour smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/lamingtons/#step-1"},{"@type":"HowToStep","name":"Build Flavor: Lamingtons","text":"Slice the sponge horizontally to create two halves. Trim the edges to make perfect corners. Cut the sponge into 18 squares. Lightly whip the cream with the icing sugar until it reaches soft peaks. Spread a little of the jam on half of the sponge squares then pipe or spread over a little of the cream. Sandwich each one with a second square of sponge then set aside in the fridge to chill. To make the icing, whisk together the melted butter and milk in a bowl. Sieve the cocoa powder and icing sugar together in a seperate bowl. Gradually add the cocoa and sugar to the butter and milk mixture, whisking continuously to ensure there are no lumps. If it gets lumpy, whizz with a hand blender until smooth. Incorporate 3 tbsp milk, 0.5 tsp salt, 1.04 cup double cream, 2 tbsp icing sugar, 0.89 cup raspberry jam, 1.56 cup desiccated coconut, 5.3 tbsp unsalted butter, 1.04 cup milk, 3.3 tbsp cocoa powder, and 1.78 cup icing sugar smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/lamingtons/#step-2"},{"@type":"HowToStep","name":"Shape & Layer: Lamingtons","text":"Divide the coconut between three shallow bowls (this keeps it from getting coated in too much chocolate whilst you’re dipping). Dip each lamington in the icing until completely covered. Roll in the coconut and set on a wire rack. Repeat with the remaining sponges. Chill for a minimum of 1 hr.","url":"https://crave.devyy.com/recipes/lamingtons/#step-3"},{"@type":"HowToStep","name":"Cool Completely, Garnish & Serve","text":"Transfer Lamingtons to a wire cooling rack and let it cool for 15–20 minutes so the interior sets cleanly without crumbling. Lift out using the parchment overhang, garnish as desired, and slice into 4 portions.","url":"https://crave.devyy.com/recipes/lamingtons/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"Lamingtons","item":"https://crave.devyy.com/recipes/lamingtons/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Lamingtons?","acceptedAnswer":{"@type":"Answer","text":"Lamingtons takes 45 minutes total (15 minutes prep) and yields 4 servings at 411 calories per serving."}},{"@type":"Question","name":"Can I make Lamingtons healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Lamingtons recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
