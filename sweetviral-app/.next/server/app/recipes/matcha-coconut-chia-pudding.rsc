10:T105a,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/matcha-coconut-chia-pudding/","name":"Overnight Matcha Coconut Chia Parfait","image":["https://crave.devyy.com/ai-images/matcha-coconut-chia-pudding.jpg","https://crave.devyy.com/ai-images/matcha-coconut-chia-pudding.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_healthy"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Antioxidant-rich ceremonial matcha & creamy coconut milk chia pudding layered with fresh berries. Ready in 5 mins (2 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT5M","cookTime":"PT0M","totalTime":"PT5M","recipeYield":"2 servings","recipeCategory":"Healthy & Zero-Sugar","recipeCuisine":"Healthy Viral","keywords":"Overnight Matcha Coconut Chia Parfait, Healthy Viral, Healthy & Zero-Sugar, #MatchaChia, #GuiltFreeCravings, #HealthyDesserts, #CraveMadeMeDoIt","nutrition":{"@type":"NutritionInformation","calories":"190 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":320},"recipeIngredient":["0.25 cup Organic black or white chia seeds","1 cup Light coconut or almond milk","1 tsp Ceremonial matcha + 1 tbsp pure maple syrup"],"recipeInstructions":[{"@type":"HowToStep","name":"Set Up Heavy Saucepan & Ingredients","text":"Place a heavy-bottomed saucepan over medium-low heat and have a heatproof silicone whisk ready. Measure out 0.25 cup organic black or white chia seeds and 1 cup light coconut or almond milk and 1 tsp ceremonial matcha + 1 tbsp pure maple syrup in advance—stovetop desserts move fast once they start bubbling.","url":"https://crave.devyy.com/recipes/matcha-coconut-chia-pudding/#step-1"},{"@type":"HowToStep","name":"Whisk Matcha Milk & Chia Seeds","text":"Whisk 1 cup light coconut or almond milk and 1 tsp ceremonial matcha + 1 tbsp pure maple syrup frothy, stir in 0.25 cup organic black or white chia seeds, wait 5 mins and stir again to prevent clumps, then chill 2+ hours. Plate into 2 generous servings while the flavors and textures are at their peak, and store any leftovers covered.","url":"https://crave.devyy.com/recipes/matcha-coconut-chia-pudding/#step-2"},{"@type":"HowToStep","name":"Combine Wet & Dry Smoothly","text":"Fold 1 tsp ceremonial matcha + 1 tbsp pure maple syrup into the base in two additions using gentle strokes until glossy and uniform with zero dry pockets. Avoid overmixing so the final texture stays light and tender.","url":"https://crave.devyy.com/recipes/matcha-coconut-chia-pudding/#step-3"},{"@type":"HowToStep","name":"Remove from Heat, Cool & Serve","text":"Pull the pan off the heat as soon as Overnight Matcha Coconut Chia Parfait coats the spoon thickly. Let cool slightly so the glaze or custard thickens even more, then spoon into 2 bowls and garnish before serving.","url":"https://crave.devyy.com/recipes/matcha-coconut-chia-pudding/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Healthy & Zero-Sugar","item":"https://crave.devyy.com/category/healthy-light/"},{"@type":"ListItem","position":3,"name":"Overnight Matcha Coconut Chia Parfait","item":"https://crave.devyy.com/recipes/matcha-coconut-chia-pudding/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Overnight Matcha Coconut Chia Parfait?","acceptedAnswer":{"@type":"Answer","text":"Overnight Matcha Coconut Chia Parfait takes 5 minutes total (5 minutes prep) and yields 2 servings at 190 calories per serving."}},{"@type":"Question","name":"Can I make Overnight Matcha Coconut Chia Parfait healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Overnight Matcha Coconut Chia Parfait recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
