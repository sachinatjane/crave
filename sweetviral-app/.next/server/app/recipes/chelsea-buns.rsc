10:T12d0,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/chelsea-buns/","name":"Chelsea Buns","image":["https://crave.devyy.com/ai-images/chelsea-buns.jpg","https://crave.devyy.com/ai-images/chelsea-buns.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"British-inspired chelsea buns with 13 measured ingredients — zero sign-up, instant Cook Mode. Ready in 33 mins (4 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT18M","totalTime":"PT33M","recipeYield":"4 servings","recipeCategory":"Pastries & Donuts","recipeCuisine":"British","keywords":"Chelsea Buns, British, Pastries & Donuts, #ChelseaBuns, #CraveMadeMeDoIt, #ViralDesserts, #BritishSweets","nutrition":{"@type":"NutritionInformation","calories":"215 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":136},"recipeIngredient":["2.22 cup White Flour","1 tsp Salt","1.4 tsp Yeast","1.25 cup Milk","1.4 oz Butter","1 whole Eggs","1 pinch Vegetable Oil","0.9 oz Butter","5 tbsp Brown Sugar","2 tsp Cinnamon","10 tbsp Dried Fruit","2 tbs Milk","2 tbs Caster Sugar"],"recipeInstructions":[{"@type":"HowToStep","name":"Prep & Mix: Chelsea Buns","text":"Sift the flour and salt into a large bowl. Make a well in the middle and add the yeast. Meanwhile, warm the milk and butter in a saucepan until the butter melts and the mixture is lukewarm. Add the milk mixture and egg to the flour mixture and stir until the contents of the bowl come together as a soft dough. (You may need to add a little extra flour.). Incorporate 2.22 cup white flour, 1 tsp salt, 1.4 tsp yeast, and 1.25 cup milk smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/chelsea-buns/#step-1"},{"@type":"HowToStep","name":"Build Flavor: Chelsea Buns","text":"Tip the dough onto a generously floured work surface. Knead for five minutes, adding more flour if necessary, until the dough is smooth and elastic and no longer feels sticky. Lightly oil a bowl with a little of the vegetable oil. Place the dough into the bowl and turn until it is covered in the oil. Cover the bowl with cling film and set aside in a warm place for one hour, or until the dough has doubled in size. Lightly grease a baking tray. Incorporate 1.4 oz butter, 1 whole eggs, 1 pinch vegetable oil, 0.9 oz butter, 5 tbsp brown sugar, 2 tsp cinnamon, 10 tbsp dried fruit, 2 tbs milk, and 2 tbs caster sugar smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/chelsea-buns/#step-2"},{"@type":"HowToStep","name":"Shape & Layer: Chelsea Buns","text":"For the filling, knock the dough back to its original size and turn out onto a lightly floured work surface. Roll the dough out into a rectangle 0.5cm/¼in thick. Brush all over with the melted butter, then sprinkle over the brown sugar, cinnamon and dried fruit. Roll the dough up into a tight cylinder , cut ten 4cm/1½in slice and place them onto a lightly greased baking sheet, leaving a little space between each slice. Cover with a tea towel and set aside to rise for 30 minutes. Preheat oven to 190C/375F/Gas 5.","url":"https://crave.devyy.com/recipes/chelsea-buns/#step-3"},{"@type":"HowToStep","name":"Bake / Chill: Chelsea Buns","text":"Bake the buns in the oven for 20-25 minutes, or until risen and golden-brown. Meanwhile, for the glaze, heat the milk and sugar in a saucepan until boiling. Reduce the heat and simmer for 2-3 minutes. Remove the buns from the oven and brush with the glaze, then set aside to cool on a wire rack.","url":"https://crave.devyy.com/recipes/chelsea-buns/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Pastries & Donuts","item":"https://crave.devyy.com/category/pastries-donuts/"},{"@type":"ListItem","position":3,"name":"Chelsea Buns","item":"https://crave.devyy.com/recipes/chelsea-buns/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Chelsea Buns?","acceptedAnswer":{"@type":"Answer","text":"Chelsea Buns takes 33 minutes total (15 minutes prep) and yields 4 servings at 215 calories per serving."}},{"@type":"Question","name":"Can I make Chelsea Buns healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Chelsea Buns recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
