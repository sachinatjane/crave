10:T1077,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/spotted-dick/","name":"Spotted Dick","image":["https://crave.devyy.com/ai-images/spotted-dick.jpg","https://crave.devyy.com/ai-images/spotted-dick.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"British-inspired spotted dick with 9 measured ingredients — zero sign-up, instant Cook Mode. Ready in 15 mins (4 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT0M","totalTime":"PT15M","recipeYield":"4 servings","recipeCategory":"Global Classics","recipeCuisine":"British","keywords":"Spotted Dick, British, Global Classics, #SpottedDick, #CraveMadeMeDoIt, #ViralDesserts, #BritishSweets","nutrition":{"@type":"NutritionInformation","calories":"230 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":90},"recipeIngredient":["1.11 cup Self-raising Flour","1 pinch Salt","8.3 tbsp Suet","11.7 tbsp Currants","5.3 tbsp Caster Sugar","1 zest of 1 Lemon","1 zest of 1 Orange","0.62 cup Milk","1 to serve Custard"],"recipeInstructions":[{"@type":"HowToStep","name":"Prep & Mix: Spotted Dick","text":"Put the flour and salt in a bowl. Add the suet, currants, sugar, lemon and orange zest. Sifting aerates the dry ingredients and removes any stubborn cocoa or flour lumps so the finished crumb bakes up light and even. Incorporate 1.11 cup self-raising flour, 1 pinch salt, 8.3 tbsp suet, and 11.7 tbsp currants smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/spotted-dick/#step-1"},{"@type":"HowToStep","name":"Build Flavor: Spotted Dick","text":"Pour in 150ml milk and mix to a firm but moist dough, adding the extra milk if necessary. Whisk steadily around the bottom and corners of the pan until glossy, thickened, and smooth enough to coat the back of a spoon. Incorporate 5.3 tbsp caster sugar, 1 zest of 1 lemon, 1 zest of 1 orange, 0.62 cup milk, and 1 to serve custard smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/spotted-dick/#step-2"},{"@type":"HowToStep","name":"Shape & Layer: Spotted Dick","text":"Shape into a fat roll about 20cm long. Place on a large rectangle of baking parchment. Wrap loosely to allow for the pudding to rise and tie the ends with string like a Christmas cracker.","url":"https://crave.devyy.com/recipes/spotted-dick/#step-3"},{"@type":"HowToStep","name":"Bake / Chill: Spotted Dick","text":"Place a steamer over a large pan of boiling water, add the pudding to the steamer, cover and steam for 1 1/2 hours. Top up the pan with water from time to time.","url":"https://crave.devyy.com/recipes/spotted-dick/#step-4"},{"@type":"HowToStep","name":"Viral Finish: Spotted Dick","text":"Remove from the steamer and allow to cool slightly before unwrapping. Serve sliced with custard. Plate into 4 generous servings while the flavors and textures are at their peak, and store any leftovers covered.","url":"https://crave.devyy.com/recipes/spotted-dick/#step-5"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"Spotted Dick","item":"https://crave.devyy.com/recipes/spotted-dick/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Spotted Dick?","acceptedAnswer":{"@type":"Answer","text":"Spotted Dick takes 15 minutes total (15 minutes prep) and yields 4 servings at 230 calories per serving."}},{"@type":"Question","name":"Can I make Spotted Dick healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Spotted Dick recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
