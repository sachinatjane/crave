10:Te46,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/leche-asada/","name":"Leche Asada","image":["https://crave.devyy.com/ai-images/leche-asada.jpg","https://crave.devyy.com/ai-images/leche-asada.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Global-inspired leche asada with 5 measured ingredients — zero sign-up, instant Cook Mode. Ready in 38 mins (4 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT8M","cookTime":"PT30M","totalTime":"PT38M","recipeYield":"4 servings","recipeCategory":"Global Classics","recipeCuisine":"Global","keywords":"Leche Asada, Global, Global Classics, #LecheAsada, #CraveMadeMeDoIt, #ViralDesserts, #GlobalSweets","nutrition":{"@type":"NutritionInformation","calories":"274 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":147},"recipeIngredient":["1 quart Milk","1 zest of 1 Lemon","2 whole Cinnamon Stick","4 whole Eggs","0.5 cup Sugar"],"recipeInstructions":[{"@type":"HowToStep","name":"Prep & Mix: Leche Asada","text":"Preheat oven to 350 degrees F (175 degrees C). Keep 1 quart milk, 1 zest of 1 lemon, 2 whole cinnamon stick, and 4 whole eggs prepped and measured within reach so each step comes together smoothly and evenly.","url":"https://crave.devyy.com/recipes/leche-asada/#step-1"},{"@type":"HowToStep","name":"Build Flavor: Leche Asada","text":"Pour the milk into a saucepan along with the lemon zest and cinnamon sticks. Bring to a simmer over medium-high heat, then reduce heat to low, and cook for 5 minutes. Turn heat off, and allow to steep for 15 minutes. Incorporate 0.5 cup sugar smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/leche-asada/#step-2"},{"@type":"HowToStep","name":"Shape & Layer: Leche Asada","text":"Gently beat the eggs and sugar together until the sugar has dissolved. Slowly beat in 1 cup of the hot milk, a little at a time, until it has been incorporated. Stir the egg mixture back into the hot milk, pour in the pisco, and mix until well combined.","url":"https://crave.devyy.com/recipes/leche-asada/#step-3"},{"@type":"HowToStep","name":"Bake / Chill: Leche Asada","text":"Pour the custard through a fine mesh sieve into a 2-quart ceramic casserole dish to remove the lemon zest and cinnamon. Bake in preheated oven until set, and browned on top, about 30 minutes. Chill before serving.","url":"https://crave.devyy.com/recipes/leche-asada/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"Leche Asada","item":"https://crave.devyy.com/recipes/leche-asada/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Leche Asada?","acceptedAnswer":{"@type":"Answer","text":"Leche Asada takes 38 minutes total (8 minutes prep) and yields 4 servings at 274 calories per serving."}},{"@type":"Question","name":"Can I make Leche Asada healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Leche Asada recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
