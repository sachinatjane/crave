10:Tfaf,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/knafeh/","name":"Knafeh","image":["https://crave.devyy.com/ai-images/knafeh.jpg","https://crave.devyy.com/ai-images/knafeh.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Saudi Arabian-inspired knafeh with 12 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (4 servings). 4.8★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"4 servings","recipeCategory":"Global Classics","recipeCuisine":"Saudi Arabian","keywords":"Knafeh, Saudi Arabian, Global Classics, #Knafeh, #CraveMadeMeDoIt, #ViralDesserts, #SaudiSweets","nutrition":{"@type":"NutritionInformation","calories":"431 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":77},"recipeIngredient":["1.78 cup Knafeh","6 tbsp Unsalted Butter","1 pinch Yellow Food Colouring","1 cup Mozzarella","0.25 cup Cream Cheese","1.5 cups Milk","4 tbsp Sugar","2 tbsp Corn Flour","1 cup Sugar","1 cup Water","1 tsp Rose water","0.5 tsp Lemon Juice"],"recipeInstructions":[{"@type":"HowToStep","name":"Prep & Mix: Knafeh","text":"Take kanfhe in a bowl and roughly cut them. Pour melted butter, yellow food color and mix well with your hands. In a separate bowl mix milk, cream cheese, sugar, cornstarch well. Turn on the flame and boil the liquid, when it gets thick turn off the flame let it cool down a little bit. Incorporate 1.78 cup knafeh, 6 tbsp unsalted butter, 1 pinch yellow food colouring, and 1 cup mozzarella smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/knafeh/#step-1"},{"@type":"HowToStep","name":"Build Flavor: Knafeh","text":"Add mozzarella in it and mix it well. Now make a base with half of the kanfhe in a dish, gently press it to level the dough well. Pour the cheese mixture on the top and level it with a spoon. Incorporate 0.25 cup cream cheese, 1.5 cups milk, 4 tbsp sugar, 2 tbsp corn flour, 1 cup sugar, 1 cup water, 1 tsp rose water, and 0.5 tsp lemon juice smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/knafeh/#step-2"},{"@type":"HowToStep","name":"Shape & Layer: Knafeh","text":"Cover it with the other half of the kanfhe. Put the dish in a preheated oven at 200 degree for about 20-25 minutes. It's ready when kunafa is golden and crunchy in the surface.","url":"https://crave.devyy.com/recipes/knafeh/#step-3"},{"@type":"HowToStep","name":"Bake / Chill: Knafeh","text":"Boil water in a pan and dissolve sugar in it for 4–5 minutes. OR cook it until slightly thicken and keep on stirring. Add lemon juice with rose water, mix well. Evenly pour the syrup over the kunafa as soon as it comes out of the oven. Your kunafa is ready to serve.","url":"https://crave.devyy.com/recipes/knafeh/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"Knafeh","item":"https://crave.devyy.com/recipes/knafeh/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Knafeh?","acceptedAnswer":{"@type":"Answer","text":"Knafeh takes 45 minutes total (15 minutes prep) and yields 4 servings at 431 calories per serving."}},{"@type":"Question","name":"Can I make Knafeh healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Knafeh recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
