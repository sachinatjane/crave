10:T123b,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/jamaican-spice-bun-recipe/","name":"Jamaican Spice Bun Recipe","image":["https://crave.devyy.com/ai-images/jamaican-spice-bun-recipe.jpg","https://crave.devyy.com/ai-images/jamaican-spice-bun-recipe.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Jamaican-inspired jamaican spice bun recipe with 16 measured ingredients — zero sign-up, instant Cook Mode. Ready in 33 mins (4 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT18M","totalTime":"PT33M","recipeYield":"4 servings","recipeCategory":"Pastries & Donuts","recipeCuisine":"Jamaican","keywords":"Jamaican Spice Bun Recipe, Jamaican, Pastries & Donuts, #JamaicanSpice, #CraveMadeMeDoIt, #ViralDesserts, #JamaicanSweets","nutrition":{"@type":"NutritionInformation","calories":"238 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":128},"recipeIngredient":["1.69 cup All purpose flour","2 tsp Baking Powder","2 tsp Ground Cinnamon","0.5 tsp Salt","1 pc Egg","10 tbsp Brown Sugar","1.11 cup Beer","0.3333333333333333 cup Milk","0.25 cup Honey","4 tbsp Unsalted Butter","1 tbsp Molasses","1 tsp Caramelized Sugar Sauce","1 tsp Vanilla Extract","0.5 cup Dried cranberries","0.5 cup Raisins","0.5 cup Dried Cherries"],"recipeInstructions":[{"@type":"HowToStep","name":"Preheat & Prep Your Pan","text":"Soak the craisins, raisins, and cherries in the 1 cup of beer. Set aside and allow to soak for 30 minutes. Preheat the oven to 325 degrees Fahrenheit. Grease an 8x4 loaf pan. Set aside. Incorporate 1.69 cup all purpose flour, 2 tsp baking powder, 2 tsp ground cinnamon, and 0.5 tsp salt smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/jamaican-spice-bun-recipe/#step-1"},{"@type":"HowToStep","name":"Fold In Flavorings & Mix-Ins","text":"Combine all-purpose flour, baking powder, ground cinnamon, salt, in a large bowl and set aside. In another bowl, combine brown sugar, egg, milk, honey, melted butter, molasses, browning, vanilla extract, and the beer that’s soaking the fruit. Do not pour the fruit in at this time, just the beer. Mix to combine. Incorporate 1 pc egg, 10 tbsp brown sugar, 1.11 cup beer, 0.3333333333333333 cup milk, 0.25 cup honey, 4 tbsp unsalted butter, 1 tbsp molasses, 1 tsp caramelized sugar sauce, 1 tsp vanilla extract, 0.5 cup dried cranberries, 0.5 cup raisins, and 0.5 cup dried cherries smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/jamaican-spice-bun-recipe/#step-2"},{"@type":"HowToStep","name":"Sift & Whisk Dry Ingredients","text":"Remove 2 tablespoon of flour from the flour mixture and toss the fruit in it. Set aside. Make a well in the middle of the bowl of dry ingredients and pour in wet mixture, stirring until fully combined. And the fruits to the mixture and stir until incpororated.","url":"https://crave.devyy.com/recipes/jamaican-spice-bun-recipe/#step-3"},{"@type":"HowToStep","name":"Drain Crisp, Garnish & Serve Warm","text":"Pour mixture into prepared loaf pan and bake in the preheated oven for 50-60 minutes or until a toothpick comes out clean. Cool for 5 minutes in the pan and then move to a cooling rack to finish cooling. Serve with slices of cheddar cheese.","url":"https://crave.devyy.com/recipes/jamaican-spice-bun-recipe/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Pastries & Donuts","item":"https://crave.devyy.com/category/pastries-donuts/"},{"@type":"ListItem","position":3,"name":"Jamaican Spice Bun Recipe","item":"https://crave.devyy.com/recipes/jamaican-spice-bun-recipe/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Jamaican Spice Bun Recipe?","acceptedAnswer":{"@type":"Answer","text":"Jamaican Spice Bun Recipe takes 33 minutes total (15 minutes prep) and yields 4 servings at 238 calories per serving."}},{"@type":"Question","name":"Can I make Jamaican Spice Bun Recipe healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Jamaican Spice Bun Recipe recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
