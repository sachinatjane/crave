10:T10c2,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/matcha-almond-protein-bliss-bites/","name":"No-Bake Matcha Pistachio Bliss Balls","image":["https://crave.devyy.com/ai-images/matcha-almond-protein-bliss-bites.jpg","https://crave.devyy.com/ai-images/matcha-almond-protein-bliss-bites.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_healthy"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Clean-energy matcha pistachio bliss truffles sweetened with Medjool dates—ready in 8 mins. Ready in 8 mins (10 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT8M","cookTime":"PT0M","totalTime":"PT8M","recipeYield":"10 servings","recipeCategory":"Healthy & Zero-Sugar","recipeCuisine":"Healthy Viral","keywords":"No-Bake Matcha Pistachio Bliss Balls, Healthy Viral, Healthy & Zero-Sugar, #MatchaBites, #GuiltFreeCravings, #HealthyDesserts, #CraveMadeMeDoIt","nutrition":{"@type":"NutritionInformation","calories":"130 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":240},"recipeIngredient":["1 cup Almond flour + crushed pistachios","0.5 cup Pitted soft dates + 2 tbsp coconut cream","2 tsp Ceremonial matcha green tea powder"],"recipeInstructions":[{"@type":"HowToStep","name":"Preheat Oven & Prep Your Pan","text":"Preheat your oven to 350°F (175°C) and line your baking pan with parchment paper, leaving a slight overhang for effortless lifting. Measure out 1 cup almond flour + crushed pistachios and 0.5 cup pitted soft dates + 2 tbsp coconut cream so everything is ready and at room temperature for a silky, lump-free batter.","url":"https://crave.devyy.com/recipes/matcha-almond-protein-bliss-bites/#step-1"},{"@type":"HowToStep","name":"Pulse Together & Roll Emerald Truffles","text":"Pulse 1 cup almond flour + crushed pistachios, 0.5 cup pitted soft dates + 2 tbsp coconut cream, and 2 tsp ceremonial matcha green tea powder until sticky dough forms, roll into 10 emerald truffles, and chill. Let No-Bake Matcha Pistachio Bliss Balls cool for 10–15 minutes so the crumb sets cleanly before slicing into 10 portions, then garnish and serve.","url":"https://crave.devyy.com/recipes/matcha-almond-protein-bliss-bites/#step-2"},{"@type":"HowToStep","name":"Bake No-Bake Matcha Pistachio Bliss Balls & Check Doneness","text":"Bake for 4 minutes until the edges turn golden and set while the center remains tender. Test with a toothpick—if it comes out with a few moist crumbs rather than wet batter, it is ready.","url":"https://crave.devyy.com/recipes/matcha-almond-protein-bliss-bites/#step-3"},{"@type":"HowToStep","name":"Cool Completely, Garnish & Serve","text":"Transfer No-Bake Matcha Pistachio Bliss Balls to a wire cooling rack and let it cool for 15–20 minutes so the interior sets cleanly without crumbling. Lift out using the parchment overhang, garnish as desired, and slice into 10 portions.","url":"https://crave.devyy.com/recipes/matcha-almond-protein-bliss-bites/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Healthy & Zero-Sugar","item":"https://crave.devyy.com/category/healthy-light/"},{"@type":"ListItem","position":3,"name":"No-Bake Matcha Pistachio Bliss Balls","item":"https://crave.devyy.com/recipes/matcha-almond-protein-bliss-bites/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make No-Bake Matcha Pistachio Bliss Balls?","acceptedAnswer":{"@type":"Answer","text":"No-Bake Matcha Pistachio Bliss Balls takes 8 minutes total (8 minutes prep) and yields 10 servings at 130 calories per serving."}},{"@type":"Question","name":"Can I make No-Bake Matcha Pistachio Bliss Balls healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this No-Bake Matcha Pistachio Bliss Balls recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
