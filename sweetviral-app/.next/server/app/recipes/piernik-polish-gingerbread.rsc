11:["$","noscript",null,{"children":["$","article",null,{"children":[["$","h1",null,{"children":"Piernik (Polish gingerbread)"}],["$","p",null,{"children":"Polish-inspired piernik (polish gingerbread) with 14 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (6 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode."}],["$","h2",null,{"children":"Ingredients"}],["$","ul",null,{"children":[["$","li","0",{"children":"9.3 tbsp Unsalted Butter"}],["$","li","1",{"children":"1.33 cup Clear Honey"}],["$","li","2",{"children":"6.7 tbsp Brown Sugar"}],["$","li","3",{"children":"1.67 cup Self-raising Flour"}],["$","li","4",{"children":"3 tsp Ground Ginger"}],["$","li","5",{"children":"1 tsp Ground Cinnamon"}],["$","li","6",{"children":"0.5 tsp Ground Clove"}],["$","li","7",{"children":"0.25 tsp Ground Nutmeg"}],["$","li","8",{"children":"0.25 tsp Pepper"}],["$","li","9",{"children":"3 pcs Egg"}],["$","li","10",{"children":"0.89 cup Plum Jam"}],["$","li","11",{"children":"0.94 cup Double Cream"}],["$","li","12",{"children":"9.3 tbsp Dark Chocolate"}],["$","li","13",{"children":"3 tbsp Clear Honey"}]]}],["$","h2",null,{"children":"Step-by-Step Instructions"}],["$","ol",null,{"children":[["$","li","1",{"children":[["$","h3",null,{"children":"Preheat & Prep Your Pan"}],["$","p",null,{"children":"Heat oven to 160C/140C fan/gas 3. Grease and line the base and sides of a deep 20cm cake tin with baking parchment. Put the honey, sugar and butter in a medium saucepan and cook over a medium heat until fully melted. Remove from the heat and allow to cool. Put the flour and spices in a large bowl and mix everything together. Incorporate 9.3 tbsp unsalted butter, 1.33 cup clear honey, 6.7 tbsp brown sugar, and 1.67 cup self-raising flour smoothly until evenly distributed."}]]}],["$","li","2",{"children":[["$","h3",null,{"children":"Sift & Whisk Dry Ingredients"}],["$","p",null,{"children":"Once the liquid ingredients have cooled, whisk in the eggs. Pour over the dry ingredients, whisking them together to form a smooth batter – be careful not to overmix as this can lead to a dry cake. Pour into the prepared tin and bake for 50-55 mins or until risen and a skewer inserted into the middle of the cake comes out clean. Allow the cake to cool in the pan for 20 mins before turning out onto a wire rack to cool completely. Incorporate 3 tsp ground ginger, 1 tsp ground cinnamon, 0.5 tsp ground clove, 0.25 tsp ground nutmeg, 0.25 tsp pepper, 3 pcs egg, 0.89 cup plum jam, 0.94 cup double cream, 9.3 tbsp dark chocolate, and 3 tbsp clear honey smoothly until evenly distributed."}]]}],["$","li","3",{"children":[["$","h3",null,{"children":"Bake Piernik (Polish gingerbread) & Check Doneness"}],["$","p",null,{"children":"Bake for 30 minutes until the edges turn golden and set while the center remains tender. Test with a toothpick—if it comes out with a few moist crumbs rather than wet batter, it is ready."}]]}],["$","li","4",{"children":[["$","h3",null,{"children":"Cream Butter & Sugar Fluffy"}],["$","p",null,{"children":"Once cooled, use a large serrated knife to slice the cake into 3 layers. Spread the jam across the 2 bottom cake layers, then reassemble the cake and set aside while you make the glaze. Put the cream, chocolate and honey in a medium pan and cook over a low-medium heat until the chocolate is melted and you have a smooth, pourable mixture. Put the cake on a wire rack set over a parchment-lined baking tray and pour over the glaze, making sure to cover the entire cake. Use a fish slice to carefully transfer the cake to a serving plate and allow the glaze to set. To decorate, dust with a little edible gold powder, if you like. Uniced, this cake will keep for up to 5 days. Once iced, enjoy within 3 days – just keep in the fridge, but remove before serving and eat at room temperature."}]]}]]}],"$L13"]}]}]
