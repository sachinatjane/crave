10:T10fa,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/baghlaw-e-khanagi/","name":"Baghlaw-e-Khanagi","image":["https://crave.devyy.com/ai-images/baghlaw-e-khanagi.jpg","https://crave.devyy.com/ai-images/baghlaw-e-khanagi.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Global-inspired baghlaw-e-khanagi with 9 measured ingredients — zero sign-up, instant Cook Mode. Ready in 15 mins (4 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT0M","totalTime":"PT15M","recipeYield":"4 servings","recipeCategory":"Global Classics","recipeCuisine":"Global","keywords":"Baghlaw-e-Khanagi, Global, Global Classics, #BaghlaweKhan, #CraveMadeMeDoIt, #ViralDesserts, #GlobalSweets","nutrition":{"@type":"NutritionInformation","calories":"227 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":161},"recipeIngredient":["2.67 cup Flour","3 whole Eggs","1.88 cup Milk","5 tbsp Vegetable Oil","1 tsp Baking Powder","3.3 tbsp Ground Walnuts","2 tsp Cardamom","1.33 cup Sugar","4.17 cup Water"],"recipeInstructions":[{"@type":"HowToStep","name":"Shape & Press Dough Evenly","text":"Place flour in a bowl, and create a hole in the middle of the flour. Whisk eggs, and then pour whisked eggs into the well. Add milk, and combine. Then, stir in the ground walnuts, baking powder and cardamom, and add to the mixture. Fold ingredients into the mixture until it forms an elastic dough consistency. Incorporate 2.67 cup flour, 3 whole eggs, 1.88 cup milk, and 5 tbsp vegetable oil smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/baghlaw-e-khanagi/#step-1"},{"@type":"HowToStep","name":"Simmer & Dissolve Smoothly","text":"Take dough and with a rolling pin, roll out into a thin rectangle on a clean surface. Then, from the longest side of the rectangle, fold the dough into 3cm-wide lines, until the dough is fully rolled in a long line. Cut folded dough horizontally into 3cm pieces Heat a deep pan of the vegetable oil, and wait till it reaches frying temperature. Whilst you are waiting. Fill a deep pan with 1 litre of water, and bring to the boil.  Then, pour in the sugar, and stir gently until it becomes thick and syrup-like. Turn down the heat and leave to simmer. Incorporate 1 tsp baking powder, 3.3 tbsp ground walnuts, 2 tsp cardamom, 1.33 cup sugar, and 4.17 cup water smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/baghlaw-e-khanagi/#step-2"},{"@type":"HowToStep","name":"Fry Until Golden & Crisp","text":"Carefully lower each piece of dough into the frying oil. Fry until golden brown. When golden brown, take the Baghlaw pieces out of the oil, and place them into the sugar syrup to coat.","url":"https://crave.devyy.com/recipes/baghlaw-e-khanagi/#step-3"},{"@type":"HowToStep","name":"Cool, Garnish & Serve","text":"Remove from the syrup and whilst still warm, sprinkle with ground walnuts, so they stick to the Baghlaw. Leave to cool. Then, enjoy with your friends and family!","url":"https://crave.devyy.com/recipes/baghlaw-e-khanagi/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"Baghlaw-e-Khanagi","item":"https://crave.devyy.com/recipes/baghlaw-e-khanagi/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Baghlaw-e-Khanagi?","acceptedAnswer":{"@type":"Answer","text":"Baghlaw-e-Khanagi takes 15 minutes total (15 minutes prep) and yields 4 servings at 227 calories per serving."}},{"@type":"Question","name":"Can I make Baghlaw-e-Khanagi healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Baghlaw-e-Khanagi recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
