10:T1159,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/chocolate-raspberry-brownies/","name":"Chocolate Raspberry Brownies","image":["https://crave.devyy.com/ai-images/chocolate-raspberry-brownies.jpg","https://crave.devyy.com/ai-images/chocolate-raspberry-brownies.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"United States-inspired chocolate raspberry brownies with 8 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (4 servings). 4.8★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"4 servings","recipeCategory":"Chocolate & Brownies","recipeCuisine":"United States","keywords":"Chocolate Raspberry Brownies, United States, Chocolate & Brownies, #ChocolateRasp, #CraveMadeMeDoIt, #ViralDesserts, #UnitedSweets","nutrition":{"@type":"NutritionInformation","calories":"231 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":139},"recipeIngredient":["0.89 cup Dark Chocolate","6.7 tbsp Milk Chocolate","1.11 cup Salted Butter","1.78 cup Light Brown Soft Sugar","4 pcs Eggs","9.3 tbsp Plain Flour","3.3 tbsp Cocoa","0.89 cup Raspberries"],"recipeInstructions":[{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Heat oven to 180C/160C fan/gas 4. Line a 20 x 30cm baking tray tin with baking parchment. Put the chocolate, butter and sugar in a pan and gently melt, stirring occasionally with a wooden spoon. Remove from the heat. Incorporate 0.89 cup dark chocolate, 6.7 tbsp milk chocolate, 1.11 cup salted butter, and 1.78 cup light brown soft sugar smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/chocolate-raspberry-brownies/#step-1"},{"@type":"HowToStep","name":"Bake Chocolate Raspberry Brownies & Check Doneness","text":"Bake for 30 minutes until the edges turn golden and set while the center remains tender. Test with a toothpick—if it comes out with a few moist crumbs rather than wet batter, it is ready. Incorporate 4 pcs eggs, 9.3 tbsp plain flour, 3.3 tbsp cocoa, and 0.89 cup raspberries smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/chocolate-raspberry-brownies/#step-2"},{"@type":"HowToStep","name":"Bake Until Golden & Set","text":"Stir the eggs, one by one, into the melted chocolate mixture. Sieve over the flour and cocoa, and stir in. Stir in half the raspberries, scrape into the tray, then scatter over the remaining raspberries. Bake on the middle shelf for 30 mins or, if you prefer a firmer texture, for 5 mins more. Cool before slicing into squares. Store in an airtight container for up to 3 days.","url":"https://crave.devyy.com/recipes/chocolate-raspberry-brownies/#step-3"},{"@type":"HowToStep","name":"Cool Completely, Garnish & Serve","text":"Transfer Chocolate Raspberry Brownies to a wire cooling rack and let it cool for 15–20 minutes so the interior sets cleanly without crumbling. Lift out using the parchment overhang, garnish as desired, and slice into 4 portions.","url":"https://crave.devyy.com/recipes/chocolate-raspberry-brownies/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Chocolate & Brownies","item":"https://crave.devyy.com/category/chocolate-brownies/"},{"@type":"ListItem","position":3,"name":"Chocolate Raspberry Brownies","item":"https://crave.devyy.com/recipes/chocolate-raspberry-brownies/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Chocolate Raspberry Brownies?","acceptedAnswer":{"@type":"Answer","text":"Chocolate Raspberry Brownies takes 45 minutes total (15 minutes prep) and yields 4 servings at 231 calories per serving."}},{"@type":"Question","name":"Can I make Chocolate Raspberry Brownies healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Chocolate Raspberry Brownies recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
