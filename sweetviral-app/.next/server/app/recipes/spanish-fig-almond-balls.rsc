10:T104a,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/spanish-fig-almond-balls/","name":"Spanish fig & almond balls","image":["https://crave.devyy.com/ai-images/spanish-fig-almond-balls.jpg","https://crave.devyy.com/ai-images/spanish-fig-almond-balls.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Spanish-inspired spanish fig & almond balls with 8 measured ingredients — zero sign-up, instant Cook Mode. Ready in 15 mins (4 servings). 4.7★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT0M","totalTime":"PT15M","recipeYield":"4 servings","recipeCategory":"Global Classics","recipeCuisine":"Spanish","keywords":"Spanish fig & almond balls, Spanish, Global Classics, #Spanishfig, #CraveMadeMeDoIt, #ViralDesserts, #SpanishSweets","nutrition":{"@type":"NutritionInformation","calories":"418 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.7,"reviewCount":62},"recipeIngredient":["6.7 tbsp Almonds","2.22 cup Figs","5.7 tbsp Dried Apricots","3.3 tbsp Dried cranberries","1 tbsp Brandy","1 tbsp Clear Honey","1 tsp Cloves","6.7 tbsp Sesame Seed"],"recipeInstructions":[{"@type":"HowToStep","name":"Whisk & Combine Base Ingredients","text":"Whizz the almonds in a food processor until most are finely chopped, then tip into a large bowl. Roughly chop the figs, then whizz to a smooth sticky paste. Scrape onto the almonds then, using your hands, mix together well with the dried fruit, brandy, honey and cloves. Incorporate 6.7 tbsp almonds, 2.22 cup figs, 5.7 tbsp dried apricots, and 3.3 tbsp dried cranberries smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/spanish-fig-almond-balls/#step-1"},{"@type":"HowToStep","name":"Transfer, Smooth Top & Add Garnish","text":"Pour or press the mixture evenly into your prepared dish, smoothing the surface with a spatula. Scatter 1 tbsp brandy, 1 tbsp clear honey, 1 tsp cloves, and 6.7 tbsp sesame seed evenly across the top and press gently so it adheres cleanly.","url":"https://crave.devyy.com/recipes/spanish-fig-almond-balls/#step-2"},{"@type":"HowToStep","name":"Shape & Press Dough Evenly","text":"Divide the mixture into 6 and roll into balls. Tip the sesame seeds onto a tray, then roll the balls in them until covered. Cover the tray loosely with a clean tea towel, then leave the fig balls to dry for a week before packaging. Will keep in a cool place for 2 months.","url":"https://crave.devyy.com/recipes/spanish-fig-almond-balls/#step-3"},{"@type":"HowToStep","name":"Chill Until Firm, Slice & Store","text":"Cover and refrigerate Spanish fig & almond balls until completely firm and sliceable. Portion into 4 servings, add any crisp toppings right before serving, and keep leftovers chilled in an airtight container for up to 5 days.","url":"https://crave.devyy.com/recipes/spanish-fig-almond-balls/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"Spanish fig & almond balls","item":"https://crave.devyy.com/recipes/spanish-fig-almond-balls/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Spanish fig & almond balls?","acceptedAnswer":{"@type":"Answer","text":"Spanish fig & almond balls takes 15 minutes total (15 minutes prep) and yields 4 servings at 418 calories per serving."}},{"@type":"Question","name":"Can I make Spanish fig & almond balls healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Spanish fig & almond balls recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
