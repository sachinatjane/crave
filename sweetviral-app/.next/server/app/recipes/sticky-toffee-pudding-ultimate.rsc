10:T17db,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/sticky-toffee-pudding-ultimate/","name":"Sticky Toffee Pudding Ultimate","image":["https://crave.devyy.com/ai-images/sticky-toffee-pudding-ultimate.jpg","https://crave.devyy.com/ai-images/sticky-toffee-pudding-ultimate.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"British-inspired sticky toffee pudding ultimate with 15 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (4 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"4 servings","recipeCategory":"Puddings & Custards","recipeCuisine":"British","keywords":"Sticky Toffee Pudding Ultimate, British, Puddings & Custards, #StickyToffee, #CraveMadeMeDoIt, #ViralDesserts, #BritishSweets","nutrition":{"@type":"NutritionInformation","calories":"331 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":135},"recipeIngredient":["1 cup Medjool dates","0.73 cup water","1 tsp vanilla extract","11.7 tbsp self-raising flour","1 tsp bicarbonate of soda","2 whole eggs","5.7 tbsp butter","9.3 tbsp demerara sugar","2 tbsp black treacle","6.7 tbsp milk","1 scoop ice cream","11.7 tbsp muscovado sugar","3.3 tbsp butter","0.94 cup double cream","1 tbsp black treacle"],"recipeInstructions":[{"@type":"HowToStep","name":"Whisk & Combine Base Ingredients","text":"Stone and chop the dates quite small, put them in a bowl, then pour the boiling water over. Leave for about 30 mins until cool and well-soaked, then mash a bit with a fork. Stir in the vanilla extract. Butter and flour seven mini pudding tins (each about 200ml/7fl oz) and sit them on a baking sheet. Heat oven to 180C/fan 160C/gas 4. Incorporate 1 cup medjool dates, 0.73 cup water, 1 tsp vanilla extract, and 11.7 tbsp self-raising flour smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/sticky-toffee-pudding-ultimate/#step-1"},{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"While the dates are soaking, make the puddings. Mix the flour and bicarbonate of soda together and beat the eggs in a separate bowl. Beat the butter and sugar together in a large bowl for a few mins until slightly creamy (the mixture will be grainy from the sugar). Add the eggs a little at a time, beating well between additions. Beat in the black treacle then, using a large metal spoon, gently fold in one-third of the flour, then half the milk, being careful not to overbeat. Repeat until all the flour and milk is used. Stir the soaked dates into the pudding batter. The mix may look a little curdled at this point and will be like a soft, thick batter. Spoon it evenly between the tins and bake for 20-25 mins, until risen and firm. Incorporate 1 tsp bicarbonate of soda, 2 whole eggs, 5.7 tbsp butter, 9.3 tbsp demerara sugar, 2 tbsp black treacle, 6.7 tbsp milk, 1 scoop ice cream, 11.7 tbsp muscovado sugar, 3.3 tbsp butter, 0.94 cup double cream, and 1 tbsp black treacle smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/sticky-toffee-pudding-ultimate/#step-2"},{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Meanwhile, put the sugar and butter for the sauce in a medium saucepan with half the cream. Bring to the boil over a medium heat, stirring all the time, until the sugar has completely dissolved. Stir in the black treacle, turn up the heat slightly and let the mixture bubble away for 2-3 mins until it is a rich toffee colour, stirring occasionally to make sure it doesn’t burn. Take the pan off the heat and beat in the rest of the cream.","url":"https://crave.devyy.com/recipes/sticky-toffee-pudding-ultimate/#step-3"},{"@type":"HowToStep","name":"Bake Until Golden & Set","text":"Remove the puddings from the oven. Leave in the tins for a few mins, then loosen them well from the sides of the tins with a small palette knife before turning them out. You can serve them now with the sauce drizzled over, but they’ll be even stickier if left for a day or two coated in the sauce. To do this, pour about half the sauce into one or two ovenproof serving dishes. Sit the upturned puddings on the sauce, then pour the rest of the sauce over them. Cover with a loose tent of foil so that the sauce doesn’t smudge (no need to chill).","url":"https://crave.devyy.com/recipes/sticky-toffee-pudding-ultimate/#step-4"},{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"When ready to serve, heat oven to 180C/fan 160C/gas 4. Warm the puddings through, still covered, for 15-20 mins or until the sauce is bubbling. Serve them on their own, or with cream or custard.","url":"https://crave.devyy.com/recipes/sticky-toffee-pudding-ultimate/#step-5"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Puddings & Custards","item":"https://crave.devyy.com/category/puddings-custards/"},{"@type":"ListItem","position":3,"name":"Sticky Toffee Pudding Ultimate","item":"https://crave.devyy.com/recipes/sticky-toffee-pudding-ultimate/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Sticky Toffee Pudding Ultimate?","acceptedAnswer":{"@type":"Answer","text":"Sticky Toffee Pudding Ultimate takes 45 minutes total (15 minutes prep) and yields 4 servings at 331 calories per serving."}},{"@type":"Question","name":"Can I make Sticky Toffee Pudding Ultimate healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Sticky Toffee Pudding Ultimate recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
