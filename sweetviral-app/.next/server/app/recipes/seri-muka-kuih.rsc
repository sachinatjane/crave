10:T1046,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/seri-muka-kuih/","name":"Seri muka kuih","image":["https://crave.devyy.com/ai-images/seri-muka-kuih.jpg","https://crave.devyy.com/ai-images/seri-muka-kuih.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Malaysian-inspired seri muka kuih with 9 measured ingredients — zero sign-up, instant Cook Mode. Ready in 15 mins (4 servings). 4.7★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT0M","totalTime":"PT15M","recipeYield":"4 servings","recipeCategory":"Global Classics","recipeCuisine":"Malaysian","keywords":"Seri muka kuih, Malaysian, Global Classics, #Serimuka, #CraveMadeMeDoIt, #ViralDesserts, #MalaysianSweets","nutrition":{"@type":"NutritionInformation","calories":"269 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.7,"reviewCount":58},"recipeIngredient":["1.78 cup Rice","0.62 cup Coconut Milk","6.7 tbsp Water","1 tsp Salt","5 tbs Corn Flour","3 tbs Flour","3 whole Eggs","0.83 cup Coconut Cream","9.3 tbsp Sugar"],"recipeInstructions":[{"@type":"HowToStep","name":"Prep & Mix: Seri muka kuih","text":"Soak glutinous rice with water for at least 1 ½ hours prior to using. Drain. Prepare a 9-inch round or square cake pan and spray with cooking spray or line with plastic wrap. Mix coconut milk, water, salt and the rice. Pour it into cake pan, topped with the pandan knots. Incorporate 1.78 cup rice, 0.62 cup coconut milk, 6.7 tbsp water, and 1 tsp salt smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/seri-muka-kuih/#step-1"},{"@type":"HowToStep","name":"Build Flavor: Seri muka kuih","text":"Steam for 30 minutes. After 30 minutes, fluff up the rice and remove pandan knots. Then, using a greased spatula, flatten the steamed rice. Make sure there are no holes/air bubbles and gaps in the rice, especially the sides. Steam for another 10 minutes. Incorporate 5 tbs corn flour, 3 tbs flour, 3 whole eggs, 0.83 cup coconut cream, and 9.3 tbsp sugar smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/seri-muka-kuih/#step-2"},{"@type":"HowToStep","name":"Portion, Shape & Layer Evenly","text":"Combine pandan juice, coconut milk, all purpose flour, cornflour, and sugar. Mix well. Add eggs and whisk well then strain into a medium sized metal bowl or pot. Place pandan mixture over simmering water (double boiler or bain-marie).","url":"https://crave.devyy.com/recipes/seri-muka-kuih/#step-3"},{"@type":"HowToStep","name":"Bake / Chill: Seri muka kuih","text":"Stir continuously and cook till custard starts to thicken. (15 minutes) Pour pandan custard into glutinous rice layer, give it a little tap (for air bubbles) and continue to steam for 30 minutes. Remove kuih seri muka from the steamer and allow to cool completely before cutting into rectangles or diamond shapes.","url":"https://crave.devyy.com/recipes/seri-muka-kuih/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"Seri muka kuih","item":"https://crave.devyy.com/recipes/seri-muka-kuih/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Seri muka kuih?","acceptedAnswer":{"@type":"Answer","text":"Seri muka kuih takes 15 minutes total (15 minutes prep) and yields 4 servings at 269 calories per serving."}},{"@type":"Question","name":"Can I make Seri muka kuih healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Seri muka kuih recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
