10:T1124,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/beetroot-pancakes/","name":"Beetroot pancakes","image":["https://crave.devyy.com/ai-images/beetroot-pancakes.jpg","https://crave.devyy.com/ai-images/beetroot-pancakes.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Ukrainian-inspired beetroot pancakes with 11 measured ingredients — zero sign-up, instant Cook Mode. Ready in 33 mins (4 servings). 4.8★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT18M","totalTime":"PT33M","recipeYield":"4 servings","recipeCategory":"Pastries & Donuts","recipeCuisine":"Ukrainian","keywords":"Beetroot pancakes, Ukrainian, Pastries & Donuts, #Beetrootpanca, #CraveMadeMeDoIt, #ViralDesserts, #UkrainianSweets","nutrition":{"@type":"NutritionInformation","calories":"229 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":218},"recipeIngredient":["3 whole Beetroot","3.3 tbsp Milk","0.89 cup Self-raising Flour","1 tsp Baking Powder","2 tbsp Maple Syrup","0.5 tsp Vanilla Extract","3 whole Egg","0.9 oz Butter","0.89 cup Frozen Mixed Berries","2 tbsp Blackcurrant Jam","6.7 tbsp Greek Yogurt"],"recipeInstructions":[{"@type":"HowToStep","name":"Whisk & Combine Base Ingredients","text":"Put the beetroot in a jug with the milk and blend with a stick blender until smooth. Pour into a bowl with the rest of the pancake ingredients and whisk until smooth and vibrant purple. Incorporate 3 whole beetroot, 3.3 tbsp milk, 0.89 cup self-raising flour, and 1 tsp baking powder smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/beetroot-pancakes/#step-1"},{"@type":"HowToStep","name":"Fold In Flavorings & Mix-Ins","text":"Put a small knob of butter in a large non-stick frying pan and heat over a medium-low heat until melted and foamy. Now create 3 or 4 pancakes each made from 2 tbsp of the batter. Cook for 2-3 mins then flip over and cook for a further minute until cooked through. Repeat with any remaining batter. Heat oven to lowest setting and keep the pancakes warm in there until needed. Incorporate 2 tbsp maple syrup and 0.5 tsp vanilla extract smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/beetroot-pancakes/#step-2"},{"@type":"HowToStep","name":"Combine Wet & Dry Smoothly","text":"Fold 3 whole egg, 0.9 oz butter, 0.89 cup frozen mixed berries, 2 tbsp blackcurrant jam, and 6.7 tbsp greek yogurt into the base in two additions using gentle strokes until glossy and uniform with zero dry pockets. Avoid overmixing so the final texture stays light and tender.","url":"https://crave.devyy.com/recipes/beetroot-pancakes/#step-3"},{"@type":"HowToStep","name":"Drain Crisp, Garnish & Serve Warm","text":"Serve with your favourite pancake toppings or make a simple compote by simmering frozen berries in with 1 tbsp blackcurrant jam until bubbling and syrupy (about 5-10 mins). In a small bowl stir together the remaining jam and the yogurt. Stack the cooked pancakes with the yogurt and pour the warm berry compote over the top.","url":"https://crave.devyy.com/recipes/beetroot-pancakes/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Pastries & Donuts","item":"https://crave.devyy.com/category/pastries-donuts/"},{"@type":"ListItem","position":3,"name":"Beetroot pancakes","item":"https://crave.devyy.com/recipes/beetroot-pancakes/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Beetroot pancakes?","acceptedAnswer":{"@type":"Answer","text":"Beetroot pancakes takes 33 minutes total (15 minutes prep) and yields 4 servings at 229 calories per serving."}},{"@type":"Question","name":"Can I make Beetroot pancakes healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Beetroot pancakes recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
