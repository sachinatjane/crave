10:Tfe6,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/french-macaron-dark-ganache-shells/","name":"French Macaron Dark Ganache Shells","image":["https://crave.devyy.com/ai-images/french-macaron-dark-ganache-shells.jpg","https://crave.devyy.com/ai-images/french-macaron-dark-ganache-shells.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_kitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Smooth glossy almond meringue shells with ruffled feet and velvety dark chocolate ganache. Ready in 39 mins (12 servings). 4.8★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT25M","cookTime":"PT14M","totalTime":"PT39M","recipeYield":"12 servings","recipeCategory":"Cookies & Bars","recipeCuisine":"French","keywords":"French Macaron Dark Ganache Shells, French, Cookies & Bars, #Macarons, #CraveMadeMeDoIt, #ViralDesserts, #FrenchSweets","nutrition":{"@type":"NutritionInformation","calories":"145 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":405},"recipeIngredient":["2 cups Superfine blanched almond flour + powdered sugar","3 whites Room-temp egg whites + 1/3 cup caster sugar","0.5 cup Dark chocolate ganache filling"],"recipeInstructions":[{"@type":"HowToStep","name":"Preheat Oven & Prep Your Pan","text":"Preheat your oven to 350°F (175°C) and line your baking pan with parchment paper, leaving a slight overhang for effortless lifting. Measure out 2 cups superfine blanched almond flour + powdered sugar and 3 whites room-temp egg whites + 1/3 cup caster sugar so everything is ready and at room temperature for a silky, lump-free batter.","url":"https://crave.devyy.com/recipes/french-macaron-dark-ganache-shells/#step-1"},{"@type":"HowToStep","name":"Fold Until Ribbon Lava Consistency","text":"Whip 3 whites room-temp egg whites + 1/3 cup caster sugar to stiff glossy peaks, then fold in sifted 2 cups superfine blanched almond flour + powdered sugar until batter flows off the spatula like thick molten ribbon.","url":"https://crave.devyy.com/recipes/french-macaron-dark-ganache-shells/#step-2"},{"@type":"HowToStep","name":"Bake French Macaron Dark Ganache Shells & Check Doneness","text":"Bake for 14 minutes until the edges turn golden and set while the center remains tender. Test with a toothpick—if it comes out with a few moist crumbs rather than wet batter, it is ready.","url":"https://crave.devyy.com/recipes/french-macaron-dark-ganache-shells/#step-3"},{"@type":"HowToStep","name":"Rest 30m Until Dry & Bake","text":"Pipe 1.5-inch rounds, tap tray to pop bubbles, rest 30 mins until dry to the touch, then bake at 300°F (150°C) for 14 mins. Sandwich with 0.5 cup dark chocolate ganache filling!","url":"https://crave.devyy.com/recipes/french-macaron-dark-ganache-shells/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Cookies & Bars","item":"https://crave.devyy.com/category/cookies-bars/"},{"@type":"ListItem","position":3,"name":"French Macaron Dark Ganache Shells","item":"https://crave.devyy.com/recipes/french-macaron-dark-ganache-shells/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make French Macaron Dark Ganache Shells?","acceptedAnswer":{"@type":"Answer","text":"French Macaron Dark Ganache Shells takes 39 minutes total (25 minutes prep) and yields 12 servings at 145 calories per serving."}},{"@type":"Question","name":"Can I make French Macaron Dark Ganache Shells healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this French Macaron Dark Ganache Shells recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
