10:T10ea,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/tunisian-orange-cake/","name":"Tunisian Orange Cake","image":["https://crave.devyy.com/ai-images/tunisian-orange-cake.jpg","https://crave.devyy.com/ai-images/tunisian-orange-cake.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Tunisian-inspired tunisian orange cake with 7 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (6 servings). 4.7★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"6 servings","recipeCategory":"Cakes & Mug Cakes","recipeCuisine":"Tunisian","keywords":"Tunisian Orange Cake, Tunisian, Cakes & Mug Cakes, #TunisianOrang, #CraveMadeMeDoIt, #ViralDesserts, #TunisianSweets","nutrition":{"@type":"NutritionInformation","calories":"430 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.7,"reviewCount":85},"recipeIngredient":["1 pc Orange","1.33 cup Caster Sugar","5 tbsp Olive Oil","1.24 cup Flour","1 tbs Baking Powder","4 pcs Eggs","2 tsp Vanilla Extract"],"recipeInstructions":[{"@type":"HowToStep","name":"Preheat & Prep Your Pan","text":"Preheat oven to 190 C / Gas 5. Grease a 23cm round springform tin. Line your baking pan with parchment paper or grease lightly, and make sure 1 pc orange, 1.33 cup caster sugar, 5 tbsp olive oil, and 1.24 cup flour are measured and at room temperature so they blend smoothly.","url":"https://crave.devyy.com/recipes/tunisian-orange-cake/#step-1"},{"@type":"HowToStep","name":"Fold In Flavorings & Mix-Ins","text":"Cut off the hard bits from the top and bottom of the orange. Slice the orange and remove all seeds. Puree the orange with its peel in a food processor. Add one third of the sugar and the olive oil and continue to mix until well combined. Incorporate 1 tbs baking powder, 4 pcs eggs, and 2 tsp vanilla extract smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/tunisian-orange-cake/#step-2"},{"@type":"HowToStep","name":"Sift & Whisk Dry Ingredients","text":"Sieve together flour and baking powder. Sifting aerates the dry ingredients and removes any stubborn cocoa or flour lumps so the finished crumb bakes up light and even.","url":"https://crave.devyy.com/recipes/tunisian-orange-cake/#step-3"},{"@type":"HowToStep","name":"Bake Until Golden & Set","text":"Beat the eggs and the remaining sugar with an electric hand mixer for at least five minutes until very fluffy. Fold in half of the flour mixture, then the orange and the vanilla, then fold in the remaining flour. Mix well but not for too long.","url":"https://crave.devyy.com/recipes/tunisian-orange-cake/#step-4"},{"@type":"HowToStep","name":"Cool, Garnish & Serve","text":"Pour cake mixture into prepared tin and smooth out. Bake in preheated oven for 20 minutes. Reduce the oven temperature to 160 C / Gas 2 and bake again for 30 minutes Bake until the cake is golden brown and a skewer comes out clean. Cool on a wire cake rack.","url":"https://crave.devyy.com/recipes/tunisian-orange-cake/#step-5"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Cakes & Mug Cakes","item":"https://crave.devyy.com/category/cakes-cupcakes/"},{"@type":"ListItem","position":3,"name":"Tunisian Orange Cake","item":"https://crave.devyy.com/recipes/tunisian-orange-cake/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Tunisian Orange Cake?","acceptedAnswer":{"@type":"Answer","text":"Tunisian Orange Cake takes 45 minutes total (15 minutes prep) and yields 6 servings at 430 calories per serving."}},{"@type":"Question","name":"Can I make Tunisian Orange Cake healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Tunisian Orange Cake recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
