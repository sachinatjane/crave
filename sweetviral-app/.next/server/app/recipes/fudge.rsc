10:Te4b,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/fudge/","name":"Fudge","image":["https://crave.devyy.com/ai-images/fudge.jpg","https://crave.devyy.com/ai-images/fudge.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_us_eu"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Deep chocolate indulgence with zero mixer needed and instant Cook Mode timers. Ready in 10 mins (9 servings). 4.8★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT10M","cookTime":"PT0M","totalTime":"PT10M","recipeYield":"9 servings","recipeCategory":"Chocolate & Brownies","recipeCuisine":"American","keywords":"Fudge, American, Chocolate & Brownies, #Fudge, #CraveMadeMeDoIt, #ViralDesserts, #AmericanSweets","nutrition":{"@type":"NutritionInformation","calories":"320 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":194},"recipeIngredient":["1.5 cups 70% dark chocolate & Dutch cocoa","0.5 cup Unsalted butter","1 cup Powdered or brown sugar","1 cup Flour, biscuit crumbs, or condensed milk"],"recipeInstructions":[{"@type":"HowToStep","name":"Line Pan & Prep Base Ingredients","text":"Line a loaf pan, baking dish, or serving glasses with parchment paper or chill them in the fridge for 5 minutes. Measure out 1.5 cups 70% dark chocolate & dutch cocoa and 0.5 cup unsalted butter so your base whips up thick, creamy, and clump-free.","url":"https://crave.devyy.com/recipes/fudge/#step-1"},{"@type":"HowToStep","name":"Transfer, Smooth Top & Add Garnish","text":"Pour or press the mixture evenly into your prepared dish, smoothing the surface with a spatula. Scatter 1 cup powdered or brown sugar and 1 cup flour, biscuit crumbs, or condensed milk evenly across the top and press gently so it adheres cleanly.","url":"https://crave.devyy.com/recipes/fudge/#step-2"},{"@type":"HowToStep","name":"Melt Base Silky & Chill Firm","text":"Gently melt 1.5 cups 70% dark chocolate & dutch cocoa and 0.5 cup unsalted butter smooth, stir in 1 cup powdered or brown sugar and 1 cup flour, biscuit crumbs, or condensed milk, press into a lined pan (or roll into truffles), and chill 45 minutes until firm.","url":"https://crave.devyy.com/recipes/fudge/#step-3"},{"@type":"HowToStep","name":"Chill Until Firm, Slice & Store","text":"Cover and refrigerate Fudge until completely firm and sliceable. Portion into 9 servings, add any crisp toppings right before serving, and keep leftovers chilled in an airtight container for up to 5 days.","url":"https://crave.devyy.com/recipes/fudge/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Chocolate & Brownies","item":"https://crave.devyy.com/category/chocolate-brownies/"},{"@type":"ListItem","position":3,"name":"Fudge","item":"https://crave.devyy.com/recipes/fudge/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Fudge?","acceptedAnswer":{"@type":"Answer","text":"Fudge takes 10 minutes total (10 minutes prep) and yields 9 servings at 320 calories per serving."}},{"@type":"Question","name":"Can I make Fudge healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Fudge recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
