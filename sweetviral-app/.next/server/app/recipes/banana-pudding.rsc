10:Tf5a,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/banana-pudding/","name":"Banana pudding","image":["https://crave.devyy.com/ai-images/banana-pudding.jpg","https://crave.devyy.com/ai-images/banana-pudding.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_us_eu"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Silky, melt-on-the-tongue creaminess chilled to perfection with zero fuss. Ready in 10 mins (4 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT10M","cookTime":"PT0M","totalTime":"PT10M","recipeYield":"4 servings","recipeCategory":"Puddings & Custards","recipeCuisine":"American","keywords":"Banana pudding, American, Puddings & Custards, #Bananapudding, #CraveMadeMeDoIt, #ViralDesserts, #AmericanSweets","nutrition":{"@type":"NutritionInformation","calories":"285 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":295},"recipeIngredient":["2 cups Whole milk & heavy cream","3 yolks Egg yolks (or cornstarch thickener)","0.33 cup Granulated sugar","0.5 cup Ripe sweet bananas (sliced)"],"recipeInstructions":[{"@type":"HowToStep","name":"Set Up Heavy Saucepan & Ingredients","text":"Place a heavy-bottomed saucepan over medium-low heat and have a heatproof silicone whisk ready. Measure out 2 cups whole milk & heavy cream and 3 yolks egg yolks (or cornstarch thickener) and 0.33 cup granulated sugar and 0.5 cup ripe sweet bananas (sliced) in advance—stovetop desserts move fast once they start bubbling.","url":"https://crave.devyy.com/recipes/banana-pudding/#step-1"},{"@type":"HowToStep","name":"Whisk Custard Silky Over Low Heat","text":"Warm 2 cups whole milk & heavy cream and 0.33 cup granulated sugar, whisk into 3 yolks egg yolks (or cornstarch thickener), and cook gently stirring until thick enough to coat the back of a spoon. Gently press the coating onto every side so it adheres evenly, then let excess drip off before transferring to a clean tray.","url":"https://crave.devyy.com/recipes/banana-pudding/#step-2"},{"@type":"HowToStep","name":"Combine Wet & Dry Smoothly","text":"Fold 0.33 cup granulated sugar and 0.5 cup ripe sweet bananas (sliced) into the base in two additions using gentle strokes until glossy and uniform with zero dry pockets. Avoid overmixing so the final texture stays light and tender.","url":"https://crave.devyy.com/recipes/banana-pudding/#step-3"},{"@type":"HowToStep","name":"Chill 2 Hours & Add Topping","text":"Pour into dessert glasses, chill 2 hours, and crown with 0.5 cup ripe sweet bananas (sliced) and whipped cream. Plate into 4 generous servings while the flavors and textures are at their peak, and store any leftovers covered.","url":"https://crave.devyy.com/recipes/banana-pudding/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Puddings & Custards","item":"https://crave.devyy.com/category/puddings-custards/"},{"@type":"ListItem","position":3,"name":"Banana pudding","item":"https://crave.devyy.com/recipes/banana-pudding/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Banana pudding?","acceptedAnswer":{"@type":"Answer","text":"Banana pudding takes 10 minutes total (10 minutes prep) and yields 4 servings at 285 calories per serving."}},{"@type":"Question","name":"Can I make Banana pudding healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Banana pudding recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
