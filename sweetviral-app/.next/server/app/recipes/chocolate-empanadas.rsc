10:T135e,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/chocolate-empanadas/","name":"Chocolate empanadas","image":["https://crave.devyy.com/ai-images/chocolate-empanadas.jpg","https://crave.devyy.com/ai-images/chocolate-empanadas.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Uruguayan-inspired chocolate empanadas with 10 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (4 servings). 4.8★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"4 servings","recipeCategory":"Chocolate & Brownies","recipeCuisine":"Uruguayan","keywords":"Chocolate empanadas, Uruguayan, Chocolate & Brownies, #Chocolateempa, #CraveMadeMeDoIt, #ViralDesserts, #UruguayanSweets","nutrition":{"@type":"NutritionInformation","calories":"264 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":147},"recipeIngredient":["1.78 cup Condensed Milk","1.11 cup All purpose flour","0.9 oz Unsweetened Cocoa","1 pinch Salt","8.3 tbsp Butter","1 whole Egg","3 tbsp Milk","1.1 oz Butter","1.1 oz Sugar","1 tsp Cinnamon"],"recipeInstructions":[{"@type":"HowToStep","name":"Simmer & Dissolve Smoothly","text":"For the filling place the can in a large pot and cover completely with water. Boil for two and a half hours, occassionally adding water. Let cool before opening. For further tips, please check here. For the dough combine the flour, cocoa powder, and salt in a large bowl. Add the cold butter in small pieces and rub into crumbs with your fingers Add the egg and work into a dough. You may have to add milk, a tablespoon at a time if it still is to dry. Wrap and chill for at least half an hour or overnight. Incorporate 1.78 cup condensed milk, 1.11 cup all purpose flour, 0.9 oz unsweetened cocoa, and 1 pinch salt smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/chocolate-empanadas/#step-1"},{"@type":"HowToStep","name":"Shape & Press Dough Evenly","text":"Line a baking sheeet with parchment paper and preheat the oven to 180 degrees Celsius. Roll out the dough on a lightly floured surface, it should be thin. Cut out circles of 12cm either with a cookie cutter or with a smaller plate/dish. Put two to three teaspoons of the dulce de leche in the middle of each circle. Brush the edges with milk, I do this with my pinkie. Fold each circle in half so that you have a half moon and press down the edges with a fork. You can also turn the edges about half a centimeter inwards every centimeter or so to create a pattern. Incorporate 8.3 tbsp butter, 1 whole egg, 3 tbsp milk, 1.1 oz butter, 1.1 oz sugar, and 1 tsp cinnamon smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/chocolate-empanadas/#step-2"},{"@type":"HowToStep","name":"Bake Chocolate empanadas & Check Doneness","text":"Bake for 30 minutes until the edges turn golden and set while the center remains tender. Test with a toothpick—if it comes out with a few moist crumbs rather than wet batter, it is ready.","url":"https://crave.devyy.com/recipes/chocolate-empanadas/#step-3"},{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Place the prepared empanadas on the baking sheet and brush with egg wash. Bake for about 20-25min. Towards the end of the baking time, melt the remaining butter and mix the sugar and cinnamon in a small bowl. Once you take the empanadas out, immediately brush with the butter and sprinkle with the sugar mix. Empanadas can be enjoyed either still warm or cold. If eating warm, be careful not to burn yourself with hot filling!","url":"https://crave.devyy.com/recipes/chocolate-empanadas/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Chocolate & Brownies","item":"https://crave.devyy.com/category/chocolate-brownies/"},{"@type":"ListItem","position":3,"name":"Chocolate empanadas","item":"https://crave.devyy.com/recipes/chocolate-empanadas/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Chocolate empanadas?","acceptedAnswer":{"@type":"Answer","text":"Chocolate empanadas takes 45 minutes total (15 minutes prep) and yields 4 servings at 264 calories per serving."}},{"@type":"Question","name":"Can I make Chocolate empanadas healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Chocolate empanadas recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
