10:T10a2,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/arnhemse-meisjes/","name":"Arnhemse meisjes","image":["https://crave.devyy.com/ai-images/arnhemse-meisjes.jpg","https://crave.devyy.com/ai-images/arnhemse-meisjes.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Global-inspired arnhemse meisjes with 5 measured ingredients — zero sign-up, instant Cook Mode. Ready in 38 mins (4 servings). 4.8★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT8M","cookTime":"PT30M","totalTime":"PT38M","recipeYield":"4 servings","recipeCategory":"Global Classics","recipeCuisine":"Global","keywords":"Arnhemse meisjes, Global, Global Classics, #Arnhemsemeisj, #CraveMadeMeDoIt, #ViralDesserts, #GlobalSweets","nutrition":{"@type":"NutritionInformation","calories":"360 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":102},"recipeIngredient":["5 slices Puff Pastry","6.7 tbsp vanilla sugar","0.5 tsp Cinnamon","0.5 portion Cardamom","1 zest of 1 Lime"],"recipeInstructions":[{"@type":"HowToStep","name":"Prep & Mix: Arnhemse meisjes","text":"Take your puff pastry from the freezer and defrost. Sprinkle some flour on the kitchen counter. Stack the sheets of puff pastry on top of each other and roll them out with a rolling pin. You want those five sheets to end up being as thin as one sheet. Using a round or oval form press into the puff pastry and try to be as economical doing that as possible. You want to have as many cookies as you can. Incorporate 5 slices puff pastry, 6.7 tbsp vanilla sugar, 0.5 tsp cinnamon, and 0.5 portion cardamom smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/arnhemse-meisjes/#step-1"},{"@type":"HowToStep","name":"Dip & Coat Evenly","text":"Mix the vanilla sugar with the cinnamon, cardemom and limezest in a little bowl Remove the flour from the counter and sprinkle with a bit of the sugar mix. Brush your puff pastry with a little bit of eggwash and than dip into the sugar mix and roll them softly to press the sugar in. Incorporate 1 zest of 1 lime smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/arnhemse-meisjes/#step-2"},{"@type":"HowToStep","name":"Shape & Press Dough Evenly","text":"Put your sugary puff pastry on a baking sheet (greased or with baking paper) and leave the dough to rest for about 20 to 25 minutes. this will make the cookies even crisper. Preheat the oven in the meantime to 180 C and put the baking tray in the oven. bake the cookies golden brown in about 25 minutes and make sure the sugar is caramelised nicely.","url":"https://crave.devyy.com/recipes/arnhemse-meisjes/#step-3"},{"@type":"HowToStep","name":"Cool, Garnish & Serve","text":"And voila, Girls from Arnhem with an Almeerse twist Voila, Arnhemse Meisjes met een Almeerse twist. Let Arnhemse meisjes cool for 10–15 minutes so the crumb sets cleanly before slicing into 4 portions, then garnish and serve.","url":"https://crave.devyy.com/recipes/arnhemse-meisjes/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"Arnhemse meisjes","item":"https://crave.devyy.com/recipes/arnhemse-meisjes/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Arnhemse meisjes?","acceptedAnswer":{"@type":"Answer","text":"Arnhemse meisjes takes 38 minutes total (8 minutes prep) and yields 4 servings at 360 calories per serving."}},{"@type":"Question","name":"Can I make Arnhemse meisjes healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Arnhemse meisjes recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
