10:T10e4,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/authentic-norwegian-kransekake/","name":"Authentic Norwegian Kransekake","image":["https://crave.devyy.com/ai-images/authentic-norwegian-kransekake.jpg","https://crave.devyy.com/ai-images/authentic-norwegian-kransekake.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Norway-inspired authentic norwegian kransekake with 6 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (4 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"4 servings","recipeCategory":"Global Classics","recipeCuisine":"Norway","keywords":"Authentic Norwegian Kransekake, Norway, Global Classics, #AuthenticNorw, #CraveMadeMeDoIt, #ViralDesserts, #NorwaySweets","nutrition":{"@type":"NutritionInformation","calories":"343 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":227},"recipeIngredient":["3 cups Almonds","4 whole Egg White","4 cups Powdered Sugar","2 cups Powdered Sugar","1 whole Egg White","0.5 tsp Lemon Juice"],"recipeInstructions":[{"@type":"HowToStep","name":"Shape & Press Dough Evenly","text":"Grind almonds in an almond grinder or food processor. Mix almonds and powdered sugar together in a large mixing bowl. Add three of the egg whites and knead the dough together with your hands until it comes together in a ball. Wrap in cling film and leave in the fridge for at least an hour, preferably until the next day. Incorporate 3 cups almonds, 4 whole egg white, 4 cups powdered sugar, and 2 cups powdered sugar smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/authentic-norwegian-kransekake/#step-1"},{"@type":"HowToStep","name":"Dip & Coat Evenly","text":"Grease the kransekake forms thoroughly and coat with semolina, flour, or bread crumbs. Preheat oven to 210°C (410°F) top and bottom heat. Divide the dough into six sections. Incorporate 1 whole egg white and 0.5 tsp lemon juice smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/authentic-norwegian-kransekake/#step-2"},{"@type":"HowToStep","name":"Bake Authentic Norwegian Kransekake & Check Doneness","text":"Bake for 30 minutes until the edges turn golden and set while the center remains tender. Test with a toothpick—if it comes out with a few moist crumbs rather than wet batter, it is ready.","url":"https://crave.devyy.com/recipes/authentic-norwegian-kransekake/#step-3"},{"@type":"HowToStep","name":"Shape & Press Dough Evenly","text":"Slowly add the remaining egg white to the dough and knead it until you can roll it into long sausages about as thick as your index finger. Fill the forms with the dough sausages, pinching the ends together to make rings. Set the forms on a baking sheet and back in the middle of the oven for about 10 – 12 minutes, until the tops are golden brown.","url":"https://crave.devyy.com/recipes/authentic-norwegian-kransekake/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"Authentic Norwegian Kransekake","item":"https://crave.devyy.com/recipes/authentic-norwegian-kransekake/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Authentic Norwegian Kransekake?","acceptedAnswer":{"@type":"Answer","text":"Authentic Norwegian Kransekake takes 45 minutes total (15 minutes prep) and yields 4 servings at 343 calories per serving."}},{"@type":"Question","name":"Can I make Authentic Norwegian Kransekake healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Authentic Norwegian Kransekake recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
