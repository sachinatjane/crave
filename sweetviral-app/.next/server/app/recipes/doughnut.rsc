10:Teb1,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/doughnut/","name":"Doughnut","image":["https://crave.devyy.com/ai-images/doughnut.jpg","https://crave.devyy.com/ai-images/doughnut.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_us_eu"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Shattering flaky golden layers and warm sugar-glazed crunch straight from your kitchen. Ready in 31 mins (6 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT16M","totalTime":"PT31M","recipeYield":"6 servings","recipeCategory":"Pastries & Donuts","recipeCuisine":"American & European","keywords":"Doughnut, American & European, Pastries & Donuts, #Doughnut, #CraveMadeMeDoIt, #ViralDesserts, #AmericanSweets","nutrition":{"@type":"NutritionInformation","calories":"315 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":194},"recipeIngredient":["2 cups All-purpose or bread flour","0.75 cup Warm milk + yeast (or baking powder)","4 tbsp Melted butter + 1 egg","0.75 cup Pure Madagascar vanilla bean paste","0.5 cup Powdered sugar or cinnamon sugar dust"],"recipeInstructions":[{"@type":"HowToStep","name":"Prepare Dough & Shape Uniformly","text":"Combine 2 cups all-purpose or bread flour, 0.75 cup warm milk + yeast (or baking powder), and 4 tbsp melted butter + 1 egg into a smooth elastic dough or batter. Shape evenly and rest 15 mins. Keep 2 cups all-purpose or bread flour, 0.75 cup warm milk + yeast (or baking powder), and 4 tbsp melted butter + 1 egg prepped and measured within reach so each step comes together smoothly and evenly.","url":"https://crave.devyy.com/recipes/doughnut/#step-1"},{"@type":"HowToStep","name":"Cook Golden & Finish with Glaze","text":"Bake at 375°F (190°C) or air-fry 14–16 mins (or fry 3 mins) until golden puffed, then fill or drizzle with 0.75 cup pure madagascar vanilla bean paste and 0.5 cup powdered sugar or cinnamon sugar dust.","url":"https://crave.devyy.com/recipes/doughnut/#step-2"},{"@type":"HowToStep","name":"Bake Doughnut & Check Doneness","text":"Bake for 16 minutes until the edges turn golden and set while the center remains tender. Test with a toothpick—if it comes out with a few moist crumbs rather than wet batter, it is ready.","url":"https://crave.devyy.com/recipes/doughnut/#step-3"},{"@type":"HowToStep","name":"Rest 5 Minutes & Serve Warm","text":"Carefully lift Doughnut out of the air-fryer basket and rest 5 minutes on a cooling rack so the crust crisps up. Plate into 6 servings and enjoy warm.","url":"https://crave.devyy.com/recipes/doughnut/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Pastries & Donuts","item":"https://crave.devyy.com/category/pastries-donuts/"},{"@type":"ListItem","position":3,"name":"Doughnut","item":"https://crave.devyy.com/recipes/doughnut/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Doughnut?","acceptedAnswer":{"@type":"Answer","text":"Doughnut takes 31 minutes total (15 minutes prep) and yields 6 servings at 315 calories per serving."}},{"@type":"Question","name":"Can I make Doughnut healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Doughnut recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
