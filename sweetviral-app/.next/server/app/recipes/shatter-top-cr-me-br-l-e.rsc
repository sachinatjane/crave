10:Tfd6,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/shatter-top-cr-me-br-l-e/","name":"Shatter-Top Crème Brûlée","image":["https://crave.devyy.com/ai-images/shatter-top-cr-me-br-l-e.jpg","https://crave.devyy.com/ai-images/shatter-top-cr-me-br-l-e.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_kitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Velvety Madagascar vanilla bean custard topped with a paper-thin caramelized sugar glass. Ready in 45 mins (4 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT10M","cookTime":"PT35M","totalTime":"PT45M","recipeYield":"4 servings","recipeCategory":"Puddings & Custards","recipeCuisine":"French","keywords":"Shatter-Top Crème Brûlée, French, Puddings & Custards, #CrmeBrle, #CraveMadeMeDoIt, #ViralDesserts, #FrenchSweets","nutrition":{"@type":"NutritionInformation","calories":"340 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":484},"recipeIngredient":["2 cups Heavy whipping cream","5 yolks Large egg yolks","0.33 cup Granulated sugar (plus 4 tbsp for crust)","1.5 tsp Pure vanilla bean paste"],"recipeInstructions":[{"@type":"HowToStep","name":"Set Up Heavy Saucepan & Ingredients","text":"Place a heavy-bottomed saucepan over medium-low heat and have a heatproof silicone whisk ready. Measure out 2 cups heavy whipping cream and 5 yolks large egg yolks and 0.33 cup granulated sugar (plus 4 tbsp for crust) and 1.5 tsp pure vanilla bean paste in advance—stovetop desserts move fast once they start bubbling.","url":"https://crave.devyy.com/recipes/shatter-top-cr-me-br-l-e/#step-1"},{"@type":"HowToStep","name":"Whisk Warm Cream Into Yolks","text":"Simmer 2 cups heavy whipping cream with 1.5 tsp pure vanilla bean paste. Whisk 5 yolks large egg yolks and 0.33 cup granulated sugar (plus 4 tbsp for crust), then slowly stream warm cream in while whisking continuously. Stir gently over low to medium-low heat until completely dissolved and glossy, scraping the sides so nothing crystallizes or scorches.","url":"https://crave.devyy.com/recipes/shatter-top-cr-me-br-l-e/#step-2"},{"@type":"HowToStep","name":"Bake Gently & Chill","text":"Pour into ramekins set in a hot water bath. Bake at 325°F (165°C) for 35 minutes until edges set with a slight center wobble. Chill 3 hours.","url":"https://crave.devyy.com/recipes/shatter-top-cr-me-br-l-e/#step-3"},{"@type":"HowToStep","name":"Sprinkle Sugar & Torch Until Glassy","text":"Sprinkle 1 tbsp sugar per ramekin and torch (or broil 2 mins) until bubbling amber. Wait 60 seconds for the iconic spoon crack! Plate into 4 generous servings while the flavors and textures are at their peak, and store any leftovers covered.","url":"https://crave.devyy.com/recipes/shatter-top-cr-me-br-l-e/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Puddings & Custards","item":"https://crave.devyy.com/category/puddings-custards/"},{"@type":"ListItem","position":3,"name":"Shatter-Top Crème Brûlée","item":"https://crave.devyy.com/recipes/shatter-top-cr-me-br-l-e/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Shatter-Top Crème Brûlée?","acceptedAnswer":{"@type":"Answer","text":"Shatter-Top Crème Brûlée takes 45 minutes total (10 minutes prep) and yields 4 servings at 340 calories per serving."}},{"@type":"Question","name":"Can I make Shatter-Top Crème Brûlée healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Shatter-Top Crème Brûlée recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
