11:["$","noscript",null,{"children":["$","article",null,{"children":[["$","h1",null,{"children":"Classic Christmas pudding"}],["$","p",null,{"children":"British-inspired classic christmas pudding with 11 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (4 servings). 4.8★ rated with US/Metric scaling & hands-free Cook Mode."}],["$","h2",null,{"children":"Ingredients"}],["$","ul",null,{"children":[["$","li","0",{"children":"3.3 tbsp Almonds"}],["$","li","1",{"children":"2 pcs Bramley Apples"}],["$","li","2",{"children":"0.89 cup Candied Peel"}],["$","li","3",{"children":"1 whole Nutmeg"}],["$","li","4",{"children":"4.44 cup Raisins"}],["$","li","5",{"children":"9.3 tbsp Plain Flour"}],["$","li","6",{"children":"6.7 tbsp Breadcrumbs"}],["$","li","7",{"children":"6.7 tbsp Muscovado Sugar"}],["$","li","8",{"children":"3 pcs Eggs"}],["$","li","9",{"children":"2 tbs Brandy"}],["$","li","10",{"children":"1.11 cup Butter"}]]}],["$","h2",null,{"children":"Step-by-Step Instructions"}],["$","ol",null,{"children":[["$","li","1",{"children":[["$","h3",null,{"children":"Dip & Coat Evenly"}],["$","p",null,{"children":"Get everything for the pudding prepared. Chop the almonds coarsely. Peel, core and chop the cooking apples. Sharpen your knife and chop the candied peel. (You can chop the almonds and apples in a food processor, but the peel must be done by hand.) Grate three quarters of the nutmeg (sounds a lot but it's correct). Mix the almonds, apples, candied peel, nutmeg, raisins, flour, breadcrumbs, light muscovado sugar, eggs and 2 tbsp brandy or cognac in a large bowl. Incorporate 3.3 tbsp almonds, 2 pcs bramley apples, 0.89 cup candied peel, and 1 whole nutmeg smoothly until evenly distributed."}]]}],["$","li","2",{"children":[["$","h3",null,{"children":"Fold In Flavorings & Mix-Ins"}],["$","p",null,{"children":"Holding the butter in its wrapper, grate a quarter of it into the bowl, then stir everything together. Repeat until all the butter is grated, then stir for 3-4 mins – the mixture is ready when it subsides slightly after each stir. Ask the family to stir too, and get everyone to make a wish. Generously butter two 1.2 litre bowls and put a circle of baking parchment in the bottom of each. Pack in the pudding mixture. Cover with a double layer of baking parchment, pleating it to allow for expansion, then tie with string (keep the paper in place with a rubber band while tying). Trim off any excess paper. Incorporate 4.44 cup raisins, 9.3 tbsp plain flour, 6.7 tbsp breadcrumbs, 6.7 tbsp muscovado sugar, 3 pcs eggs, 2 tbs brandy, and 1.11 cup butter smoothly until evenly distributed."}]]}],["$","li","3",{"children":[["$","h3",null,{"children":"Simmer & Dissolve Smoothly"}],["$","p",null,{"children":"Now stand each bowl on a large sheet of foil and bring the edges up over the top, then put another sheet of foil over the top and bring it down underneath to make a double package (this makes the puddings watertight). Tie with more string, and make a handle for easy lifting in and out of the pan. Watch our video to see how to tie up a pudding correctly. Boil or oven steam the puddings for 8 hrs, topping up with water as necessary. Remove from the pans and leave to cool overnight. When cold, discard the messy wrappings and re-wrap in new baking parchment, foil and string. Store in a cool, dry place until Christmas."}]]}],["$","li","4",{"children":[["$","h3",null,{"children":"Cream Butter & Sugar Fluffy"}],["$","p",null,{"children":"To make the brandy butter, cream the butter with the orange zest and icing sugar. Gradually beat in the brandy or cognac and chopped stem ginger. Put in a small bowl, fork the top attractively and put in the fridge to set. The butter will keep for a week in the fridge, or it can be frozen for up to six weeks. On Christmas Day, boil or oven steam for 1 hr. Unwrap and turn out. To flame, warm 3-4 tbsp brandy in a small pan, pour it over the pudding and set light to it."}]]}]]}],"$L13"]}]}]
12:["$","$L14",null,{"initialRecipeSlug":"classic-christmas-pudding","initialRecipe":{"id":"mdb-52988","slug":"classic-christmas-pudding","title":"Classic Christmas pudding","shortTag":"Classic Christ","storyViews":"82K","viewsLabel":"82K Views","viewsNumeric":82.1,"remakeSuccessRate":"98.5%","rating":4.8,"ratingCount":"59","prepMin":15,"bakeMin":30,"totalMin":45,"skill":"Easy","baseServings":4,"kcal":304,"zeroMixer":false,"cuisine":"British","dessertCategory":"puddings-custards","primaryPlatform":"instagram","platforms":["instagram","pinterest","facebook"],"categories":["all"],"soundName":"velvet spoon wobble","badgeChip":"British Hit","creatorHandle":"@crave_testkitchen","hookLine":"British-inspired classic christmas pudding with 11 measured ingredients — zero sign-up, instant Cook Mode.","heroImage":"./ai-images/classic-christmas-pudding.jpg","thumbImage":"./ai-images/classic-christmas-pudding.jpg","pinterestImage":"./ai-images/classic-christmas-pudding.jpg","hashtags":["#ClassicChrist","#CraveMadeMeDoIt","#ViralDesserts","#BritishSweets"],"pantryCore":["pistachio","sugar","cinnamon","flour","eggs","butter"],"ingredientGroups":[{"title":"Primary Base Ingredients","badge":"British Style","tone":"tertiary","items":[{"id":"m52988_1","name":"Almonds","baseAmount":3.3,"usUnit":"tbsp","metricAmount":50,"metricUnit":"g","pantryKey":"pistachio","stepRef":1},{"id":"m52988_2","name":"Bramley Apples","baseAmount":2,"usUnit":"pcs","metricAmount":2,"metricUnit":"pcs","pantryKey":"sugar","stepRef":1},{"id":"m52988_3","name":"Candied Peel","baseAmount":0.89,"usUnit":"cup","metricAmount":200,"metricUnit":"g","pantryKey":"sugar","stepRef":1},{"id":"m52988_4","name":"Nutmeg","baseAmount":1,"usUnit":"whole","metricAmount":1,"metricUnit":"whole","pantryKey":"cinnamon","stepRef":1},{"id":"m52988_5","name":"Raisins","baseAmount":4.44,"usUnit":"cup","metricAmount":1000,"metricUnit":"g","pantryKey":"sugar","stepRef":2},{"id":"m52988_6","name":"Plain Flour","baseAmount":9.3,"usUnit":"tbsp","metricAmount":140,"metricUnit":"g","pantryKey":"flour","stepRef":2}]},{"title":"Flavor, Glaze & Finish","badge":"Signature Touch","tone":"primary","items":[{"id":"m52988_7","name":"Breadcrumbs","baseAmount":6.7,"usUnit":"tbsp","metricAmount":100,"metricUnit":"g","pantryKey":"sugar","stepRef":2},{"id":"m52988_8","name":"Muscovado Sugar","baseAmount":6.7,"usUnit":"tbsp","metricAmount":100,"metricUnit":"g","pantryKey":"sugar","stepRef":2},{"id":"m52988_9","name":"Eggs","baseAmount":3,"usUnit":"pcs","metricAmount":3,"metricUnit":"pcs","pantryKey":"eggs","stepRef":2},{"id":"m52988_10","name":"Brandy","baseAmount":2,"usUnit":"tbs","metricAmount":2,"metricUnit":"tbs","pantryKey":"sugar","stepRef":2},{"id":"m52988_11","name":"Butter","baseAmount":1.11,"usUnit":"cup","metricAmount":250,"metricUnit":"g","pantryKey":"butter","stepRef":2}]}],"steps":[{"stepNumber":1,"phaseLabel":"Prep & Mix","title":"Dip & Coat Evenly","instructionTemplate":"Get everything for the pudding prepared. Chop the almonds coarsely. Peel, core and chop the cooking apples. Sharpen your knife and chop the candied peel. (You can chop the almonds and apples in a food processor, but the peel must be done by hand.) Grate three quarters of the nutmeg (sounds a lot but it's correct). Mix the almonds, apples, candied peel, nutmeg, raisins, flour, breadcrumbs, light muscovado sugar, eggs and 2 tbsp brandy or cognac in a large bowl. Incorporate {m52988_1}, {m52988_2}, {m52988_3}, and {m52988_4} smoothly until evenly distributed.","durationMin":3,"timerSeconds":180,"activeMeasureSummary":"Almonds, Bramley Apples","creatorSecret":"Prep and measure almonds first—mise en place makes this dessert twice as fast."},{"stepNumber":2,"phaseLabel":"Build Flavor","title":"Fold In Flavorings & Mix-Ins","instructionTemplate":"Holding the butter in its wrapper, grate a quarter of it into the bowl, then stir everything together. Repeat until all the butter is grated, then stir for 3-4 mins – the mixture is ready when it subsides slightly after each stir. Ask the family to stir too, and get everyone to make a wish. Generously butter two 1.2 litre bowls and put a circle of baking parchment in the bottom of each. Pack in the pudding mixture. Cover with a double layer of baking parchment, pleating it to allow for expansion, then tie with string (keep the paper in place with a rubber band while tying). Trim off any excess paper. Incorporate {m52988_5}, {m52988_6}, {m52988_7}, {m52988_8}, {m52988_9}, {m52988_10}, and {m52988_11} smoothly until evenly distributed.","durationMin":3,"timerSeconds":180,"activeMeasureSummary":"Candied Peel, Nutmeg"},{"stepNumber":3,"phaseLabel":"Shape & Layer","title":"Simmer & Dissolve Smoothly","instructionTemplate":"Now stand each bowl on a large sheet of foil and bring the edges up over the top, then put another sheet of foil over the top and bring it down underneath to make a double package (this makes the puddings watertight). Tie with more string, and make a handle for easy lifting in and out of the pan. Watch our video to see how to tie up a pudding correctly. Boil or oven steam the puddings for 8 hrs, topping up with water as necessary. Remove from the pans and leave to cool overnight. When cold, discard the messy wrappings and re-wrap in new baking parchment, foil and string. Store in a cool, dry place until Christmas.","durationMin":3,"timerSeconds":180,"activeMeasureSummary":"Raisins, Plain Flour"},{"stepNumber":4,"phaseLabel":"Bake / Chill","title":"Cream Butter & Sugar Fluffy","instructionTemplate":"To make the brandy butter, cream the butter with the orange zest and icing sugar. Gradually beat in the brandy or cognac and chopped stem ginger. Put in a small bowl, fork the top attractively and put in the fridge to set. The butter will keep for a week in the fridge, or it can be frozen for up to six weeks. On Christmas Day, boil or oven steam for 1 hr. Unwrap and turn out. To flame, warm 3-4 tbsp brandy in a small pan, pour it over the pudding and set light to it.","durationMin":30,"timerSeconds":1800,"activeMeasureSummary":"Breadcrumbs, Muscovado Sugar","criticalTip":"Let set for 5–10 minutes before slicing or plating so the textures hold crisp and photogenic!","creatorSecret":"Press plastic wrap directly onto the warm custard surface while chilling to prevent a skin from forming."}],"ugcQuotes":[{"id":"muq-52988","handle":"@baker_classic-","image":"./ai-images/classic-christmas-pudding.jpg","quote":"Followed the scaled metric steps—came out flawless in 45 mins!","rating":5}]}}]
