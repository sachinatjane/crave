10:T14d5,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/churros/","name":"Churros","image":["https://crave.devyy.com/ai-images/churros.jpg","https://crave.devyy.com/ai-images/churros.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Spanish-inspired churros with 13 measured ingredients — zero sign-up, instant Cook Mode. Ready in 15 mins (4 servings). 4.7★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT0M","totalTime":"PT15M","recipeYield":"4 servings","recipeCategory":"Pastries & Donuts","recipeCuisine":"Spanish","keywords":"Churros, Spanish, Pastries & Donuts, #Churros, #CraveMadeMeDoIt, #ViralDesserts, #SpanishSweets","nutrition":{"@type":"NutritionInformation","calories":"224 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.7,"reviewCount":161},"recipeIngredient":["3.3 tbsp Butter","0.5 tsp Vanilla Extract","1.11 cup Plain Flour","1 tsp Baking Powder","4.17 cup Sunflower Oil","2 chopped Bread","0.89 cup Dark Chocolate","6.7 tbsp Double Cream","6.7 tbsp Milk","3 tbsp Golden Syrup","0.5 tsp Vanilla Extract","6.7 tbsp Caster Sugar","2 tsp Cinnamon"],"recipeInstructions":[{"@type":"HowToStep","name":"Prep & Mix: Churros","text":"Boil the kettle, then measure 300ml boiling water into a jug and add the melted butter and vanilla extract. Sift the flour and baking powder into a big mixing bowl with a big pinch of salt. Make a well in the centre, then pour in the contents of the jug and very quickly beat into the flour with a wooden spoon until lump-free. Rest for 10-15 mins while you make the sauce. Put all the sauce ingredients into a pan and gently melt together, stirring occasionally until you have a smooth shiny sauce. Keep warm on a low heat. Incorporate 3.3 tbsp butter, 0.5 tsp vanilla extract, 1.11 cup plain flour, and 1 tsp baking powder smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/churros/#step-1"},{"@type":"HowToStep","name":"Build Flavor: Churros","text":"Fill a large deep saucepan one-third full of oil. Cooking with hot oil can be dangerous – before you start, read up on how to deep-fry safely to avoid accidents in the kitchen. Heat until a cube of bread browns in 45 seconds to 1 min. Cover a tray with kitchen paper and mix the caster sugar and cinnamon together. Fit a star nozzle to a piping bag – 1.5-2cm wide is a good size. Fill with the rested dough, then pipe 2-3 strips directly into the pan, snipping off each dough strip with a pair of kitchen scissors. Fry until golden brown and crisp. Be very careful here – if air bubbles form in the churros they can explode, especially if the oil overheats or you use old flour. Cooking with hot oil can be dangerous – before you start, read up on how to deep-fry safely to avoid accidents in the kitchen. Keep children out of the kitchen and protect yourself by wearing long sleeves and eye protection, and keeping your face away from the pan. Incorporate 4.17 cup sunflower oil, 2 chopped bread, and 0.89 cup dark chocolate smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/churros/#step-2"},{"@type":"HowToStep","name":"Shape & Layer: Churros","text":"Once the churros are crisp and golden brown, remove them from the oil with a slotted spoon and drain on the kitchen paper-lined tray. Carry on cooking the rest of the dough in batches, sprinkling the cooked churros with some cinnamon sugar as you go. When you’ve cooked all the churros, toss with any remaining cinnamon sugar and serve with the chocolate sauce, for dipping. To see a video of how to prepare churros, take a look at our churros ice cream sandwich recipe.","url":"https://crave.devyy.com/recipes/churros/#step-3"},{"@type":"HowToStep","name":"Drain Crisp, Toss & Serve Fresh","text":"Transfer to the wire rack to drain excess oil for 1–2 minutes while still piping hot, then finish with 6.7 tbsp double cream, 6.7 tbsp milk, 3 tbsp golden syrup, 0.5 tsp vanilla extract, 6.7 tbsp caster sugar, and 2 tsp cinnamon. Serve Churros fresh while the exterior is shatteringly crisp.","url":"https://crave.devyy.com/recipes/churros/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Pastries & Donuts","item":"https://crave.devyy.com/category/pastries-donuts/"},{"@type":"ListItem","position":3,"name":"Churros","item":"https://crave.devyy.com/recipes/churros/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Churros?","acceptedAnswer":{"@type":"Answer","text":"Churros takes 15 minutes total (15 minutes prep) and yields 4 servings at 224 calories per serving."}},{"@type":"Question","name":"Can I make Churros healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Churros recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
17:I[2206,["882","static/chunks/882-a357dcfe3e786f92.js","178","static/chunks/app/recipes/%5Bslug%5D/page-ff1ba417b1c5ec11.js"],"App"]
13:T42c,Fill a large deep saucepan one-third full of oil. Cooking with hot oil can be dangerous – before you start, read up on how to deep-fry safely to avoid accidents in the kitchen. Heat until a cube of bread browns in 45 seconds to 1 min. Cover a tray with kitchen paper and mix the caster sugar and cinnamon together. Fit a star nozzle to a piping bag – 1.5-2cm wide is a good size. Fill with the rested dough, then pipe 2-3 strips directly into the pan, snipping off each dough strip with a pair of kitchen scissors. Fry until golden brown and crisp. Be very careful here – if air bubbles form in the churros they can explode, especially if the oil overheats or you use old flour. Cooking with hot oil can be dangerous – before you start, read up on how to deep-fry safely to avoid accidents in the kitchen. Keep children out of the kitchen and protect yourself by wearing long sleeves and eye protection, and keeping your face away from the pan. Incorporate 4.17 cup sunflower oil, 2 chopped bread, and 0.89 cup dark chocolate smoothly until evenly distributed.11:["$","noscript",null,{"children":["$","article",null,{"children":[["$","h1",null,{"children":"Churros"}],["$","p",null,{"children":"Spanish-inspired churros with 13 measured ingredients — zero sign-up, instant Cook Mode. Ready in 15 mins (4 servings). 4.7★ rated with US/Metric scaling & hands-free Cook Mode."}],["$","h2",null,{"children":"Ingredients"}],["$","ul",null,{"children":[["$","li","0",{"children":"3.3 tbsp Butter"}],["$","li","1",{"children":"0.5 tsp Vanilla Extract"}],["$","li","2",{"children":"1.11 cup Plain Flour"}],["$","li","3",{"children":"1 tsp Baking Powder"}],["$","li","4",{"children":"4.17 cup Sunflower Oil"}],["$","li","5",{"children":"2 chopped Bread"}],["$","li","6",{"children":"0.89 cup Dark Chocolate"}],["$","li","7",{"children":"6.7 tbsp Double Cream"}],["$","li","8",{"children":"6.7 tbsp Milk"}],["$","li","9",{"children":"3 tbsp Golden Syrup"}],["$","li","10",{"children":"0.5 tsp Vanilla Extract"}],["$","li","11",{"children":"6.7 tbsp Caster Sugar"}],["$","li","12",{"children":"2 tsp Cinnamon"}]]}],["$","h2",null,{"children":"Step-by-Step Instructions"}],["$","ol",null,{"children":[["$","li","1",{"children":[["$","h3",null,{"children":"Prep & Mix: Churros"}],["$","p",null,{"children":"Boil the kettle, then measure 300ml boiling water into a jug and add the melted butter and vanilla extract. Sift the flour and baking powder into a big mixing bowl with a big pinch of salt. Make a well in the centre, then pour in the contents of the jug and very quickly beat into the flour with a wooden spoon until lump-free. Rest for 10-15 mins while you make the sauce. Put all the sauce ingredients into a pan and gently melt together, stirring occasionally until you have a smooth shiny sauce. Keep warm on a low heat. Incorporate 3.3 tbsp butter, 0.5 tsp vanilla extract, 1.11 cup plain flour, and 1 tsp baking powder smoothly until evenly distributed."}]]}],["$","li","2",{"children":[["$","h3",null,{"children":"Build Flavor: Churros"}],["$","p",null,{"children":"$13"}]]}],["$","li","3",{"children":[["$","h3",null,{"children":"Shape & Layer: Churros"}],["$","p",null,{"children":"Once the churros are crisp and golden brown, remove them from the oil with a slotted spoon and drain on the kitchen paper-lined tray. Carry on cooking the rest of the dough in batches, sprinkling the cooked churros with some cinnamon sugar as you go. When you’ve cooked all the churros, toss with any remaining cinnamon sugar and serve with the chocolate sauce, for dipping. To see a video of how to prepare churros, take a look at our churros ice cream sandwich recipe."}]]}],["$","li","4",{"children":["$L14","$L15"]}]]}],"$L16"]}]}]
