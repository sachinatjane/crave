12:["$","$L14",null,{"initialRecipeSlug":"apple-frangipan-tart","initialRecipe":{"id":"mdb-52768","slug":"apple-frangipan-tart","title":"Apple Frangipan Tart","shortTag":"Apple Frangipa","storyViews":"43K","viewsLabel":"43K Views","viewsNumeric":43.3,"remakeSuccessRate":"95.8%","rating":4.7,"ratingCount":"161","prepMin":15,"bakeMin":30,"totalMin":45,"skill":"Easy","baseServings":6,"kcal":422,"zeroMixer":false,"cuisine":"British","dessertCategory":"pies-tarts","primaryPlatform":"youtube","platforms":["youtube","tiktok","facebook"],"categories":["all","airfryer"],"soundName":"golden crust cut","badgeChip":"British Hit","creatorHandle":"@crave_testkitchen","hookLine":"British-inspired apple frangipan tart with 9 measured ingredients — zero sign-up, instant Cook Mode.","heroImage":"./ai-images/apple-frangipan-tart.jpg","thumbImage":"./ai-images/apple-frangipan-tart.jpg","pinterestImage":"./ai-images/apple-frangipan-tart.jpg","hashtags":["#AppleFrangipa","#CraveMadeMeDoIt","#ViralDesserts","#BritishSweets"],"pantryCore":["flour","butter","sugar","eggs","pistachio"],"ingredientGroups":[{"title":"Primary Base Ingredients","badge":"British Style","tone":"tertiary","items":[{"id":"m52768_1","name":"digestive biscuits","baseAmount":11.7,"usUnit":"tbsp","metricAmount":175,"metricUnit":"g","pantryKey":"flour","stepRef":1},{"id":"m52768_2","name":"butter","baseAmount":5,"usUnit":"tbsp","metricAmount":75,"metricUnit":"g","pantryKey":"butter","stepRef":1},{"id":"m52768_3","name":"Bramley apples","baseAmount":0.89,"usUnit":"cup","metricAmount":200,"metricUnit":"g","pantryKey":"sugar","stepRef":1},{"id":"m52768_4","name":"Salted Butter","baseAmount":5,"usUnit":"tbsp","metricAmount":75,"metricUnit":"g","pantryKey":"butter","stepRef":1},{"id":"m52768_5","name":"caster sugar","baseAmount":5,"usUnit":"tbsp","metricAmount":75,"metricUnit":"g","pantryKey":"sugar","stepRef":2}]},{"title":"Flavor, Glaze & Finish","badge":"Signature Touch","tone":"primary","items":[{"id":"m52768_6","name":"free-range eggs, beaten","baseAmount":2,"usUnit":"whole","metricAmount":2,"metricUnit":"whole","pantryKey":"eggs","stepRef":2},{"id":"m52768_7","name":"ground almonds","baseAmount":5,"usUnit":"tbsp","metricAmount":75,"metricUnit":"g","pantryKey":"pistachio","stepRef":2},{"id":"m52768_8","name":"almond extract","baseAmount":1,"usUnit":"tsp","metricAmount":5,"metricUnit":"ml","pantryKey":"pistachio","stepRef":2},{"id":"m52768_9","name":"flaked almonds","baseAmount":3.3,"usUnit":"tbsp","metricAmount":50,"metricUnit":"g","pantryKey":"pistachio","stepRef":2}]}],"steps":[{"stepNumber":1,"phaseLabel":"Prep & Mix","title":"Melt & Whisk Smooth","instructionTemplate":"Preheat the oven to 200C/180C Fan/Gas 6. Put the biscuits in a large re-sealable freezer bag and bash with a rolling pin into fine crumbs. Melt the butter in a small pan, then add the biscuit crumbs and stir until coated with butter. Tip into the tart tin and, using the back of a spoon, press over the base and sides of the tin to give an even layer. Chill in the fridge while you make the filling. Incorporate {m52768_1}, {m52768_2}, {m52768_3}, and {m52768_4} smoothly until evenly distributed.","durationMin":3,"timerSeconds":180,"activeMeasureSummary":"digestive biscuits, butter","creatorSecret":"Prep and measure digestive biscuits first—mise en place makes this dessert twice as fast."},{"stepNumber":2,"phaseLabel":"Build Flavor","title":"Cream Butter & Sugar Fluffy","instructionTemplate":"Cream together the butter and sugar until light and fluffy. You can do this in a food processor if you have one. Process for 2-3 minutes. Mix in the eggs, then add the ground almonds and almond extract and blend until well combined. Peel the apples, and cut thin slices of apple. Do this at the last minute to prevent the apple going brown. Arrange the slices over the biscuit base. Spread the frangipane filling evenly on top. Level the surface and sprinkle with the flaked almonds. Incorporate {m52768_5}, {m52768_6}, {m52768_7}, {m52768_8}, and {m52768_9} smoothly until evenly distributed.","durationMin":3,"timerSeconds":180,"activeMeasureSummary":"Bramley apples, Salted Butter"},{"stepNumber":3,"phaseLabel":"Shape & Layer","title":"Bake Until Golden & Set","instructionTemplate":"Bake for 20-25 minutes until golden-brown and set. Remove from the oven and leave to cool for 15 minutes. Remove the sides of the tin. An easy way to do this is to stand the tin on a can of beans and push down gently on the edges of the tin.","durationMin":3,"timerSeconds":180,"activeMeasureSummary":"caster sugar, free-range eggs, beaten"},{"stepNumber":4,"phaseLabel":"Bake / Chill","title":"Cream Butter & Sugar Fluffy","instructionTemplate":"Transfer the tart, with the tin base attached, to a serving plate. Serve warm with cream, crème fraiche or ice cream. Let Apple Frangipan Tart cool for 10–15 minutes so the crumb sets cleanly before slicing into 6 portions, then garnish and serve.","durationMin":30,"timerSeconds":1800,"activeMeasureSummary":"ground almonds, almond extract","criticalTip":"Let set for 5–10 minutes before slicing or plating so the textures hold crisp and photogenic!","creatorSecret":"Chill the filled crust 10 minutes before baking—cold butter hits the hot oven and puffs into extra-flaky layers."}],"ugcQuotes":[{"id":"muq-52768","handle":"@baker_apple-fr","image":"./ai-images/apple-frangipan-tart.jpg","quote":"Followed the scaled metric steps—came out flawless in 45 mins!","rating":5}]}}]
