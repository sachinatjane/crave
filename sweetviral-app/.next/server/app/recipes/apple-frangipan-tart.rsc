10:T1257,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/apple-frangipan-tart/","name":"Apple Frangipan Tart","image":["https://crave.devyy.com/ai-images/apple-frangipan-tart.jpg","https://crave.devyy.com/ai-images/apple-frangipan-tart.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"British-inspired apple frangipan tart with 9 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (6 servings). 4.7★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"6 servings","recipeCategory":"Pies, Tarts & Crumbles","recipeCuisine":"British","keywords":"Apple Frangipan Tart, British, Pies, Tarts & Crumbles, #AppleFrangipa, #CraveMadeMeDoIt, #ViralDesserts, #BritishSweets","nutrition":{"@type":"NutritionInformation","calories":"422 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.7,"reviewCount":161},"recipeIngredient":["11.7 tbsp digestive biscuits","5 tbsp butter","0.89 cup Bramley apples","5 tbsp Salted Butter","5 tbsp caster sugar","2 whole free-range eggs, beaten","5 tbsp ground almonds","1 tsp almond extract","3.3 tbsp flaked almonds"],"recipeInstructions":[{"@type":"HowToStep","name":"Melt & Whisk Smooth","text":"Preheat the oven to 200C/180C Fan/Gas 6. Put the biscuits in a large re-sealable freezer bag and bash with a rolling pin into fine crumbs. Melt the butter in a small pan, then add the biscuit crumbs and stir until coated with butter. Tip into the tart tin and, using the back of a spoon, press over the base and sides of the tin to give an even layer. Chill in the fridge while you make the filling. Incorporate 11.7 tbsp digestive biscuits, 5 tbsp butter, 0.89 cup bramley apples, and 5 tbsp salted butter smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/apple-frangipan-tart/#step-1"},{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Cream together the butter and sugar until light and fluffy. You can do this in a food processor if you have one. Process for 2-3 minutes. Mix in the eggs, then add the ground almonds and almond extract and blend until well combined. Peel the apples, and cut thin slices of apple. Do this at the last minute to prevent the apple going brown. Arrange the slices over the biscuit base. Spread the frangipane filling evenly on top. Level the surface and sprinkle with the flaked almonds. Incorporate 5 tbsp caster sugar, 2 whole free-range eggs, beaten, 5 tbsp ground almonds, 1 tsp almond extract, and 3.3 tbsp flaked almonds smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/apple-frangipan-tart/#step-2"},{"@type":"HowToStep","name":"Bake Until Golden & Set","text":"Bake for 20-25 minutes until golden-brown and set. Remove from the oven and leave to cool for 15 minutes. Remove the sides of the tin. An easy way to do this is to stand the tin on a can of beans and push down gently on the edges of the tin.","url":"https://crave.devyy.com/recipes/apple-frangipan-tart/#step-3"},{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Transfer the tart, with the tin base attached, to a serving plate. Serve warm with cream, crème fraiche or ice cream. Let Apple Frangipan Tart cool for 10–15 minutes so the crumb sets cleanly before slicing into 6 portions, then garnish and serve.","url":"https://crave.devyy.com/recipes/apple-frangipan-tart/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Pies, Tarts & Crumbles","item":"https://crave.devyy.com/category/pies-tarts/"},{"@type":"ListItem","position":3,"name":"Apple Frangipan Tart","item":"https://crave.devyy.com/recipes/apple-frangipan-tart/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Apple Frangipan Tart?","acceptedAnswer":{"@type":"Answer","text":"Apple Frangipan Tart takes 45 minutes total (15 minutes prep) and yields 6 servings at 422 calories per serving."}},{"@type":"Question","name":"Can I make Apple Frangipan Tart healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Apple Frangipan Tart recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
