10:Tfac,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/bleskiver/","name":"Æbleskiver","image":["https://crave.devyy.com/ai-images/bleskiver.jpg","https://crave.devyy.com/ai-images/bleskiver.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Norway-inspired æbleskiver with 10 measured ingredients — zero sign-up, instant Cook Mode. Ready in 15 mins (4 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT0M","totalTime":"PT15M","recipeYield":"4 servings","recipeCategory":"Global Classics","recipeCuisine":"Norway","keywords":"Æbleskiver, Norway, Global Classics, #bleskiver, #CraveMadeMeDoIt, #ViralDesserts, #NorwaySweets","nutrition":{"@type":"NutritionInformation","calories":"219 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":215},"recipeIngredient":["2 cups Flour","1 tsp Salt","2 tbsp Granulated Sugar","1 tsp Baking Powder","0.5 tsp Cardamom","3 whole Egg","2 cups Buttermilk","1 for greasing Butter","1 sprinkling Powdered Sugar","1 scoop Raspberry Jam"],"recipeInstructions":[{"@type":"HowToStep","name":"Prep & Mix: Æbleskiver","text":"Whisk the flour, salt, sugar, baking soda, and cardamom together in a large bowl. Separate the eggs and add the egg yolks to the flour mixture. Pour in the buttermilk (or cultured milk) and whisk the batter together until smooth. Cover and refrigerate for about 30 minutes. Incorporate 2 cups flour, 1 tsp salt, 2 tbsp granulated sugar, and 1 tsp baking powder smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/bleskiver/#step-1"},{"@type":"HowToStep","name":"Build Flavor: Æbleskiver","text":"Use a hand (or stand) mixer to beat the egg whites until stiff. Carefully fold into the æbleskiver batter. Heat the pan on medium heat. Once hot, brush the pan with butter and fill each æbleskive hole almost full with the batter. Incorporate 0.5 tsp cardamom smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/bleskiver/#step-2"},{"@type":"HowToStep","name":"Shape & Layer: Æbleskiver","text":"Once the edges become firm use a knitting needle or wooden skewer to turn the æbleskiver about 1/4. Continue turning until you get round pancake spheres. They should be golden brown. Remove the æbleskiver from the pan and serve with powdered sugar and jam.","url":"https://crave.devyy.com/recipes/bleskiver/#step-3"},{"@type":"HowToStep","name":"Cool 1 Minute on Rack & Plate","text":"Transfer Æbleskiver onto a wire rack for 60 seconds so steam escapes and the outside stays crisp. Top with 3 whole egg, 2 cups buttermilk, 1 for greasing butter, 1 sprinkling powdered sugar, and 1 scoop raspberry jam and serve immediately into 4 portions.","url":"https://crave.devyy.com/recipes/bleskiver/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"Æbleskiver","item":"https://crave.devyy.com/recipes/bleskiver/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Æbleskiver?","acceptedAnswer":{"@type":"Answer","text":"Æbleskiver takes 15 minutes total (15 minutes prep) and yields 4 servings at 219 calories per serving."}},{"@type":"Question","name":"Can I make Æbleskiver healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Æbleskiver recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}