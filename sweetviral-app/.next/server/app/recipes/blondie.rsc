10:Tebc,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/blondie/","name":"Blondie","image":["https://crave.devyy.com/ai-images/blondie.jpg","https://crave.devyy.com/ai-images/blondie.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_us_eu"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Fudgy, glossy dark chocolate decadence with an ultra-rich melt-in-your-mouth center. Ready in 32 mins (9 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT10M","cookTime":"PT22M","totalTime":"PT32M","recipeYield":"9 servings","recipeCategory":"Chocolate & Brownies","recipeCuisine":"American","keywords":"Blondie, American, Chocolate & Brownies, #Blondie, #CraveMadeMeDoIt, #ViralDesserts, #AmericanSweets","nutrition":{"@type":"NutritionInformation","calories":"320 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":205},"recipeIngredient":["1.5 cups 70% dark chocolate & Dutch cocoa","0.5 cup Unsalted butter","1 cup Powdered or brown sugar","1 cup All-purpose flour + cocoa + 2 eggs"],"recipeInstructions":[{"@type":"HowToStep","name":"Preheat Oven & Prep Your Pan","text":"Preheat your oven to 350°F (175°C) and line your baking pan with parchment paper, leaving a slight overhang for effortless lifting. Measure out 1.5 cups 70% dark chocolate & dutch cocoa and 0.5 cup unsalted butter so everything is ready and at room temperature for a silky, lump-free batter.","url":"https://crave.devyy.com/recipes/blondie/#step-1"},{"@type":"HowToStep","name":"Melt & Whisk Shiny Batter","text":"Melt 1.5 cups 70% dark chocolate & dutch cocoa and 0.5 cup unsalted butter together, whisk in 1 cup powdered or brown sugar, then fold in 1 cup all-purpose flour + cocoa + 2 eggs until glossy. Stir gently over low to medium-low heat until completely dissolved and glossy, scraping the sides so nothing crystallizes or scorches.","url":"https://crave.devyy.com/recipes/blondie/#step-2"},{"@type":"HowToStep","name":"Bake Until Crinkly Top & Fudgy Center","text":"Bake at 350°F (175°C) for 22 minutes until shiny crackle top forms and center stays fudgy. Let Blondie cool for 10–15 minutes so the crumb sets cleanly before slicing into 9 portions, then garnish and serve.","url":"https://crave.devyy.com/recipes/blondie/#step-3"},{"@type":"HowToStep","name":"Cool Completely, Garnish & Serve","text":"Transfer Blondie to a wire cooling rack and let it cool for 15–20 minutes so the interior sets cleanly without crumbling. Lift out using the parchment overhang, garnish as desired, and slice into 9 portions.","url":"https://crave.devyy.com/recipes/blondie/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Chocolate & Brownies","item":"https://crave.devyy.com/category/chocolate-brownies/"},{"@type":"ListItem","position":3,"name":"Blondie","item":"https://crave.devyy.com/recipes/blondie/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Blondie?","acceptedAnswer":{"@type":"Answer","text":"Blondie takes 32 minutes total (10 minutes prep) and yields 9 servings at 320 calories per serving."}},{"@type":"Question","name":"Can I make Blondie healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Blondie recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
