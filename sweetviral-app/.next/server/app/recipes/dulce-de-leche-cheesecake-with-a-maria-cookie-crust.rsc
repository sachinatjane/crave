10:T1390,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/dulce-de-leche-cheesecake-with-a-maria-cookie-crust/","name":"Dulce de Leche Cheesecake with a Maria Cookie Crust.","image":["https://crave.devyy.com/ai-images/dulce-de-leche-cheesecake-with-a-maria-cookie-crust.jpg","https://crave.devyy.com/ai-images/dulce-de-leche-cheesecake-with-a-maria-cookie-crust.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Global-inspired dulce de leche cheesecake with a maria cookie crust. with 8 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (6 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"6 servings","recipeCategory":"Cheesecake & Tiramisu","recipeCuisine":"Global","keywords":"Dulce de Leche Cheesecake with a Maria Cookie Crust., Global, Cheesecake & Tiramisu, #Dulcede, #CraveMadeMeDoIt, #ViralDesserts, #GlobalSweets","nutrition":{"@type":"NutritionInformation","calories":"274 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":176},"recipeIngredient":["7 oz Maria Cookies","0.5 cup Unsalted Butter","16 oz Cream Cheese","16 oz Cream Cheese","1 can Sweetened Condensed Milk","4 whole Eggs","1 tbsp Vanilla Extract","1 garnish Dulce de leche"],"recipeInstructions":[{"@type":"HowToStep","name":"Bake Until Golden & Set","text":"Heat oven to 325ºF. Place cookies in bowl of food processor. Pulse 30 seconds, or until finely ground. (Or, crush them by hand by placing cookies in zip-top bag and using the bottom of a heavy skillet, pound cookies until finely crushed); transfer cookie crumbs to bowl. Add softened butter, stirring until combined. Transfer cookie mixture to 9” spring form pan. Using your fingers, press cookie crumbs evenly onto bottom and sides of pan. Bake until firm and fragrant, about 10 minutes. Incorporate 7 oz maria cookies, 0.5 cup unsalted butter, 16 oz cream cheese, and 16 oz cream cheese smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/dulce-de-leche-cheesecake-with-a-maria-cookie-crust/#step-1"},{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Set electric mixer on medium speed, beat cream cheese until fluffy, about 3 minutes. Add condensed milk; beat until smooth, 1 minute. Beat in eggs, vanilla and 3 tbsp. dulce de leche (caramel) until combined, 3 minutes. Pour filling into prepared crust. Bake until golden brown and set, but still a little wiggly in the middle, 45 – 55 minutes. Incorporate 1 can sweetened condensed milk, 4 whole eggs, 1 tbsp vanilla extract, and 1 garnish dulce de leche smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/dulce-de-leche-cheesecake-with-a-maria-cookie-crust/#step-2"},{"@type":"HowToStep","name":"Portion, Shape & Layer Evenly","text":"Turn off oven; partially open oven door. Let cheesecake sit in oven until it come to room temperature, about 1 hour. Transfer cheesecake to refrigerator; cool completely, at least 4 hours. Remove cooled cheesecake from sprigform pan.","url":"https://crave.devyy.com/recipes/dulce-de-leche-cheesecake-with-a-maria-cookie-crust/#step-3"},{"@type":"HowToStep","name":"Cool, Garnish & Serve","text":"Place remaining dulce de leche in ziplock bag. Using scissors, snip small hole in corner of bag. Applying even pressure on “pastry bag,” paint stripes on your finished cheesecake.","url":"https://crave.devyy.com/recipes/dulce-de-leche-cheesecake-with-a-maria-cookie-crust/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Cheesecake & Tiramisu","item":"https://crave.devyy.com/category/cheesecake-tiramisu/"},{"@type":"ListItem","position":3,"name":"Dulce de Leche Cheesecake with a Maria Cookie Crust.","item":"https://crave.devyy.com/recipes/dulce-de-leche-cheesecake-with-a-maria-cookie-crust/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Dulce de Leche Cheesecake with a Maria Cookie Crust.?","acceptedAnswer":{"@type":"Answer","text":"Dulce de Leche Cheesecake with a Maria Cookie Crust. takes 45 minutes total (15 minutes prep) and yields 6 servings at 274 calories per serving."}},{"@type":"Question","name":"Can I make Dulce de Leche Cheesecake with a Maria Cookie Crust. healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Dulce de Leche Cheesecake with a Maria Cookie Crust. recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
