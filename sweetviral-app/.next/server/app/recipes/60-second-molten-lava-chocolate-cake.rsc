10:T1017,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/60-second-molten-lava-chocolate-cake/","name":"60-Second Molten Lava Chocolate Cake","image":["https://crave.devyy.com/ai-images/60-second-molten-lava-chocolate-cake.jpg","https://crave.devyy.com/ai-images/60-second-molten-lava-chocolate-cake.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_kitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Crisp dark chocolate cake exterior that erupts with warm liquid ganache on the first forkful. Ready in 17 mins (2 servings). 5.0★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT6M","cookTime":"PT11M","totalTime":"PT17M","recipeYield":"2 servings","recipeCategory":"Chocolate & Brownies","recipeCuisine":"French","keywords":"60-Second Molten Lava Chocolate Cake, French, Chocolate & Brownies, #LavaCake, #CraveMadeMeDoIt, #ViralDesserts, #FrenchSweets","nutrition":{"@type":"NutritionInformation","calories":"410 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":5,"reviewCount":207},"recipeIngredient":["4 oz 70% dark chocolate + 4 tbsp butter","2 pcs Large egg + 1 egg yolk","0.33 cup Powdered sugar","2 tbsp All-purpose flour"],"recipeInstructions":[{"@type":"HowToStep","name":"Preheat Oven & Prep Your Pan","text":"Preheat your oven to 350°F (175°C) and line your baking pan with parchment paper, leaving a slight overhang for effortless lifting. Measure out 4 oz 70% dark chocolate + 4 tbsp butter and 2 pcs large egg + 1 egg yolk so everything is ready and at room temperature for a silky, lump-free batter.","url":"https://crave.devyy.com/recipes/60-second-molten-lava-chocolate-cake/#step-1"},{"@type":"HowToStep","name":"Whisk Glossy Lava Batter","text":"Melt 4 oz 70% dark chocolate + 4 tbsp butter until glossy. Whisk 2 pcs large egg + 1 egg yolk and 0.33 cup powdered sugar pale, then fold in chocolate and 2 tbsp all-purpose flour. Stir gently over low to medium-low heat until completely dissolved and glossy, scraping the sides so nothing crystallizes or scorches.","url":"https://crave.devyy.com/recipes/60-second-molten-lava-chocolate-cake/#step-2"},{"@type":"HowToStep","name":"Bake 11 Mins & Flip Warm","text":"Bake at 425°F (220°C) for 11 minutes until sides are firm and centers still soft. Rest 1 minute, invert onto plates, and break open!","url":"https://crave.devyy.com/recipes/60-second-molten-lava-chocolate-cake/#step-3"},{"@type":"HowToStep","name":"Cool Completely, Garnish & Serve","text":"Transfer 60-Second Molten Lava Chocolate Cake to a wire cooling rack and let it cool for 15–20 minutes so the interior sets cleanly without crumbling. Lift out using the parchment overhang, garnish as desired, and slice into 2 portions.","url":"https://crave.devyy.com/recipes/60-second-molten-lava-chocolate-cake/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Chocolate & Brownies","item":"https://crave.devyy.com/category/chocolate-brownies/"},{"@type":"ListItem","position":3,"name":"60-Second Molten Lava Chocolate Cake","item":"https://crave.devyy.com/recipes/60-second-molten-lava-chocolate-cake/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make 60-Second Molten Lava Chocolate Cake?","acceptedAnswer":{"@type":"Answer","text":"60-Second Molten Lava Chocolate Cake takes 17 minutes total (6 minutes prep) and yields 2 servings at 410 calories per serving."}},{"@type":"Question","name":"Can I make 60-Second Molten Lava Chocolate Cake healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this 60-Second Molten Lava Chocolate Cake recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
