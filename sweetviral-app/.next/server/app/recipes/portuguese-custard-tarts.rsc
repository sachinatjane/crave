10:T12d7,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/portuguese-custard-tarts/","name":"Portuguese custard tarts","image":["https://crave.devyy.com/ai-images/portuguese-custard-tarts.jpg","https://crave.devyy.com/ai-images/portuguese-custard-tarts.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Portuguese-inspired portuguese custard tarts with 12 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (6 servings). 4.8★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"6 servings","recipeCategory":"Pies, Tarts & Crumbles","recipeCuisine":"Portuguese","keywords":"Portuguese custard tarts, Portuguese, Pies, Tarts & Crumbles, #Portuguesecus, #CraveMadeMeDoIt, #ViralDesserts, #PortugueseSweets","nutrition":{"@type":"NutritionInformation","calories":"207 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":137},"recipeIngredient":["2 tbs Plain Flour","2 tbs Icing Sugar","1.67 cup Puff Pastry","1.11 cup Caster Sugar","2 strips Lemon Zest","1 stick Cinnamon","2 whole Eggs","4 whole Egg Yolks","3.3 tbsp Corn Flour","2.08 cup Whole Milk","1 pod of Vanilla","1 to serve Cinnamon"],"recipeInstructions":[{"@type":"HowToStep","name":"Shape & Press Dough Evenly","text":"Mix the flour and icing sugar, and use this to dust the work surface. Roll the pastry out to make a 45 x 30cm rectangle. Roll up lengthways to create a long sausage shape. Cutting pastry into rounds Cut the pastry into 24 wheels, about 1-2cm thick. Roll out each pastry portion. Incorporate 2 tbs plain flour, 2 tbs icing sugar, 1.67 cup puff pastry, and 1.11 cup caster sugar smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/portuguese-custard-tarts/#step-1"},{"@type":"HowToStep","name":"Shape & Press Dough Evenly","text":"Roll each wheel lightly with the rolling pin to fit 2 x 12-hole non-stick fairy cake tins. Press pastry into the tin Press the pastry circles into the tins and mould into the tins to make thin cases. Chill until needed. Make the infused syrup. Incorporate 2 strips lemon zest, 1 stick cinnamon, 2 whole eggs, 4 whole egg yolks, 3.3 tbsp corn flour, 2.08 cup whole milk, 1 pod of vanilla, and 1 to serve cinnamon smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/portuguese-custard-tarts/#step-2"},{"@type":"HowToStep","name":"Simmer & Dissolve Smoothly","text":"Heat the oven to 220C/fan 200C/gas 7. Make a sugar syrup by bringing the sugar, 200ml water, lemon zest and cinnamon stick to the boil. Reduce until syrupy, allow to cool, then remove the cinnamon and lemon. Whisk the eggs, egg yolks and cornflour until smooth in another large pan. Heat the milk and vanilla pod seeds in a separate pan until just below the boil. Gradually pour the hot milk over the eggs and cornflour, then cook on a low heat, continually whisking. Add syrup to custard Add the cooled sugar syrup to the custard and whisk until thickened slightly.","url":"https://crave.devyy.com/recipes/portuguese-custard-tarts/#step-3"},{"@type":"HowToStep","name":"Sift & Whisk Dry Ingredients","text":"Pour custard into the tins Pour the custard through a sieve. Pour into the pastry cases and bake for 15 minutes until the pastry is golden and the custard has darkened. cool and dust with icing sugar Cool completely in the tins then sift over icing sugar and ground cinnamon to serve.","url":"https://crave.devyy.com/recipes/portuguese-custard-tarts/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Pies, Tarts & Crumbles","item":"https://crave.devyy.com/category/pies-tarts/"},{"@type":"ListItem","position":3,"name":"Portuguese custard tarts","item":"https://crave.devyy.com/recipes/portuguese-custard-tarts/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Portuguese custard tarts?","acceptedAnswer":{"@type":"Answer","text":"Portuguese custard tarts takes 45 minutes total (15 minutes prep) and yields 6 servings at 207 calories per serving."}},{"@type":"Question","name":"Can I make Portuguese custard tarts healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Portuguese custard tarts recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
