10:T1191,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/dutch-doughnuts/","name":"Dutch doughnuts","image":["https://crave.devyy.com/ai-images/dutch-doughnuts.jpg","https://crave.devyy.com/ai-images/dutch-doughnuts.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Global-inspired dutch doughnuts with 5 measured ingredients — zero sign-up, instant Cook Mode. Ready in 26 mins (4 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT8M","cookTime":"PT18M","totalTime":"PT26M","recipeYield":"4 servings","recipeCategory":"Pastries & Donuts","recipeCuisine":"Global","keywords":"Dutch doughnuts, Global, Pastries & Donuts, #Dutchdoughnut, #CraveMadeMeDoIt, #ViralDesserts, #GlobalSweets","nutrition":{"@type":"NutritionInformation","calories":"247 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":142},"recipeIngredient":["2.22 cup Flour","2.08 cup Milk","2 tsp Instant Yeast","2 tsp Salt","0.9 oz Sugar"],"recipeInstructions":[{"@type":"HowToStep","name":"Prep & Mix: Dutch doughnuts","text":"Place the flour in a large bowl and add the yeast and sugar. If the milk is cold make sure to heat it to lukewarm. Mix your flour mixture bit by bit with the milk until you have a smooth batter. Add the salt and mix with a wooden spoon till the batter is smooth and liquidy. Incorporate 2.22 cup flour, 2.08 cup milk, 2 tsp instant yeast, and 2 tsp salt smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/dutch-doughnuts/#step-1"},{"@type":"HowToStep","name":"Fold In Flavorings & Mix-Ins","text":"Cover with a clean tea towel and leave in a warm spot for about an hour to rise. Combine until completely smooth, uniform, and free of lumps before moving to the next stage. Incorporate 0.9 oz sugar smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/dutch-doughnuts/#step-2"},{"@type":"HowToStep","name":"Portion, Shape & Layer Evenly","text":"Heat your deep fryer or add the oil to a large pot. The oil should be a t 180˚C (350˚F) for best results. Combine until completely smooth, uniform, and free of lumps before moving to the next stage.","url":"https://crave.devyy.com/recipes/dutch-doughnuts/#step-3"},{"@type":"HowToStep","name":"Dip & Coat Evenly","text":"Before starting stir your batter through and scoop the batter with two spoons or with an ice cream scoop. Let it drop into the oil carefully. It is easiest to do this if you dip your spoons or scoop into the oil before dipping into the batter. That way it will slide of the spoons easily. Don't over crowd the fryer to prevent the oil cooling down too quickly and everything sticking together. Once one side is golden brown it usually turns around to the other side automatically. If not help it along with two forks.","url":"https://crave.devyy.com/recipes/dutch-doughnuts/#step-4"},{"@type":"HowToStep","name":"Drain Crisp, Garnish & Serve Warm","text":"Take the balls out once golden brown and leave to drain on a piece of kitchen paper. Drain briefly on a wire cooling rack lined with paper towels for 1–2 minutes so the outside stays shatteringly crisp, then plate into 4 servings and enjoy warm.","url":"https://crave.devyy.com/recipes/dutch-doughnuts/#step-5"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Pastries & Donuts","item":"https://crave.devyy.com/category/pastries-donuts/"},{"@type":"ListItem","position":3,"name":"Dutch doughnuts","item":"https://crave.devyy.com/recipes/dutch-doughnuts/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Dutch doughnuts?","acceptedAnswer":{"@type":"Answer","text":"Dutch doughnuts takes 26 minutes total (8 minutes prep) and yields 4 servings at 247 calories per serving."}},{"@type":"Question","name":"Can I make Dutch doughnuts healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Dutch doughnuts recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
