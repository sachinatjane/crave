12:["$","$L13",null,{"initialRecipeSlug":"french-mille-feuille-napoleon-pastry","initialRecipe":{"id":"viral-25","slug":"french-mille-feuille-napoleon-pastry","title":"French Mille-Feuille Napoleon Pastry","shortTag":"Mille-Feuille","storyViews":"236K","viewsLabel":"236K Views","viewsNumeric":236,"remakeSuccessRate":"96.8%","rating":4.8,"ratingCount":"348","prepMin":15,"bakeMin":20,"totalMin":35,"skill":"Medium","baseServings":6,"kcal":365,"zeroMixer":true,"cuisine":"French","dessertCategory":"pastries-donuts","primaryPlatform":"pinterest","platforms":["facebook","instagram","pinterest"],"categories":["all"],"soundName":"flaky crunch asmr","badgeChip":"1000 Layers","creatorHandle":"@crave_kitchen","hookLine":"Caramelized crisp puff pastry slabs stacked with silky vanilla diplomat pastry cream.","heroImage":"./ai-images/french-mille-feuille-napoleon-pastry.jpg","thumbImage":"./ai-images/french-mille-feuille-napoleon-pastry.jpg","pinterestImage":"./ai-images/french-mille-feuille-napoleon-pastry.jpg","hashtags":["#MilleFeuille","#CraveMadeMeDoIt","#ViralDesserts","#FrenchSweets"],"pantryCore":["flour","milk"],"ingredientGroups":[{"title":"Caramel Puff & Diplomat","badge":"Bakery Classic","tone":"tertiary","items":[{"id":"puff_mf","name":"All-butter puff pastry sheets (dusted with icing sugar)","baseAmount":2,"usUnit":"sheets","metricAmount":500,"metricUnit":"g","pantryKey":"flour","stepRef":1},{"id":"cream_mf","name":"Vanilla pastry cream folded with whipped cream","baseAmount":2,"usUnit":"cups","metricAmount":450,"metricUnit":"g","pantryKey":"milk","stepRef":2}]}],"steps":[{"stepNumber":1,"phaseLabel":"Heat Oil","title":"Heat Oil & Prep Cooling Rack","instructionTemplate":"Pour neutral frying oil into a heavy pot to 2 inches deep and heat steadily to 350°F (175°C). Set a wire cooling rack over paper towels nearby and measure out {puff_mf} so everything is ready to fry cleanly.","durationMin":6,"timerSeconds":360,"activeMeasureSummary":"350°F (175°C) Oil • Wire Rack"},{"stepNumber":2,"phaseLabel":"Press & Caramelize","title":"Bake Puff Under Second Tray","instructionTemplate":"Prick {puff_mf} with a fork, dust with icing sugar, cover with parchment + a second baking sheet to keep flat, and bake at 400°F (205°C) for 20 mins.","durationMin":20,"timerSeconds":1200,"activeMeasureSummary":"400°F Weighted Bake","creatorSecret":"Weighting the pastry between two trays keeps the layers thin, even, and extra shattering."},{"stepNumber":3,"phaseLabel":"Pipe & Stack","title":"Pipe Cream Between Crisp Slabs","instructionTemplate":"Slice into rectangles and pipe neat pearls of {cream_mf} between three crisp layers. Drain briefly on a wire cooling rack lined with paper towels for 1–2 minutes so the outside stays shatteringly crisp, then plate into 6 servings and enjoy warm.","durationMin":10,"timerSeconds":600,"activeMeasureSummary":"Pipe Fresh","creatorSecret":"Glaze or toss in sugar while still warm so the coating melts lightly and clings to every ridge."},{"stepNumber":4,"phaseLabel":"Drain & Coat","title":"Drain Crisp, Toss & Serve Fresh","instructionTemplate":"Transfer to the wire rack to drain excess oil for 1–2 minutes while still piping hot, then finish with {cream_mf}. Serve French Mille-Feuille Napoleon Pastry fresh while the exterior is shatteringly crisp.","durationMin":3,"timerSeconds":180,"activeMeasureSummary":"Crisp Drain • 6 Servings"}],"ugcQuotes":[{"id":"uq-24","handle":"@homebaker_joy","image":"./ai-images/french-mille-feuille-napoleon-pastry.jpg","quote":"Turned out bakery-grade on my first try! Ready in 35 mins.","rating":5}]}}]
