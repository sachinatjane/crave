10:T102b,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/french-mille-feuille-napoleon-pastry/","name":"French Mille-Feuille Napoleon Pastry","image":["https://crave.devyy.com/ai-images/french-mille-feuille-napoleon-pastry.jpg","https://crave.devyy.com/ai-images/french-mille-feuille-napoleon-pastry.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_kitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Caramelized crisp puff pastry slabs stacked with silky vanilla diplomat pastry cream. Ready in 35 mins (6 servings). 4.8★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT20M","totalTime":"PT35M","recipeYield":"6 servings","recipeCategory":"Pastries & Donuts","recipeCuisine":"French","keywords":"French Mille-Feuille Napoleon Pastry, French, Pastries & Donuts, #MilleFeuille, #CraveMadeMeDoIt, #ViralDesserts, #FrenchSweets","nutrition":{"@type":"NutritionInformation","calories":"365 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":348},"recipeIngredient":["2 sheets All-butter puff pastry sheets (dusted with icing sugar)","2 cups Vanilla pastry cream folded with whipped cream"],"recipeInstructions":[{"@type":"HowToStep","name":"Heat Oil & Prep Cooling Rack","text":"Pour neutral frying oil into a heavy pot to 2 inches deep and heat steadily to 350°F (175°C). Set a wire cooling rack over paper towels nearby and measure out 2 sheets all-butter puff pastry sheets (dusted with icing sugar) so everything is ready to fry cleanly.","url":"https://crave.devyy.com/recipes/french-mille-feuille-napoleon-pastry/#step-1"},{"@type":"HowToStep","name":"Bake Puff Under Second Tray","text":"Prick 2 sheets all-butter puff pastry sheets (dusted with icing sugar) with a fork, dust with icing sugar, cover with parchment + a second baking sheet to keep flat, and bake at 400°F (205°C) for 20 mins.","url":"https://crave.devyy.com/recipes/french-mille-feuille-napoleon-pastry/#step-2"},{"@type":"HowToStep","name":"Pipe Cream Between Crisp Slabs","text":"Slice into rectangles and pipe neat pearls of 2 cups vanilla pastry cream folded with whipped cream between three crisp layers. Drain briefly on a wire cooling rack lined with paper towels for 1–2 minutes so the outside stays shatteringly crisp, then plate into 6 servings and enjoy warm.","url":"https://crave.devyy.com/recipes/french-mille-feuille-napoleon-pastry/#step-3"},{"@type":"HowToStep","name":"Drain Crisp, Toss & Serve Fresh","text":"Transfer to the wire rack to drain excess oil for 1–2 minutes while still piping hot, then finish with 2 cups vanilla pastry cream folded with whipped cream. Serve French Mille-Feuille Napoleon Pastry fresh while the exterior is shatteringly crisp.","url":"https://crave.devyy.com/recipes/french-mille-feuille-napoleon-pastry/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Pastries & Donuts","item":"https://crave.devyy.com/category/pastries-donuts/"},{"@type":"ListItem","position":3,"name":"French Mille-Feuille Napoleon Pastry","item":"https://crave.devyy.com/recipes/french-mille-feuille-napoleon-pastry/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make French Mille-Feuille Napoleon Pastry?","acceptedAnswer":{"@type":"Answer","text":"French Mille-Feuille Napoleon Pastry takes 35 minutes total (15 minutes prep) and yields 6 servings at 365 calories per serving."}},{"@type":"Question","name":"Can I make French Mille-Feuille Napoleon Pastry healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this French Mille-Feuille Napoleon Pastry recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
