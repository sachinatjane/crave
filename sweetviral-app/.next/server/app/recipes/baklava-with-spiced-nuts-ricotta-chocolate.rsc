10:T18ce,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/baklava-with-spiced-nuts-ricotta-chocolate/","name":"Baklava with spiced nuts, ricotta & chocolate","image":["https://crave.devyy.com/ai-images/baklava-with-spiced-nuts-ricotta-chocolate.jpg","https://crave.devyy.com/ai-images/baklava-with-spiced-nuts-ricotta-chocolate.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Turkish-inspired baklava with spiced nuts, ricotta & chocolate with 14 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (4 servings). 4.8★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"4 servings","recipeCategory":"Chocolate & Brownies","recipeCuisine":"Turkish","keywords":"Baklava with spiced nuts, ricotta & chocolate, Turkish, Chocolate & Brownies, #Baklavawith, #CraveMadeMeDoIt, #ViralDesserts, #TurkishSweets","nutrition":{"@type":"NutritionInformation","calories":"342 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":171},"recipeIngredient":["2.22 cup Sugar","1 to taste Lemon Juice","1.33 cup Walnuts","0.89 cup Pecan Nuts","6.7 tbsp Almonds","2 tbsp Ground Cinnamon","1 tbsp Ground Cardomom","2.22 cup Ricotta","1 zest of 1 Lemon","1 zest of 1 Orange","1 tbsp Vanilla Bean Paste","1.11 cup Unsalted Butter","2.22 cup Filo Pastry","6.7 tbsp Ground Pistachios"],"recipeInstructions":[{"@type":"HowToStep","name":"Melt & Whisk Smooth","text":"First, make the syrup. Tip the sugar into a large saucepan with 650ml water. Stir over a low heat until the sugar has dissolved, then turn up the heat and bring to the boil. Reduce the heat to a simmer and cook for 15 mins, then squeeze in a few drops of lemon juice and simmer for a further 5 mins. Remove from the heat and leave to cool. Meanwhile, for assembling the baklava later, melt the butter in a small pan over a low heat for 5 mins, skimming and discarding any froth that rises to the surface. Incorporate 2.22 cup sugar, 1 to taste lemon juice, 1.33 cup walnuts, and 0.89 cup pecan nuts smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/baklava-with-spiced-nuts-ricotta-chocolate/#step-1"},{"@type":"HowToStep","name":"Fold In Flavorings & Mix-Ins","text":"For the filling, crush all of the nuts in a pestle and mortar, or blitz in a food processor – you want a mixture of finely ground nuts with a few chunky pieces. Tip into a bowl, stir through the spices and set aside. Incorporate 6.7 tbsp almonds, 2 tbsp ground cinnamon, 1 tbsp ground cardomom, 2.22 cup ricotta, 1 zest of 1 lemon, 1 zest of 1 orange, 1 tbsp vanilla bean paste, 1.11 cup unsalted butter, 2.22 cup filo pastry, and 6.7 tbsp ground pistachios smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/baklava-with-spiced-nuts-ricotta-chocolate/#step-2"},{"@type":"HowToStep","name":"Shape & Press Dough Evenly","text":"In a separate bowl, mix the ricotta with the lemon and orange zests and vanilla. Heat the oven to 180C/160C fan/gas 4. Brush the bottom of a large baking tray (about 35 x 47cm) with some of the melted butter. Working with one sheet of filo at a time (covering the rest with a damp tea towel to prevent it drying out), lay the sheet out on a board so one of the short ends is facing you. Sprinkle 30g of the nut mixture evenly over the whole sheet, then spoon 1 tbsp of the ricotta mixture across the end closest to you. Fold this end over to enclose the filling, then lay a long, thin skewer next to the folded edge and roll the pastry around it to create a long roll. When it’s fully rolled up, it should be roughly the thickness of a chipolata sausage. While holding one end of the rolling pin or skewer, gently scrunch the filo roll like an accordion and carefully push it off the skewer and onto the prepared tray. Repeat with the rest of the filo and fillings – you should get about 12 rolls. Cut each roll into four to make 48 large baklava, or eight to make 96 mini.","url":"https://crave.devyy.com/recipes/baklava-with-spiced-nuts-ricotta-chocolate/#step-3"},{"@type":"HowToStep","name":"Bake Until Golden & Set","text":"Brush with the remaining melted butter. Bake for 20-25 mins until evenly golden, turning the tray around halfway through. While still hot, immediately pour over 5-6 ladlefuls of the syrup. You should hear the syrup sizzle as it hits the hot baklava. Set aside to cool and absorb.","url":"https://crave.devyy.com/recipes/baklava-with-spiced-nuts-ricotta-chocolate/#step-4"},{"@type":"HowToStep","name":"Melt & Whisk Smooth","text":"Melt the dark chocolate in a heatproof bowl set over a pan of simmering water, ensuring the bowl doesn’t touch the water, or in the microwave in short bursts. Drizzle this over the cooled baklava and sprinkle with the ground pistachios.","url":"https://crave.devyy.com/recipes/baklava-with-spiced-nuts-ricotta-chocolate/#step-5"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Chocolate & Brownies","item":"https://crave.devyy.com/category/chocolate-brownies/"},{"@type":"ListItem","position":3,"name":"Baklava with spiced nuts, ricotta & chocolate","item":"https://crave.devyy.com/recipes/baklava-with-spiced-nuts-ricotta-chocolate/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Baklava with spiced nuts, ricotta & chocolate?","acceptedAnswer":{"@type":"Answer","text":"Baklava with spiced nuts, ricotta & chocolate takes 45 minutes total (15 minutes prep) and yields 4 servings at 342 calories per serving."}},{"@type":"Question","name":"Can I make Baklava with spiced nuts, ricotta & chocolate healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Baklava with spiced nuts, ricotta & chocolate recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
