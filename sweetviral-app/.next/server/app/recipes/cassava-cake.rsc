10:T1076,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/cassava-cake/","name":"Cassava Cake","image":["https://crave.devyy.com/ai-images/cassava-cake.jpg","https://crave.devyy.com/ai-images/cassava-cake.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Global-inspired cassava cake with 6 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (6 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"6 servings","recipeCategory":"Cakes & Mug Cakes","recipeCuisine":"Global","keywords":"Cassava Cake, Global, Cakes & Mug Cakes, #CassavaCake, #CraveMadeMeDoIt, #ViralDesserts, #GlobalSweets","nutrition":{"@type":"NutritionInformation","calories":"206 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":244},"recipeIngredient":["2 lb Cassava","1 lb Dark Brown Soft Sugar","1 can Coconut Milk","0.25 portion Nutmeg","0.5 tsp Allspice","0.5 tsp Cinnamon"],"recipeInstructions":[{"@type":"HowToStep","name":"Prep & Mix: Cassava Cake","text":"Bring coconut milk to a boil. Add sugar, stirring until completely dissolved and continue to boil for about 45 minutes. Stir gently over low to medium-low heat until completely dissolved and glossy, scraping the sides so nothing crystallizes or scorches. Incorporate 2 lb cassava, 1 lb dark brown soft sugar, 1 can coconut milk, and 0.25 portion nutmeg smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/cassava-cake/#step-1"},{"@type":"HowToStep","name":"Build Flavor: Cassava Cake","text":"Reserve ½ cup of the coconut milk/sugar mixture for later. Combine remaining ingredients in a large mixing bowl, stir until well blended. Incorporate 0.5 tsp allspice and 0.5 tsp cinnamon smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/cassava-cake/#step-2"},{"@type":"HowToStep","name":"Shape & Layer: Cassava Cake","text":"Add hot coconut milk mixture and stir well. Mixture should be of a thick liquid texture. Mix gently until just combined with no dry streaks remaining, then bake until the edges are golden and a toothpick comes out with moist crumbs.","url":"https://crave.devyy.com/recipes/cassava-cake/#step-3"},{"@type":"HowToStep","name":"Bake / Chill: Cassava Cake","text":"Use 1 tablespoons of coconut milk mixture to grease baking pan. Pour batter into prepared baking pan and bake at 350°F (basting occasionally with reserved coconut milk mixture) for 2 to 3 hours or until knife inserted in centre comes out clean.","url":"https://crave.devyy.com/recipes/cassava-cake/#step-4"},{"@type":"HowToStep","name":"Viral Finish: Cassava Cake","text":"Spread any remaining coconut milk mixture over top of cake. Place cake on top of stove to cool completely. Let Cassava Cake cool for 10–15 minutes so the crumb sets cleanly before slicing into 6 portions, then garnish and serve.","url":"https://crave.devyy.com/recipes/cassava-cake/#step-5"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Cakes & Mug Cakes","item":"https://crave.devyy.com/category/cakes-cupcakes/"},{"@type":"ListItem","position":3,"name":"Cassava Cake","item":"https://crave.devyy.com/recipes/cassava-cake/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Cassava Cake?","acceptedAnswer":{"@type":"Answer","text":"Cassava Cake takes 45 minutes total (15 minutes prep) and yields 6 servings at 206 calories per serving."}},{"@type":"Question","name":"Can I make Cassava Cake healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Cassava Cake recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
