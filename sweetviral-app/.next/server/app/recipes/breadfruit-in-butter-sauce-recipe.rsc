11:["$","noscript",null,{"children":["$","article",null,{"children":[["$","h1",null,{"children":"Breadfruit in Butter Sauce Recipe"}],["$","p",null,{"children":"Global-inspired breadfruit in butter sauce recipe with 14 measured ingredients — zero sign-up, instant Cook Mode. Ready in 15 mins (4 servings). 4.8★ rated with US/Metric scaling & hands-free Cook Mode."}],["$","h2",null,{"children":"Ingredients"}],["$","ul",null,{"children":[["$","li","0",{"children":"0.5 portion Breadfruit"}],["$","li","1",{"children":"0.5 portion Onion"}],["$","li","2",{"children":"1 tbsp Olive Oil"}],["$","li","3",{"children":"8.3 tbsp Butter"}],["$","li","4",{"children":"3 whole Onion"}],["$","li","5",{"children":"1 tbsp Garlic"}],["$","li","6",{"children":"2.08 cup Tinned Tomatos"}],["$","li","7",{"children":"3 tbsp Parsley"}],["$","li","8",{"children":"1 tbsp Lime juice"}],["$","li","9",{"children":"1 to taste Salt"}],["$","li","10",{"children":"1 to taste Pepper"}],["$","li","11",{"children":"1.04 cup Water"}],["$","li","12",{"children":"1 to taste Red Pepper Paste"}],["$","li","13",{"children":"1 garnish Parsley"}]]}],["$","h2",null,{"children":"Step-by-Step Instructions"}],["$","ol",null,{"children":[["$","li","1",{"children":[["$","h3",null,{"children":"Whisk & Combine Base Ingredients"}],["$","p",null,{"children":"Captain William Bligh was chosen to lead an expedition to the South Seas to bring the breadfruit to the Caribbean. His devotion to the breadfruit saplings and neglect of his crew’s water needs lead to the famous “Mutiny on the Bounty” on his first attempt. Cast overboard; Captain Bligh made his way hundreds of miles to safety in an open boat. On his second attempt in 1793, he sailed into Jamaica’s Port Royal Harbour with a ship so crowded with beautiful leafy breadfruit saplings that the Jamaicans rowed out toward “the ship that has bush.” Today large, lush breadfruit trees grow throughout the Caribbean, bearing the football-like starchy staple that has kept hunger away from many a door. Breadfruit may be difficult to find outside the Caribbean. You will need the following ingredients:. Incorporate 0.5 portion breadfruit, 0.5 portion onion, 1 tbsp olive oil, and 8.3 tbsp butter smoothly until evenly distributed."}]]}],["$","li","2",{"children":[["$","h3",null,{"children":"Fold In Flavorings & Mix-Ins"}],["$","p",null,{"children":"1/2 medium breadfruit 1 tablespoon olive oil 3 medium onions, cut into rings 1 tablespoon garlic finely chopped 1 medium 16floz/500ml tin whole tomatoes, drained and sliced. Incorporate 3 whole onion, 1 tbsp garlic, 2.08 cup tinned tomatos, 3 tbsp parsley, 1 tbsp lime juice, 1 to taste salt, 1 to taste pepper, 1.04 cup water, 1 to taste red pepper paste, and 1 garnish parsley smoothly until evenly distributed."}]]}],["$","li","3",{"children":[["$","h3",null,{"children":"Portion, Shape & Layer Evenly"}],["$","p",null,{"children":"1/4 cup or 3 tablespoons parsley, diced 1 tablespoon lime juice Salt and pepper to taste 1 cup 8oz or 250ml water Red pepper sauce to taste."}]]}],["$","li","4",{"children":[["$","h3",null,{"children":"Melt & Whisk Smooth"}],["$","p",null,{"children":"Garnish: fresh parsley, chopped. Cut the breadfruit, remove the seeds in the core, and peel. Boil in salted water with a little onion and oil, over high heat until tender and drain. Meanwhile, melt the butter in a frying pan and lightly brown the onion rings. Add the garlic, tomatoes, parsley, lime juice, salt, and pepper. Continue to sauté for a couple of minutes. Add the water, bring to the boil and simmer for 5-10 minutes. Slice the cooled breadfruit and place it in a serving dish. Pour the butter sauce over the breadfruit. Garnish with chopped fresh parsley."}]]}]]}],"$L13"]}]}]
