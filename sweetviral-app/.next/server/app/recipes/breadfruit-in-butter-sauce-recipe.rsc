10:T14c6,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/breadfruit-in-butter-sauce-recipe/","name":"Breadfruit in Butter Sauce Recipe","image":["https://crave.devyy.com/ai-images/breadfruit-in-butter-sauce-recipe.jpg","https://crave.devyy.com/ai-images/breadfruit-in-butter-sauce-recipe.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Global-inspired breadfruit in butter sauce recipe with 14 measured ingredients — zero sign-up, instant Cook Mode. Ready in 15 mins (4 servings). 4.8★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT0M","totalTime":"PT15M","recipeYield":"4 servings","recipeCategory":"Global Classics","recipeCuisine":"Global","keywords":"Breadfruit in Butter Sauce Recipe, Global, Global Classics, #Breadfruitin, #CraveMadeMeDoIt, #ViralDesserts, #GlobalSweets","nutrition":{"@type":"NutritionInformation","calories":"243 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":230},"recipeIngredient":["0.5 portion Breadfruit","0.5 portion Onion","1 tbsp Olive Oil","8.3 tbsp Butter","3 whole Onion","1 tbsp Garlic","2.08 cup Tinned Tomatos","3 tbsp Parsley","1 tbsp Lime juice","1 to taste Salt","1 to taste Pepper","1.04 cup Water","1 to taste Red Pepper Paste","1 garnish Parsley"],"recipeInstructions":[{"@type":"HowToStep","name":"Whisk & Combine Base Ingredients","text":"Captain William Bligh was chosen to lead an expedition to the South Seas to bring the breadfruit to the Caribbean. His devotion to the breadfruit saplings and neglect of his crew’s water needs lead to the famous “Mutiny on the Bounty” on his first attempt. Cast overboard; Captain Bligh made his way hundreds of miles to safety in an open boat. On his second attempt in 1793, he sailed into Jamaica’s Port Royal Harbour with a ship so crowded with beautiful leafy breadfruit saplings that the Jamaicans rowed out toward “the ship that has bush.” Today large, lush breadfruit trees grow throughout the Caribbean, bearing the football-like starchy staple that has kept hunger away from many a door. Breadfruit may be difficult to find outside the Caribbean. You will need the following ingredients:. Incorporate 0.5 portion breadfruit, 0.5 portion onion, 1 tbsp olive oil, and 8.3 tbsp butter smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/breadfruit-in-butter-sauce-recipe/#step-1"},{"@type":"HowToStep","name":"Fold In Flavorings & Mix-Ins","text":"1/2 medium breadfruit 1 tablespoon olive oil 3 medium onions, cut into rings 1 tablespoon garlic finely chopped 1 medium 16floz/500ml tin whole tomatoes, drained and sliced. Incorporate 3 whole onion, 1 tbsp garlic, 2.08 cup tinned tomatos, 3 tbsp parsley, 1 tbsp lime juice, 1 to taste salt, 1 to taste pepper, 1.04 cup water, 1 to taste red pepper paste, and 1 garnish parsley smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/breadfruit-in-butter-sauce-recipe/#step-2"},{"@type":"HowToStep","name":"Portion, Shape & Layer Evenly","text":"1/4 cup or 3 tablespoons parsley, diced 1 tablespoon lime juice Salt and pepper to taste 1 cup 8oz or 250ml water Red pepper sauce to taste.","url":"https://crave.devyy.com/recipes/breadfruit-in-butter-sauce-recipe/#step-3"},{"@type":"HowToStep","name":"Melt & Whisk Smooth","text":"Garnish: fresh parsley, chopped. Cut the breadfruit, remove the seeds in the core, and peel. Boil in salted water with a little onion and oil, over high heat until tender and drain. Meanwhile, melt the butter in a frying pan and lightly brown the onion rings. Add the garlic, tomatoes, parsley, lime juice, salt, and pepper. Continue to sauté for a couple of minutes. Add the water, bring to the boil and simmer for 5-10 minutes. Slice the cooled breadfruit and place it in a serving dish. Pour the butter sauce over the breadfruit. Garnish with chopped fresh parsley.","url":"https://crave.devyy.com/recipes/breadfruit-in-butter-sauce-recipe/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"Breadfruit in Butter Sauce Recipe","item":"https://crave.devyy.com/recipes/breadfruit-in-butter-sauce-recipe/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Breadfruit in Butter Sauce Recipe?","acceptedAnswer":{"@type":"Answer","text":"Breadfruit in Butter Sauce Recipe takes 15 minutes total (15 minutes prep) and yields 4 servings at 243 calories per serving."}},{"@type":"Question","name":"Can I make Breadfruit in Butter Sauce Recipe healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Breadfruit in Butter Sauce Recipe recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
