10:T1461,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/ensaimada/","name":"Ensaimada","image":["https://crave.devyy.com/ai-images/ensaimada.jpg","https://crave.devyy.com/ai-images/ensaimada.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Spanish-inspired ensaimada with 6 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (4 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"4 servings","recipeCategory":"Global Classics","recipeCuisine":"Spanish","keywords":"Ensaimada, Spanish, Global Classics, #Ensaimada, #CraveMadeMeDoIt, #ViralDesserts, #SpanishSweets","nutrition":{"@type":"NutritionInformation","calories":"418 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":202},"recipeIngredient":["1 tsp Yeast","0.89 cup Caster Sugar","2 pcs Egg","2.67 cup Strong white bread flour","1 drizzle Vegetable Oil","6.7 tbsp Lard"],"recipeInstructions":[{"@type":"HowToStep","name":"Prep & Mix: Ensaimada","text":"Pour 230ml lukewarm water into a bowl and add the yeast. Leave to stand for 3 mins, then add the caster sugar, eggs, flour and 1 tsp sea salt flakes. Mix together to form a dough, then knead for 10 mins in stand mixer using a dough hook (or 15 mins by hand) until the dough is elastic enough to be almost see-through when stretched. Cover and set aside to rest for 30 mins, then cut into four equal pieces. Transfer to a baking tray lined with baking parchment. Leave to rest for another 30 mins. Incorporate 1 tsp yeast, 0.89 cup caster sugar, 2 pcs egg, and 2.67 cup strong white bread flour smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/ensaimada/#step-1"},{"@type":"HowToStep","name":"Build Flavor: Ensaimada","text":"Oil the work surface and a rolling pin with vegetable oil. Working with one portion of dough at a time, flatten it against the surface using the palm of your hand, then roll it out into a thin rectangle, about 30 x 50cm. Let it rest for 2 mins while you spread a quarter of the lard over the top. (If you want to fill your pastry with sobrasada de Mallorca, mix 50g lard with the sobrasada, and spread this over the dough instead.) Pull one corner of the flattened dough and stretch it out as far as it will go without breaking. Repeat every 10cm or so around the dough rectangle in every direction until it reaches about 50 x 70cm. Incorporate 1 drizzle vegetable oil and 6.7 tbsp lard smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/ensaimada/#step-2"},{"@type":"HowToStep","name":"Shape & Layer: Ensaimada","text":"Cut a strip from each of the shorter sides and lay these beside each other along one of the longer sides of the rectangle; this is what we call the heart of the ensaimada. From there, begin rolling the dough until you have a long pastry snake. Repeat with the remaining portions of dough.","url":"https://crave.devyy.com/recipes/ensaimada/#step-3"},{"@type":"HowToStep","name":"Bake / Chill: Ensaimada","text":"Take the first roll of dough and stretch it until it is over a metre long. Then, roll it up into a spiral, leaving 1cm between each turn of the spiral so the dough can expand. Flatten a little and transfer to a baking sheet lined with baking parchment. Repeat with the remaining dough. Leave to rise in a warm place for at least 12 hrs, or ideally 24 hrs.","url":"https://crave.devyy.com/recipes/ensaimada/#step-4"},{"@type":"HowToStep","name":"Viral Finish: Ensaimada","text":"Heat the oven to 200C/180C fan/gas 6. Put the ensaimadas in the top third of the oven and immediately reduce the temperature to 180C/160C fan/gas 4. Bake for 18 mins until dark golden. Leave to cool on a wire rack. To fill your ensaimada with whipped cream, slice and open, then spread over the cream and close. Dust with a generous amount of icing sugar, if you like and cut into pieces to serve.","url":"https://crave.devyy.com/recipes/ensaimada/#step-5"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"Ensaimada","item":"https://crave.devyy.com/recipes/ensaimada/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Ensaimada?","acceptedAnswer":{"@type":"Answer","text":"Ensaimada takes 45 minutes total (15 minutes prep) and yields 4 servings at 418 calories per serving."}},{"@type":"Question","name":"Can I make Ensaimada healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Ensaimada recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
