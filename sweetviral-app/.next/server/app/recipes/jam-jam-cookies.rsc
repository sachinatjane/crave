10:T1086,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/jam-jam-cookies/","name":"Jam jam cookies","image":["https://crave.devyy.com/ai-images/jam-jam-cookies.jpg","https://crave.devyy.com/ai-images/jam-jam-cookies.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Canadian-inspired jam jam cookies with 12 measured ingredients — zero sign-up, instant Cook Mode. Ready in 33 mins (12 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT18M","totalTime":"PT33M","recipeYield":"12 servings","recipeCategory":"Cookies & Bars","recipeCuisine":"Canadian","keywords":"Jam jam cookies, Canadian, Cookies & Bars, #Jamjam, #CraveMadeMeDoIt, #ViralDesserts, #CanadianSweets","nutrition":{"@type":"NutritionInformation","calories":"331 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":199},"recipeIngredient":["1 whole Egg","1 cup Butter","1 cup Sugar","0.5 cup Molasses","1 tsp Vanilla","2 tsp Baking Powder","3 tbsp Water","2 tbsp Baking Powder","1 tsp Cinnamon","2 tsp Salt","4 cups Flour","2 cups Jam"],"recipeInstructions":[{"@type":"HowToStep","name":"Prep & Mix: Jam jam cookies","text":"Preheat the oven to 350 °F (180 °C) and line a large baking sheet with parchment paper. In a stand mixer with the paddle attachment, cream the butter, white sugar and egg until combined, then add the molasses and vanilla and mix until smooth. Incorporate 1 whole egg, 1 cup butter, 1 cup sugar, and 0.5 cup molasses smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/jam-jam-cookies/#step-1"},{"@type":"HowToStep","name":"Sift & Whisk Dry Ingredients","text":"Once combined, add the baking soda water mixture and mix for another minute to combine. Combine dry ingredients; mix baking powder, cinnamon, flour and salt in a separate bowl then add to the wet ingredients a little at a time, mixing on low until fully combined and scraping down the sides to ensure everything is incorporated. The dough should be easily shaped. Incorporate 1 tsp vanilla, 2 tsp baking powder, 3 tbsp water, 2 tbsp baking powder, 1 tsp cinnamon, 2 tsp salt, 4 cups flour, and 2 cups jam smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/jam-jam-cookies/#step-2"},{"@type":"HowToStep","name":"Shape & Press Dough Evenly","text":"Portion dough with a small spoon, roll them into balls and place them on the lined cookie sheet, press them into flat discs using a floured glass or your moistened palm. Place cookies on parchment-lined baking sheets and bake for 10-12 mins. Remove from the oven and let them cool for at least 10 minutes.","url":"https://crave.devyy.com/recipes/jam-jam-cookies/#step-3"},{"@type":"HowToStep","name":"Cool, Garnish & Serve","text":"Once cooled the cookie sandwiches by spreading at least two teaspoons of your favourite jam between the two cookies. Repeat and enjoy with a cup of tea.","url":"https://crave.devyy.com/recipes/jam-jam-cookies/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Cookies & Bars","item":"https://crave.devyy.com/category/cookies-bars/"},{"@type":"ListItem","position":3,"name":"Jam jam cookies","item":"https://crave.devyy.com/recipes/jam-jam-cookies/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Jam jam cookies?","acceptedAnswer":{"@type":"Answer","text":"Jam jam cookies takes 33 minutes total (15 minutes prep) and yields 12 servings at 331 calories per serving."}},{"@type":"Question","name":"Can I make Jam jam cookies healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Jam jam cookies recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
