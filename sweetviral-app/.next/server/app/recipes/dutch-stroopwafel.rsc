10:T11f8,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/dutch-stroopwafel/","name":"Dutch stroopwafel","image":["https://crave.devyy.com/ai-images/dutch-stroopwafel.jpg","https://crave.devyy.com/ai-images/dutch-stroopwafel.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Netherlands-inspired dutch stroopwafel with 11 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (4 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"4 servings","recipeCategory":"Global Classics","recipeCuisine":"Netherlands","keywords":"Dutch stroopwafel, Netherlands, Global Classics, #Dutchstroopwa, #CraveMadeMeDoIt, #ViralDesserts, #NetherlandsSweets","nutrition":{"@type":"NutritionInformation","calories":"395 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":230},"recipeIngredient":["1 tbsp Milk","2 tsp Instant Yeast","1.11 cup All purpose flour","8 tbsp Unsalted Butter","5.3 tbsp Sugar","1 whole Egg","1 pinch Salt","0.89 cup Dutch Stroop","8 tbsp Brown Sugar","5.3 tbsp Unsalted Butter","1 tsp Cinnamon"],"recipeInstructions":[{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Combine milk and yeast in a bowl. Let stand for a moment to allow the yeast to dissolve. In another bowl, combine flour, butter, sugar, egg, and salt. Pour in the yeast mixture and knead until smooth. Cover the bowl and let the dough rise for one hour. Incorporate 1 tbsp milk, 2 tsp instant yeast, 1.11 cup all purpose flour, and 8 tbsp unsalted butter smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/dutch-stroopwafel/#step-1"},{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"When the dough is almost ready, make the stroop filling. Combine all the ingredients in a saucepan and stir until the butter is melted and the sugar is dissolved. Let it simmer for a while. The stroop will continue to thicken as it cools. Shape the dough into balls weighing about 35 grams each. Make a total of 14. Turn your stroopwafel iron on the highest setting. Incorporate 5.3 tbsp sugar, 1 whole egg, 1 pinch salt, 0.89 cup dutch stroop, 8 tbsp brown sugar, 5.3 tbsp unsalted butter, and 1 tsp cinnamon smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/dutch-stroopwafel/#step-2"},{"@type":"HowToStep","name":"Shape & Press Dough Evenly","text":"Place a ball of dough in the iron and close the iron. Don’t flatten the waffle too much; you should still be able to cut through it. Bake for 1-2 minutes until the waffle is nicely golden brown. When the waffle is done, work quickly. Remove the waffle from the iron and immediately use a round cutter to cut out a nice circle of about 8 to 9 cm (3 to 3.5 inches).","url":"https://crave.devyy.com/recipes/dutch-stroopwafel/#step-3"},{"@type":"HowToStep","name":"Cook on Hot Iron Until Crisp","text":"Place the hot waffle on a cutting board and cut horizontally with a sharp knife. The stroopwafel is very hot, so use an oven mitt to hold it in place. Take half a waffle and spread the (hot!) stroop on it. Place the other half on top, pressing gently if necessary, and place the waffle on a wire rack to cool. Repeat for all the balls.","url":"https://crave.devyy.com/recipes/dutch-stroopwafel/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"Dutch stroopwafel","item":"https://crave.devyy.com/recipes/dutch-stroopwafel/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Dutch stroopwafel?","acceptedAnswer":{"@type":"Answer","text":"Dutch stroopwafel takes 45 minutes total (15 minutes prep) and yields 4 servings at 395 calories per serving."}},{"@type":"Question","name":"Can I make Dutch stroopwafel healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Dutch stroopwafel recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
