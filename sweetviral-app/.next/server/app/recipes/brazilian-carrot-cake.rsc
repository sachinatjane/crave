10:T1120,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/brazilian-carrot-cake/","name":"Brazilian carrot cake","image":["https://crave.devyy.com/ai-images/brazilian-carrot-cake.jpg","https://crave.devyy.com/ai-images/brazilian-carrot-cake.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Global-inspired brazilian carrot cake with 9 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (6 servings). 4.8★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"6 servings","recipeCategory":"Cakes & Mug Cakes","recipeCuisine":"Global","keywords":"Brazilian carrot cake, Global, Cakes & Mug Cakes, #Braziliancarr, #CraveMadeMeDoIt, #ViralDesserts, #GlobalSweets","nutrition":{"@type":"NutritionInformation","calories":"365 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":195},"recipeIngredient":["1.04 cup Vegetable Oil","1.16 cup Plain Flour","1.78 cup Caster Sugar","1 tsp Baking Powder","2 pcs Carrots","2 whole Eggs","1.04 cup Milk","1.1 oz Cocoa Powder","4 tbsp Caster Sugar"],"recipeInstructions":[{"@type":"HowToStep","name":"Whisk & Combine Base Ingredients","text":"Heat the oven to 180C/160C fan/ gas 4. Oil and line the base of a 20cm springform cake tin. Mix the flour, sugar and baking powder together in a large bowl and set aside. Tip the oil, carrots and eggs in a blender and blitz until smooth. Pour the wet ingredients into the dry, stirring until smooth. Incorporate 1.04 cup vegetable oil, 1.16 cup plain flour, 1.78 cup caster sugar, and 1 tsp baking powder smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/brazilian-carrot-cake/#step-1"},{"@type":"HowToStep","name":"Bake Until Golden & Set","text":"Pour the batter into the cake tin and give it a shake to get rid of air bubbles. Bake for 45 mins to 1 hr, until a clean knife or skewer inserted into the middle comes out clean. If the middle is sticky, put back in the oven for a further 5 mins. Remove from the oven and leave to cool in the tin. Incorporate 2 pcs carrots, 2 whole eggs, 1.04 cup milk, 1.1 oz cocoa powder, and 4 tbsp caster sugar smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/brazilian-carrot-cake/#step-2"},{"@type":"HowToStep","name":"Portion, Shape & Layer Evenly","text":"For the drizzle, heat the milk, cocoa and sugar in a saucepan over a low heat. Stir until the sugar dissolves (about 5 mins), creating a thick, shiny drizzle.","url":"https://crave.devyy.com/recipes/brazilian-carrot-cake/#step-3"},{"@type":"HowToStep","name":"Cool, Garnish & Serve","text":"Remove the cake from the tin and level the top using a serrated knife, then flip so the bottom becomes the top. Pierce all over using a knife or toothpick and put on a wire rack with a tray or large bowl underneath. Pour the drizzle over the cake in batches until it’s all absorbed. You can reuse any drizzle caught in the tray or bowl. Most of the drizzle should be absorbed.","url":"https://crave.devyy.com/recipes/brazilian-carrot-cake/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Cakes & Mug Cakes","item":"https://crave.devyy.com/category/cakes-cupcakes/"},{"@type":"ListItem","position":3,"name":"Brazilian carrot cake","item":"https://crave.devyy.com/recipes/brazilian-carrot-cake/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Brazilian carrot cake?","acceptedAnswer":{"@type":"Answer","text":"Brazilian carrot cake takes 45 minutes total (15 minutes prep) and yields 6 servings at 365 calories per serving."}},{"@type":"Question","name":"Can I make Brazilian carrot cake healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Brazilian carrot cake recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
