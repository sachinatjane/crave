10:T1812,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/kv-fjord-cake-verdens-beste-world-s-best-cake/","name":"Kvæfjord Cake “Verdens Beste” (World’s Best Cake)","image":["https://crave.devyy.com/ai-images/kv-fjord-cake-verdens-beste-world-s-best-cake.jpg","https://crave.devyy.com/ai-images/kv-fjord-cake-verdens-beste-world-s-best-cake.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Norway-inspired kvæfjord cake “verdens beste” (world’s best cake) with 16 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (6 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"6 servings","recipeCategory":"Cakes & Mug Cakes","recipeCuisine":"Norway","keywords":"Kvæfjord Cake “Verdens Beste” (World’s Best Cake), Norway, Cakes & Mug Cakes, #KvfjordCake, #CraveMadeMeDoIt, #ViralDesserts, #NorwaySweets","nutrition":{"@type":"NutritionInformation","calories":"327 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":241},"recipeIngredient":["2 pcs Egg Yolks","2 tbsp Cornstarch","0.25 cup Granulated Sugar","0.6666666666666666 cup Heavy Cream","0.75 cup Milk","1 whole vanilla pod","0.6666666666666666 cup Butter","0.75 cup Granulated Sugar","5 pcs Egg Yolks","1.25 cups Flour","1.5 tsp Baking Powder","0.5 cup Milk","7 whole Egg White","1.5 cups Granulated Sugar","1 sliced Almonds","1.25 cups Whipping Cream"],"recipeInstructions":[{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Separate the egg yolks and set aside the whites to use in the meringue. Whisk together the egg yolks, cornstarch and sugar in a bowl. Heat the cream and milk in a saucepan. Split open the vanilla pod and add the beans to the saucepan. Once the milk begins to bubble pour about half of it into the bowl with the egg mixture, whisking constantly. Then return the saucepan to the heat and pour the egg mixture back into the saucepan with remaining milk, whisking constantly. Once the mixture thickens lower the heat and continue whisking for about 30 seconds. Pour the custard into a clean bowl and cover with plastic wrap, placing the plastic directly on the top layer of the custard. Chill in the fridge. Incorporate 2 pcs egg yolks, 2 tbsp cornstarch, 0.25 cup granulated sugar, and 0.6666666666666666 cup heavy cream smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/kv-fjord-cake-verdens-beste-world-s-best-cake/#step-1"},{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Mix together butter and sugar until light and fluffy. Add egg yolks one at a time, setting aside the egg whites for the meringue. Add the flour mixed with baking powder. Stir in the milk, beating until smooth (you can use an electric mixer if you prefer). Preheat oven to 320°F (160°C). Cover a baking sheet with baking paper and spread out the batter into a large, even rectangle. Whisk together the egg whites and sugar until you get glossy, stiff peaks. The meringue should hold its form – if it still melts continue whisking. Spread out the meringue on top of the cake batter. Use a spatula to form light waves with the meringue. Sprinkle almonds on top of the meringue. Bake for about 30 minutes, until the meringue and almonds are golden. Incorporate 0.75 cup milk, 1 whole vanilla pod, 0.6666666666666666 cup butter, 0.75 cup granulated sugar, 5 pcs egg yolks, 1.25 cups flour, 1.5 tsp baking powder, 0.5 cup milk, 7 whole egg white, 1.5 cups granulated sugar, 1 sliced almonds, and 1.25 cups whipping cream smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/kv-fjord-cake-verdens-beste-world-s-best-cake/#step-2"},{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Whisk the cream into stiff peaks. Carefully fold in the vanilla custard. Once the cake has cooled, cut it in half. You can use scissors for this, or a knife on a cutting board, slicing through the baking paper as well. Place half of the cake on a serving platter with the meringue side down and peel off the baking paper. Spread the cream filling across the cake. Then carefully remove the other half of the cake from the baking paper and place it over the cream filling, meringue side up.","url":"https://crave.devyy.com/recipes/kv-fjord-cake-verdens-beste-world-s-best-cake/#step-3"},{"@type":"HowToStep","name":"Cool, Garnish & Serve","text":"Serve with fresh berries. Plate into 6 generous servings while the flavors and textures are at their peak, and store any leftovers covered.","url":"https://crave.devyy.com/recipes/kv-fjord-cake-verdens-beste-world-s-best-cake/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Cakes & Mug Cakes","item":"https://crave.devyy.com/category/cakes-cupcakes/"},{"@type":"ListItem","position":3,"name":"Kvæfjord Cake “Verdens Beste” (World’s Best Cake)","item":"https://crave.devyy.com/recipes/kv-fjord-cake-verdens-beste-world-s-best-cake/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Kvæfjord Cake “Verdens Beste” (World’s Best Cake)?","acceptedAnswer":{"@type":"Answer","text":"Kvæfjord Cake “Verdens Beste” (World’s Best Cake) takes 45 minutes total (15 minutes prep) and yields 6 servings at 327 calories per serving."}},{"@type":"Question","name":"Can I make Kvæfjord Cake “Verdens Beste” (World’s Best Cake) healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Kvæfjord Cake “Verdens Beste” (World’s Best Cake) recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
