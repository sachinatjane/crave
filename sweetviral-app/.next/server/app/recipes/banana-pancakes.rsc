10:Tf44,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/banana-pancakes/","name":"Banana Pancakes","image":["https://crave.devyy.com/ai-images/banana-pancakes.jpg","https://crave.devyy.com/ai-images/banana-pancakes.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"United States-inspired banana pancakes with 7 measured ingredients — zero sign-up, instant Cook Mode. Ready in 15 mins (4 servings). 4.8★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT0M","totalTime":"PT15M","recipeYield":"4 servings","recipeCategory":"Pastries & Donuts","recipeCuisine":"United States","keywords":"Banana Pancakes, United States, Pastries & Donuts, #BananaPancake, #CraveMadeMeDoIt, #ViralDesserts, #UnitedSweets","nutrition":{"@type":"NutritionInformation","calories":"221 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":56},"recipeIngredient":["1 pc Banana","2 pcs Eggs","1 pinch Baking Powder","1 spinkling Vanilla Extract","1 tsp Oil","0.9 oz Pecan Nuts","8.3 tbsp Raspberries"],"recipeInstructions":[{"@type":"HowToStep","name":"Prep & Mix: Banana Pancakes","text":"In a bowl, mash the banana with a fork until it resembles a thick purée. Stir in the eggs, baking powder and vanilla. Keep 1 pc banana, 2 pcs eggs, 1 pinch baking powder, and 1 spinkling vanilla extract prepped and measured within reach so each step comes together smoothly and evenly.","url":"https://crave.devyy.com/recipes/banana-pancakes/#step-1"},{"@type":"HowToStep","name":"Combine Wet & Dry Smoothly","text":"Fold 1 tsp oil, 0.9 oz pecan nuts, and 8.3 tbsp raspberries into the base in two additions using gentle strokes until glossy and uniform with zero dry pockets. Avoid overmixing so the final texture stays light and tender.","url":"https://crave.devyy.com/recipes/banana-pancakes/#step-2"},{"@type":"HowToStep","name":"Drain Crisp, Garnish & Serve Warm","text":"Heat a large non-stick frying pan or pancake pan over a medium heat and brush with half the oil. Using half the batter, spoon two pancakes into the pan, cook for 1-2 mins each side, then tip onto a plate. Repeat the process with the remaining oil and batter. Top the pancakes with the pecans and raspberries.","url":"https://crave.devyy.com/recipes/banana-pancakes/#step-3"},{"@type":"HowToStep","name":"Drain Crisp, Toss & Serve Fresh","text":"Transfer to the wire rack to drain excess oil for 1–2 minutes while still piping hot, then finish with 1 tsp oil, 0.9 oz pecan nuts, and 8.3 tbsp raspberries. Serve Banana Pancakes fresh while the exterior is shatteringly crisp.","url":"https://crave.devyy.com/recipes/banana-pancakes/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Pastries & Donuts","item":"https://crave.devyy.com/category/pastries-donuts/"},{"@type":"ListItem","position":3,"name":"Banana Pancakes","item":"https://crave.devyy.com/recipes/banana-pancakes/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Banana Pancakes?","acceptedAnswer":{"@type":"Answer","text":"Banana Pancakes takes 15 minutes total (15 minutes prep) and yields 4 servings at 221 calories per serving."}},{"@type":"Question","name":"Can I make Banana Pancakes healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Banana Pancakes recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
