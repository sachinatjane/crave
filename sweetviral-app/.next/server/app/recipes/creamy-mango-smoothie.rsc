10:Te3d,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/creamy-mango-smoothie/","name":"Creamy mango smoothie","image":["https://crave.devyy.com/ai-images/creamy-mango-smoothie.jpg","https://crave.devyy.com/ai-images/creamy-mango-smoothie.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Global-inspired creamy mango smoothie with 4 measured ingredients — zero sign-up, instant Cook Mode. Ready in 8 mins (4 servings). 4.8★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT8M","cookTime":"PT0M","totalTime":"PT8M","recipeYield":"4 servings","recipeCategory":"Global Classics","recipeCuisine":"Global","keywords":"Creamy mango smoothie, Global, Global Classics, #Creamymango, #CraveMadeMeDoIt, #ViralDesserts, #GlobalSweets","nutrition":{"@type":"NutritionInformation","calories":"225 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":116},"recipeIngredient":["3 pcs Mango","1 tsp Vanilla Extract","0.5 cup Condensed Milk","1 large handful Ice Cubes"],"recipeInstructions":[{"@type":"HowToStep","name":"Preheat & Prep Your Pan","text":"Peel mangoes and slice Cut two of the mangoes into chunks. Line your chilling pan or tray with parchment paper for easy lifting, and keep 3 pcs mango, 1 tsp vanilla extract, 0.5 cup condensed milk, and 1 large handful ice cubes measured and ready to combine.","url":"https://crave.devyy.com/recipes/creamy-mango-smoothie/#step-1"},{"@type":"HowToStep","name":"Fold In Flavorings & Mix-Ins","text":"Blend all ingredients until smooth and creamy Cut two of the largest opposite slices. Combine until completely smooth, uniform, and free of lumps before moving to the next stage.","url":"https://crave.devyy.com/recipes/creamy-mango-smoothie/#step-2"},{"@type":"HowToStep","name":"Portion, Shape & Layer Evenly","text":"Lay them down on a cutting board Using a sharp knife, create small ¼ inch slices. Cut the mango slightly diagonally to get longer pieces.","url":"https://crave.devyy.com/recipes/creamy-mango-smoothie/#step-3"},{"@type":"HowToStep","name":"Chill Firm, Slice & Serve","text":"Create a circular bud with one slice, build around it with the other slices, placing them individually the previous row to take on the form of a rose. Repeat this until you've arrived at your desired size.","url":"https://crave.devyy.com/recipes/creamy-mango-smoothie/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"Creamy mango smoothie","item":"https://crave.devyy.com/recipes/creamy-mango-smoothie/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Creamy mango smoothie?","acceptedAnswer":{"@type":"Answer","text":"Creamy mango smoothie takes 8 minutes total (8 minutes prep) and yields 4 servings at 225 calories per serving."}},{"@type":"Question","name":"Can I make Creamy mango smoothie healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Creamy mango smoothie recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
