10:T111c,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/apple-blackberry-crumble/","name":"Apple & Blackberry Crumble","image":["https://crave.devyy.com/ai-images/apple-blackberry-crumble.jpg","https://crave.devyy.com/ai-images/apple-blackberry-crumble.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"British-inspired apple & blackberry crumble with 9 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (6 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"6 servings","recipeCategory":"Pies, Tarts & Crumbles","recipeCuisine":"British","keywords":"Apple & Blackberry Crumble, British, Pies, Tarts & Crumbles, #Apple, #CraveMadeMeDoIt, #ViralDesserts, #BritishSweets","nutrition":{"@type":"NutritionInformation","calories":"436 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":95},"recipeIngredient":["8 tbsp Plain Flour","4 tbsp Caster Sugar","4 tbsp Butter","1.33 cup Braeburn Apples","1.1 oz Butter","1.1 oz Demerara Sugar","8 tbsp Blackberries","1 tsp Cinnamon","1 to serve Ice Cream"],"recipeInstructions":[{"@type":"HowToStep","name":"Dip & Coat Evenly","text":"Heat oven to 190C/170C fan/gas 5. Tip the flour and sugar into a large bowl. Add the butter, then rub into the flour using your fingertips to make a light breadcrumb texture. Do not overwork it or the crumble will become heavy. Sprinkle the mixture evenly over a baking sheet and bake for 15 mins or until lightly coloured. Incorporate 8 tbsp plain flour, 4 tbsp caster sugar, 4 tbsp butter, and 1.33 cup braeburn apples smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/apple-blackberry-crumble/#step-1"},{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Meanwhile, for the compote, peel, core and cut the apples into 2cm dice. Put the butter and sugar in a medium saucepan and melt together over a medium heat. Cook for 3 mins until the mixture turns to a light caramel. Stir in the apples and cook for 3 mins. Add the blackberries and cinnamon, and cook for 3 mins more. Cover, remove from the heat, then leave for 2-3 mins to continue cooking in the warmth of the pan. Incorporate 1.1 oz butter smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/apple-blackberry-crumble/#step-2"},{"@type":"HowToStep","name":"Combine Wet & Dry Smoothly","text":"Fold 1.1 oz demerara sugar, 8 tbsp blackberries, 1 tsp cinnamon, and 1 to serve ice cream into the base in two additions using gentle strokes until glossy and uniform with zero dry pockets. Avoid overmixing so the final texture stays light and tender.","url":"https://crave.devyy.com/recipes/apple-blackberry-crumble/#step-3"},{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"To serve, spoon the warm fruit into an ovenproof gratin dish, top with the crumble mix, then reheat in the oven for 5-10 mins. Serve with vanilla ice cream.","url":"https://crave.devyy.com/recipes/apple-blackberry-crumble/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Pies, Tarts & Crumbles","item":"https://crave.devyy.com/category/pies-tarts/"},{"@type":"ListItem","position":3,"name":"Apple & Blackberry Crumble","item":"https://crave.devyy.com/recipes/apple-blackberry-crumble/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Apple & Blackberry Crumble?","acceptedAnswer":{"@type":"Answer","text":"Apple & Blackberry Crumble takes 45 minutes total (15 minutes prep) and yields 6 servings at 436 calories per serving."}},{"@type":"Question","name":"Can I make Apple & Blackberry Crumble healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Apple & Blackberry Crumble recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
