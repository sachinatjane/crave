10:T112c,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/arroz-con-leche-recipe/","name":"Arroz con Leche Recipe","image":["https://crave.devyy.com/ai-images/arroz-con-leche-recipe.jpg","https://crave.devyy.com/ai-images/arroz-con-leche-recipe.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Global-inspired arroz con leche recipe with 9 measured ingredients — zero sign-up, instant Cook Mode. Ready in 15 mins (4 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT0M","totalTime":"PT15M","recipeYield":"4 servings","recipeCategory":"Global Classics","recipeCuisine":"Global","keywords":"Arroz con Leche Recipe, Global, Global Classics, #Arrozcon, #CraveMadeMeDoIt, #ViralDesserts, #GlobalSweets","nutrition":{"@type":"NutritionInformation","calories":"358 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":226},"recipeIngredient":["1 cup Rice","4 whole Cinnamon Stick","2 cups Water","4 cups Milk","1 pinch Salt","2 tbsp Butter","2 tbsp Vanilla Extract","1 cup Sugar","12 oz Condensed Milk"],"recipeInstructions":[{"@type":"HowToStep","name":"Simmer & Dissolve Smoothly","text":"In a small pot, add water and cinnamon sticks, bring to a boil and cook for 10 minutes. Set aside and discard cinnamon sticks. Stir gently over low to medium-low heat until completely dissolved and glossy, scraping the sides so nothing crystallizes or scorches. Incorporate 1 cup rice, 4 whole cinnamon stick, 2 cups water, and 4 cups milk smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/arroz-con-leche-recipe/#step-1"},{"@type":"HowToStep","name":"Dip & Coat Evenly","text":"Place the rice and the cinnamon water in a large saucepan, over medium heat and cook for 5 minutes. Whisk steadily around the bottom and corners of the pan until glossy, thickened, and smooth enough to coat the back of a spoon. Incorporate 1 pinch salt, 2 tbsp butter, 2 tbsp vanilla extract, 1 cup sugar, and 12 oz condensed milk smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/arroz-con-leche-recipe/#step-2"},{"@type":"HowToStep","name":"Dip & Coat Evenly","text":"Add salt, butter, vanilla extract, 2 cups of milk, and sugar. Stir well to mix and cook uncovered for approximately 15 minutes. Whisk steadily around the bottom and corners of the pan until glossy, thickened, and smooth enough to coat the back of a spoon.","url":"https://crave.devyy.com/recipes/arroz-con-leche-recipe/#step-3"},{"@type":"HowToStep","name":"Bake Until Golden & Set","text":"Reduce heat to medium low. Add the remaining milk and condensed milk. Stir with a wooden spoon. Cook for 1 hour and 15 minutes, or until the rice pudding thickens to desire consistency.","url":"https://crave.devyy.com/recipes/arroz-con-leche-recipe/#step-4"},{"@type":"HowToStep","name":"Cool, Garnish & Serve","text":"Stir well and remove from heat, and let it cool at room temperature. The consistency should be very creamy. Refrigerate for a least 1 hour or overnight.","url":"https://crave.devyy.com/recipes/arroz-con-leche-recipe/#step-5"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"Arroz con Leche Recipe","item":"https://crave.devyy.com/recipes/arroz-con-leche-recipe/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Arroz con Leche Recipe?","acceptedAnswer":{"@type":"Answer","text":"Arroz con Leche Recipe takes 15 minutes total (15 minutes prep) and yields 4 servings at 358 calories per serving."}},{"@type":"Question","name":"Can I make Arroz con Leche Recipe healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Arroz con Leche Recipe recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
