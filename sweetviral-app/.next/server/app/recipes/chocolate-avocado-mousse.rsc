10:T1005,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/chocolate-avocado-mousse/","name":"Chocolate Avocado Mousse","image":["https://crave.devyy.com/ai-images/chocolate-avocado-mousse.jpg","https://crave.devyy.com/ai-images/chocolate-avocado-mousse.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"British-inspired chocolate avocado mousse with 8 measured ingredients — zero sign-up, instant Cook Mode. Ready in 15 mins (4 servings). 4.7★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT0M","totalTime":"PT15M","recipeYield":"4 servings","recipeCategory":"Chocolate & Brownies","recipeCuisine":"British","keywords":"Chocolate Avocado Mousse, British, Chocolate & Brownies, #ChocolateAvoc, #CraveMadeMeDoIt, #ViralDesserts, #BritishSweets","nutrition":{"@type":"NutritionInformation","calories":"231 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.7,"reviewCount":124},"recipeIngredient":["1 whole Banana","3 tbsp Cacao","1 whole Avocado","2 tbsp Honey","1 tsp Lemon Juice","1 tsp Vanilla","2 tbsp Water","1 pinch Sea Salt"],"recipeInstructions":[{"@type":"HowToStep","name":"Whisk & Combine Base Ingredients","text":"Blend all the mousse ingredients together in your food processor until smooth. Add the cacao powder first and, as you blend, have all the ingredients to hand in order to adjust the ratios slightly as the size of avocados and bananas varies so much. The perfect ratio in order to avoid the dish tasting too much of either is to use equal amounts of both. Incorporate 1 whole banana, 3 tbsp cacao, 1 whole avocado, and 2 tbsp honey smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/chocolate-avocado-mousse/#step-1"},{"@type":"HowToStep","name":"Fold In Flavorings & Mix-Ins","text":"Taste and add a few drops of stevia if you feel you need more sweetness. Combine until completely smooth, uniform, and free of lumps before moving to the next stage. Incorporate 1 tsp lemon juice, 1 tsp vanilla, 2 tbsp water, and 1 pinch sea salt smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/chocolate-avocado-mousse/#step-2"},{"@type":"HowToStep","name":"Chill Until Firmly Set","text":"Fill little cups or shot glasses with the mousse, sprinkle with the cacao powder or nibs and serve. Chill or freeze until completely firm and set, then portion into 4 servings and store leftovers in an airtight container.","url":"https://crave.devyy.com/recipes/chocolate-avocado-mousse/#step-3"},{"@type":"HowToStep","name":"Freeze Solid, Slice & Serve","text":"Tip If you don’t have a frozen banana to hand you can just use a normal one and then chill the mousse before serving for a cooling dessert.","url":"https://crave.devyy.com/recipes/chocolate-avocado-mousse/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Chocolate & Brownies","item":"https://crave.devyy.com/category/chocolate-brownies/"},{"@type":"ListItem","position":3,"name":"Chocolate Avocado Mousse","item":"https://crave.devyy.com/recipes/chocolate-avocado-mousse/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Chocolate Avocado Mousse?","acceptedAnswer":{"@type":"Answer","text":"Chocolate Avocado Mousse takes 15 minutes total (15 minutes prep) and yields 4 servings at 231 calories per serving."}},{"@type":"Question","name":"Can I make Chocolate Avocado Mousse healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Chocolate Avocado Mousse recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
