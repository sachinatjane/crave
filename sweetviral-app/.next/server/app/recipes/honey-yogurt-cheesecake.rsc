10:T11bc,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/honey-yogurt-cheesecake/","name":"Honey Yogurt Cheesecake","image":["https://crave.devyy.com/ai-images/honey-yogurt-cheesecake.jpg","https://crave.devyy.com/ai-images/honey-yogurt-cheesecake.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Greek-inspired honey yogurt cheesecake with 10 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (6 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"6 servings","recipeCategory":"Cheesecake & Tiramisu","recipeCuisine":"Greek","keywords":"Honey Yogurt Cheesecake, Greek, Cheesecake & Tiramisu, #HoneyYogurt, #CraveMadeMeDoIt, #ViralDesserts, #GreekSweets","nutrition":{"@type":"NutritionInformation","calories":"341 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":55},"recipeIngredient":["6.7 tbsp Digestive Biscuits","5.7 tbsp Almonds","5.7 tbsp Butter","1.04 cup Greek Yogurt","3.33 cup Mascarpone","2 whole Eggs","1 zest of 1 Lemon","1 zest of 1 Orange","1.04 cup Honey","1 to serve Fruit Mix"],"recipeInstructions":[{"@type":"HowToStep","name":"Bake Until Golden & Set","text":"Heat oven to 160C/140C fan/gas 3. Crush the biscuits and most of the almonds inside a plastic food bag using a rolling pin. Mix with the butter, then press into the bottom of a deep, oval, 23cm dish (or something similar in size – a roasting tin, baking dish or cake tin will work). Bake for 10 mins until crisp. Incorporate 6.7 tbsp digestive biscuits, 5.7 tbsp almonds, 5.7 tbsp butter, and 1.04 cup greek yogurt smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/honey-yogurt-cheesecake/#step-1"},{"@type":"HowToStep","name":"Fold In Flavorings & Mix-Ins","text":"Stir or mash together the yogurt and mascarpone, then whisk in the eggs, one at a time. Stir in the lemon and orange zests, then stir in most of the honey, reserving about 3 tbsp. Spread over the biscuit base, cover loosely with foil and cook for 1 hr. Remove the foil and cook for 15 mins more until lightly golden and the top is firm with just the slightest wobble in the middle. Leave to cool. Can be kept in the fridge for up to 2 days. Incorporate 3.33 cup mascarpone, 2 whole eggs, 1 zest of 1 lemon, 1 zest of 1 orange, 1.04 cup honey, and 1 to serve fruit mix smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/honey-yogurt-cheesecake/#step-2"},{"@type":"HowToStep","name":"Bake Honey Yogurt Cheesecake & Check Doneness","text":"Bake for 30 minutes until the edges turn golden and set while the center remains tender. Test with a toothpick—if it comes out with a few moist crumbs rather than wet batter, it is ready.","url":"https://crave.devyy.com/recipes/honey-yogurt-cheesecake/#step-3"},{"@type":"HowToStep","name":"Cool, Garnish & Serve","text":"To serve, scatter with almonds, drizzle over the remaining honey, and hand around fresh fruit to go with it. Let Honey Yogurt Cheesecake cool for 10–15 minutes so the crumb sets cleanly before slicing into 6 portions, then garnish and serve.","url":"https://crave.devyy.com/recipes/honey-yogurt-cheesecake/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Cheesecake & Tiramisu","item":"https://crave.devyy.com/category/cheesecake-tiramisu/"},{"@type":"ListItem","position":3,"name":"Honey Yogurt Cheesecake","item":"https://crave.devyy.com/recipes/honey-yogurt-cheesecake/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Honey Yogurt Cheesecake?","acceptedAnswer":{"@type":"Answer","text":"Honey Yogurt Cheesecake takes 45 minutes total (15 minutes prep) and yields 6 servings at 341 calories per serving."}},{"@type":"Question","name":"Can I make Honey Yogurt Cheesecake healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Honey Yogurt Cheesecake recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
