10:T11be,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/layered-mango-custard/","name":"Layered mango custard","image":["https://crave.devyy.com/ai-images/layered-mango-custard.jpg","https://crave.devyy.com/ai-images/layered-mango-custard.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Global-inspired layered mango custard with 11 measured ingredients — zero sign-up, instant Cook Mode. Ready in 15 mins (4 servings). 4.8★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT0M","totalTime":"PT15M","recipeYield":"4 servings","recipeCategory":"Puddings & Custards","recipeCuisine":"Global","keywords":"Layered mango custard, Global, Puddings & Custards, #Layeredmango, #CraveMadeMeDoIt, #ViralDesserts, #GlobalSweets","nutrition":{"@type":"NutritionInformation","calories":"197 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":95},"recipeIngredient":["1 tbsp Custard","3 cups Whipping Cream","3 cups Milk","0.3333333333333333 cup Sugar","6 tbsp Water","1 tbsp Vanilla Extract","1 garnish Mint","1 garnish Mango","1 topping Mango","5 tbsp Water","1 to taste Sugar"],"recipeInstructions":[{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"For the pudding custard Combine water and gelatin in a bowl Let it rest for about 7-10 minutes Combine cream, milk and sugar and heat for a few minutes until all the sugar melts. Do not boil. Take it off the stovetop and let it rest for about 5 minutes. Incorporate 1 tbsp custard, 3 cups whipping cream, 3 cups milk, and 0.3333333333333333 cup sugar smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/layered-mango-custard/#step-1"},{"@type":"HowToStep","name":"Chill Until Firmly Set","text":"Add gelatin mixture and stir. Add vanilla essence. Pour mixture into small glasses at an angle. It's really rich so the smaller glasses will help reduce the serving. Transfer to refrigerator to chill for a minimum of 4 hours. ( I kept mine in the refrigerator overnight) Please don't put it in the freezer. For the mango puree When you're ready to add the mango purée to the top of the pudding, you can then start the process of preparing the puree. Incorporate 6 tbsp water, 1 tbsp vanilla extract, 1 garnish mint, 1 garnish mango, 1 topping mango, 5 tbsp water, and 1 to taste sugar smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/layered-mango-custard/#step-2"},{"@type":"HowToStep","name":"Portion, Shape & Layer Evenly","text":"Using a blender or hand help mixer, purée mango chunks/slices Strain purée for a finer consistency You can use puree as is or you can add some sugar for a little more sweetness To make the puree like pudding Transfer to a stove top and stir until sugar is dissolved. Remove from stovetop.","url":"https://crave.devyy.com/recipes/layered-mango-custard/#step-3"},{"@type":"HowToStep","name":"Freeze Solid, Slice & Serve","text":"Add gelatin mixture and stir consistently Remove chilled creamy custard from refrigerator and add mango puree mixture to the top of it Chill for a minimum of 2 hours (longer is better) Garnish with mint and small mango pieces and serve.","url":"https://crave.devyy.com/recipes/layered-mango-custard/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Puddings & Custards","item":"https://crave.devyy.com/category/puddings-custards/"},{"@type":"ListItem","position":3,"name":"Layered mango custard","item":"https://crave.devyy.com/recipes/layered-mango-custard/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Layered mango custard?","acceptedAnswer":{"@type":"Answer","text":"Layered mango custard takes 15 minutes total (15 minutes prep) and yields 4 servings at 197 calories per serving."}},{"@type":"Question","name":"Can I make Layered mango custard healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Layered mango custard recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
