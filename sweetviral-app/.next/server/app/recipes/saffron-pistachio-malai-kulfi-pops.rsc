10:T1018,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/saffron-pistachio-malai-kulfi-pops/","name":"Saffron Pistachio Malai Kulfi Pops","image":["https://crave.devyy.com/ai-images/saffron-pistachio-malai-kulfi-pops.jpg","https://crave.devyy.com/ai-images/saffron-pistachio-malai-kulfi-pops.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_kitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Dense, slow-creamed cardamom pistachio kulfi popsicles made in 10 mins with zero ice crystals. Ready in 10 mins (6 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT10M","cookTime":"PT0M","totalTime":"PT10M","recipeYield":"6 servings","recipeCategory":"Frozen & Tanghulu","recipeCuisine":"Indian","keywords":"Saffron Pistachio Malai Kulfi Pops, Indian, Frozen & Tanghulu, #MalaiKulfi, #CraveMadeMeDoIt, #ViralDesserts, #IndianSweets","nutrition":{"@type":"NutritionInformation","calories":"210 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":338},"recipeIngredient":["2 cups Evaporated milk + condensed milk + heavy cream","0.5 tsp Ground cardamom + saffron threads","0.33 cup Finely chopped pistachios & almonds"],"recipeInstructions":[{"@type":"HowToStep","name":"Line Freezer Tray & Prep Mix-Ins","text":"Line a rimmed baking sheet or loaf pan with parchment paper so your frozen treat lifts out cleanly. Measure out 2 cups evaporated milk + condensed milk + heavy cream and 0.5 tsp ground cardamom + saffron threads and keep toppings like 0.33 cup finely chopped pistachios & almonds prepped within reach.","url":"https://crave.devyy.com/recipes/saffron-pistachio-malai-kulfi-pops/#step-1"},{"@type":"HowToStep","name":"Transfer, Smooth Top & Add Garnish","text":"Pour or press the mixture evenly into your prepared dish, smoothing the surface with a spatula. Scatter 0.33 cup finely chopped pistachios & almonds evenly across the top and press gently so it adheres cleanly.","url":"https://crave.devyy.com/recipes/saffron-pistachio-malai-kulfi-pops/#step-2"},{"@type":"HowToStep","name":"Whisk Milks, Pour into Molds & Freeze","text":"Whisk 2 cups evaporated milk + condensed milk + heavy cream, 0.5 tsp ground cardamom + saffron threads, and 0.33 cup finely chopped pistachios & almonds until frothy, pour into popsicle molds with wooden sticks, and freeze 5 hours until dense and creamy.","url":"https://crave.devyy.com/recipes/saffron-pistachio-malai-kulfi-pops/#step-3"},{"@type":"HowToStep","name":"Freeze Solid, Portion & Enjoy","text":"Freeze Saffron Pistachio Malai Kulfi Pops flat until completely solid, then let sit 3 minutes at room temperature before slicing, snapping, or scooping into 6 servings. Store leftovers in a freezer-safe container.","url":"https://crave.devyy.com/recipes/saffron-pistachio-malai-kulfi-pops/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Frozen & Tanghulu","item":"https://crave.devyy.com/category/frozen-candy/"},{"@type":"ListItem","position":3,"name":"Saffron Pistachio Malai Kulfi Pops","item":"https://crave.devyy.com/recipes/saffron-pistachio-malai-kulfi-pops/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Saffron Pistachio Malai Kulfi Pops?","acceptedAnswer":{"@type":"Answer","text":"Saffron Pistachio Malai Kulfi Pops takes 10 minutes total (10 minutes prep) and yields 6 servings at 210 calories per serving."}},{"@type":"Question","name":"Can I make Saffron Pistachio Malai Kulfi Pops healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Saffron Pistachio Malai 