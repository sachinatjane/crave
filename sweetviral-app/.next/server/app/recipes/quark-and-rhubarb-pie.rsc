10:T11d4,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/quark-and-rhubarb-pie/","name":"Quark and Rhubarb Pie","image":["https://crave.devyy.com/ai-images/quark-and-rhubarb-pie.jpg","https://crave.devyy.com/ai-images/quark-and-rhubarb-pie.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Global-inspired quark and rhubarb pie with 12 measured ingredients — zero sign-up, instant Cook Mode. Ready in 33 mins (12 servings). 4.7★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT18M","totalTime":"PT33M","recipeYield":"12 servings","recipeCategory":"Cookies & Bars","recipeCuisine":"Global","keywords":"Quark and Rhubarb Pie, Global, Cookies & Bars, #Quarkand, #CraveMadeMeDoIt, #ViralDesserts, #GlobalSweets","nutrition":{"@type":"NutritionInformation","calories":"325 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.7,"reviewCount":82},"recipeIngredient":["6.7 tbsp Milk","2 tsp Yeast","1 tbsp Sugar","1 whole Egg","0.9 oz Butter","0.5 tsp Salt","0.5 tsp Cardamom","1.25 cup Flour","0.89 cup Sweet Quark","1 cup Rhubarb","1 pinch Sugar","1 pinch Cinnamon"],"recipeInstructions":[{"@type":"HowToStep","name":"Simmer & Dissolve Smoothly","text":"All materials must be in room temperature Dissolve yeast with lukewarm (37C) milk and sugar Add about half of the quantity of flour, mixed with salt Beat the mixture for a short time. Sprinkle with a little flour , cover the bowl with a towel and place in a warm place to rise for ca 1 hour. Incorporate 6.7 tbsp milk, 2 tsp yeast, 1 tbsp sugar, and 1 whole egg smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/quark-and-rhubarb-pie/#step-1"},{"@type":"HowToStep","name":"Shape & Press Dough Evenly","text":"Add additional flour, cardamom add melted butter. Beat egg and leave ca 1 teaspoon for spreading.Add other beaten egg in to the dough Knead the dough properly, until it separates from the bowl. Sprinkle with a little flour , cover the bowl with a towel and place in a warm place to rise for ca 1 hour until dough is doubled in size. Incorporate 0.9 oz butter, 0.5 tsp salt, 0.5 tsp cardamom, 1.25 cup flour, 0.89 cup sweet quark, 1 cup rhubarb, 1 pinch sugar, and 1 pinch cinnamon smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/quark-and-rhubarb-pie/#step-2"},{"@type":"HowToStep","name":"Dip & Coat Evenly","text":"Roll the dough to a square and put in centre quark. Turn edges on to the quark and roll again carefully  to a rectangle. Pour on to the rectangle rhubarb, sugar and cinnamon. leave one edge ca 2 cm empty. Roll and cut in to the equal slices. You should get ca 6-7 rolls. Empty edge turn under the roll as bottom. Put roll in to the butter-spreaded springform pan, as flower. one roll in to the centre and others around. Let enough space to rise. Coat buns with beaten egg before putting into the oven. Bate at 180C 20-30 minutes .","url":"https://crave.devyy.com/recipes/quark-and-rhubarb-pie/#step-3"},{"@type":"HowToStep","name":"Cool, Garnish & Serve","text":"Decorate with icing sugar. Let Quark and Rhubarb Pie cool for 10–15 minutes so the crumb sets cleanly before slicing into 12 portions, then garnish and serve.","url":"https://crave.devyy.com/recipes/quark-and-rhubarb-pie/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Cookies & Bars","item":"https://crave.devyy.com/category/cookies-bars/"},{"@type":"ListItem","position":3,"name":"Quark and Rhubarb Pie","item":"https://crave.devyy.com/recipes/quark-and-rhubarb-pie/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Quark and Rhubarb Pie?","acceptedAnswer":{"@type":"Answer","text":"Quark and Rhubarb Pie takes 33 minutes total (15 minutes prep) and yields 12 servings at 325 calories per serving."}},{"@type":"Question","name":"Can I make Quark and Rhubarb Pie healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Quark and Rhubarb Pie recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
