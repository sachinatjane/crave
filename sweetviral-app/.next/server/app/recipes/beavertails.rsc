10:Tf8c,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/beavertails/","name":"BeaverTails","image":["https://crave.devyy.com/ai-images/beavertails.jpg","https://crave.devyy.com/ai-images/beavertails.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Canadian-inspired beavertails with 12 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (4 servings). 4.8★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"4 servings","recipeCategory":"Global Classics","recipeCuisine":"Canadian","keywords":"BeaverTails, Canadian, Global Classics, #BeaverTails, #CraveMadeMeDoIt, #ViralDesserts, #CanadianSweets","nutrition":{"@type":"NutritionInformation","calories":"358 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":82},"recipeIngredient":["0.5 cup Water","2 parts Yeast","0.5 cup Sugar","0.5 cup Milk","6 tbsp Butter","2 whole Eggs","1 tsp Salt","2 cups Flour","1 for frying Oil","1 garnish Lemon","1 garnish Sugar","1 garnish Cinnamon"],"recipeInstructions":[{"@type":"HowToStep","name":"Prep & Mix: BeaverTails","text":"In the bowl of a stand mixer, add warm water, a big pinch of sugar and yeast. Allow to sit until frothy. Into the same bowl, add 1/2 cup sugar, warm milk, melted butter, eggs and salt, and whisk until combined. Incorporate 0.5 cup water, 2 parts yeast, 0.5 cup sugar, and 0.5 cup milk smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/beavertails/#step-1"},{"@type":"HowToStep","name":"Build Flavor: BeaverTails","text":"Place a dough hook on the mixer, add the flour with the machine on, until a smooth but slightly sticky dough forms. Place dough in a bowl, cover with plastic wrap, and allow to proof for 1 1/2 hours. Incorporate 6 tbsp butter, 2 whole eggs, 1 tsp salt, 2 cups flour, 1 for frying oil, 1 garnish lemon, 1 garnish sugar, and 1 garnish cinnamon smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/beavertails/#step-2"},{"@type":"HowToStep","name":"Shape & Layer: BeaverTails","text":"Cut dough into 12 pieces, and roll out into long oval-like shapes about 1/4 inch thick that resemble a beaver’s tail. In a large, deep pot, heat oil to 350 degrees. Gently place beavertail dough into hot oil and cook for 30 to 45 seconds on each side until golden brown.","url":"https://crave.devyy.com/recipes/beavertails/#step-3"},{"@type":"HowToStep","name":"Bake / Chill: BeaverTails","text":"Drain on paper towels, and garnish as desired. Toss in cinnamon sugar, in white sugar with a squeeze of lemon, or with a generous slathering of Nutella and a handful of toasted almonds. Enjoy!","url":"https://crave.devyy.com/recipes/beavertails/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"BeaverTails","item":"https://crave.devyy.com/recipes/beavertails/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make BeaverTails?","acceptedAnswer":{"@type":"Answer","text":"BeaverTails takes 45 minutes total (15 minutes prep) and yields 4 servings at 358 calories per serving."}},{"@type":"Question","name":"Can I make BeaverTails healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this BeaverTails recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
