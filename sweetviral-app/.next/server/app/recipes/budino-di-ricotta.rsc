10:Tfcb,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/budino-di-ricotta/","name":"Budino Di Ricotta","image":["https://crave.devyy.com/ai-images/budino-di-ricotta.jpg","https://crave.devyy.com/ai-images/budino-di-ricotta.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Italian-inspired budino di ricotta with 8 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (4 servings). 4.7★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"4 servings","recipeCategory":"Global Classics","recipeCuisine":"Italian","keywords":"Budino Di Ricotta, Italian, Global Classics, #BudinoDi, #CraveMadeMeDoIt, #ViralDesserts, #ItalianSweets","nutrition":{"@type":"NutritionInformation","calories":"314 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.7,"reviewCount":42},"recipeIngredient":["2.22 cup Ricotta","4 pcs Eggs","3 tbs Flour","1.11 cup Sugar","1 tsp Cinnamon","1 grated zest of Lemons","5 tbs Dark Rum","1 sprinking Icing Sugar"],"recipeInstructions":[{"@type":"HowToStep","name":"Bake Until Golden & Set","text":"Mash the ricotta and beat well with the egg yolks, stir in the flour, sugar, cinnamon, grated lemon rind and the rum and mix well. You can do this in a food processor. Beat the egg whites until stiff, fold in and pour into a buttered and floured 25cm cake tin. Bake in the oven at 180ºC/160ºC fan/gas 4 for about 40 minutes, or until it is firm. Incorporate 2.22 cup ricotta, 4 pcs eggs, 3 tbs flour, and 1.11 cup sugar smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/budino-di-ricotta/#step-1"},{"@type":"HowToStep","name":"Bake Budino Di Ricotta & Check Doneness","text":"Bake for 30 minutes until the edges turn golden and set while the center remains tender. Test with a toothpick—if it comes out with a few moist crumbs rather than wet batter, it is ready. Incorporate 1 tsp cinnamon, 1 grated zest of lemons, 5 tbs dark rum, and 1 sprinking icing sugar smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/budino-di-ricotta/#step-2"},{"@type":"HowToStep","name":"Cool, Garnish & Serve","text":"Serve hot or cold dusted with icing sugar. Let Budino Di Ricotta cool for 10–15 minutes so the crumb sets cleanly before slicing into 4 portions, then garnish and serve.","url":"https://crave.devyy.com/recipes/budino-di-ricotta/#step-3"},{"@type":"HowToStep","name":"Cool Completely, Garnish & Serve","text":"Transfer Budino Di Ricotta to a wire cooling rack and let it cool for 15–20 minutes so the interior sets cleanly without crumbling. Lift out using the parchment overhang, garnish as desired, and slice into 4 portions.","url":"https://crave.devyy.com/recipes/budino-di-ricotta/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"Budino Di Ricotta","item":"https://crave.devyy.com/recipes/budino-di-ricotta/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Budino Di Ricotta?","acceptedAnswer":{"@type":"Answer","text":"Budino Di Ricotta takes 45 minutes total (15 minutes prep) and yields 4 servings at 314 calories per serving."}},{"@type":"Question","name":"Can I make Budino Di Ricotta healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Budino Di Ricotta recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
