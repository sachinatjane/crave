name":"Vegetable Oil","baseAmount":2,"usUnit":"tbsp","metricAmount":30,"metricUnit":"ml","pantryKey":"sugar","stepRef":2},{"id":"m53285_7","name":"Egg","baseAmount":1,"usUnit":"whole","metricAmount":1,"metricUnit":"whole","pantryKey":"eggs","stepRef":2},{"id":"m53285_8","name":"Lemon Juice","baseAmount":0.5,"usUnit":"tsp","metricAmount":2,"metricUnit":"g","pantryKey":"lemon","stepRef":2},{"id":"m53285_9","name":"Salt","baseAmount":1,"usUnit":"pinch","metricAmount":1,"metricUnit":"pinch","pantryKey":"sugar","stepRef":2},{"id":"m53285_10","name":"Orange Blossom Water","baseAmount":1,"usUnit":"tbsp","metricAmount":15,"metricUnit":"ml","pantryKey":"lemon","stepRef":2}]},{"title":"Flavor, Glaze & Finish","badge":"Signature Touch","tone":"primary","items":[{"id":"m53285_11","name":"Almonds","baseAmount":4,"usUnit":"cups","metricAmount":880,"metricUnit":"g","pantryKey":"pistachio","stepRef":2},{"id":"m53285_12","name":"Sugar","baseAmount":1,"usUnit":"cup","metricAmount":220,"metricUnit":"g","pantryKey":"sugar","stepRef":2},{"id":"m53285_13","name":"Egg","baseAmount":3,"usUnit":"whole","metricAmount":3,"metricUnit":"whole","pantryKey":"eggs","stepRef":2},{"id":"m53285_14","name":"Baking Powder","baseAmount":0.5,"usUnit":"tsp","metricAmount":2,"metricUnit":"g","pantryKey":"sugar","stepRef":2},{"id":"m53285_15","name":"Vanilla","baseAmount":1,"usUnit":"tsp","metricAmount":5,"metricUnit":"ml","pantryKey":"vanilla","stepRef":2},{"id":"m53285_16","name":"Lemon","baseAmount":1,"usUnit":"zest of 1","metricAmount":1,"metricUnit":"zest of 1","pantryKey":"lemon","stepRef":2},{"id":"m53285_17","name":"Orange Blossom Water","baseAmount":2,"usUnit":"tbsp","metricAmount":30,"metricUnit":"ml","pantryKey":"lemon","stepRef":2},{"id":"m53285_18","name":"Cornstarch","baseAmount":1,"usUnit":"sprinkling","metricAmount":1,"metricUnit":"sprinkling","pantryKey":"sugar","stepRef":2},{"id":"m53285_19","name":"Pine Nuts","baseAmount":1,"usUnit":"to serve","metricAmount":1,"metricUnit":"to serve","pantryKey":"sugar","stepRef":2}]}],"steps":[{"stepNumber":1,"phaseLabel":"Prep & Mix","title":"Simmer & Dissolve Smoothly","instructionTemplate":"Prepare the almonds the day before. Bring 6 cups of water to a boil. Remove from heat, and add the almonds. Let the almonds soak in water for about 5 minutes, then drain and peel. Spread the almonds on baking sheets, and bake at 200 degrees F(95 degrees C) until completely dry and toasted. This takes several hours, and needs to be prepared ahead. Be careful not to burn the nuts, as this will give a bitter taste to the filling. Combine 1 cup sugar and 1 cup water in a saucepan, and bring to a boil. Add 1 teaspoon lemon juice, reduce heat to low, and let it simmer until syrupy, about 30 to 40 minutes. Stir in orange blossom water, and remove from heat. Set sugar syrup aside. Incorporate {m53285_1}, {m53285_2}, {m53285_3}, and {m53285_4} smoothly until evenly distributed.","durationMin":5,"timerSeconds":300,"activeMeasureSummary":"Sugar, Water","creatorSecret":"Prep and measure sugar first—mise en place makes this dessert twice as fast."},{"stepNumber":2,"phaseLabel":"Build Flavor","title":"Shape & Press Dough Evenly","instructionTemplate":"Combine flour and salt in a large mixing bowl. Make a hole in the center, and pour oil, egg, 1/2 teaspoon lemon juice, and 1 tablespoon orange blossom water into the center. Mix with fingers until the dough resembles coarse crumbs. Gradually sprinkle with warm water while mixing until the dough becomes soft and pliable. Divide into 4 equal portions. Cover dough with a wet cloth, and set aside. In a food processor, finely grind the almonds. Measure 3 cups of the finely ground almonds into a mixing bowl, and stir together with 1 cup sugar, baking powder, vanilla powder, lemon zest, and 2 tablespoons orange flower water. Mix in three eggs one at a time, stirring constantly; mix until you get a sticky, paste-like mixture. Incorporate {m53285_5}, {m53285_6}, {m53285_7}, {m53285_8}, {m53285_9}, {m53285_10}, {m53285_11}, {m53285_12}, {m53285_13}, {m53285_14}, {m53285_15}, {m53285_16}, {m53285_17}, {m53285_18}, and {m53285_19} smoothly until evenly distributed.","durationMin":5,"timerSeconds":300,"activeMeasureSummary":"Lemon Juice, Orange Blossom Water"},{"stepNumber":3,"phaseLabel":"Bake & Check","title":"Bake Dziriat (Algerian Almond Tarts) & Check Doneness","instructionTemplate":"Bake for 30 minutes until the edges turn golden and set while the center remains tender. Test with a toothpick—if it comes out with a few moist crumbs rather than wet batter, it is ready.","durationMin":30,"timerSeconds":1800,"activeMeasureSummary":"Bake 30m • Toothpick Check"},{"stepNumber":4,"phaseLabel":"Shape & Layer","title":"Dip & Coat Evenly","instructionTemplate":"Sprinkle cornstarch on the rolling surface to prevent sticking. Roll each portion of dough very thinly, 1 to 2 millimeters (1/16 inch). Cut the rolled dough into circles of about 10 centimeters (4 inches) in diameter each. Lightly wipe the surface of each circle with cornstarch, and fit into a tart mold, cornstarch side down to prevent sticking. Gently press the dough onto the sides and bottom of the mold, and trim extra dough from around the rim. Fill three quarters of each mold with the almond filling. Bake on the top shelf at 350 degrees F (175 degrees C) for 20 to 25 minutes, or until the surface of the tart is golden and the dough is firm. Remove the tarts from the molds as soon as they come out of the oven. Dip each tart in the sugar syrup while still hot. Stick a pine nut into the middle of each tart for decoration. Place on a wire rack to drain.","durationMin":30,"timerSeconds":1800,"activeMeasureSummary":"All purpose flour, Vegetable Oil","criticalTip":"Let set for 5–10 minutes before slicing or plating so the textures hold crisp and photogenic!","creatorSecret":"Chill the filled crust 10 minutes before baking—cold butter hits the hot oven and puffs into extra-flaky layers."}],"ugcQuotes":[{"id":"muq-53285","handle":"@baker_dziriat-","image":"./ai-images/dziriat-algerian-almond-tarts.jpg","quote":"Followed the scaled metric steps—came out flawless in 45 mins!","rating":5}],"isHealthy":true}}]
14:["$","li","4",{"children":[["$","h3",null,{"children":"Dip & Coat Evenly"}],["$","p",null,{"children":"Sprinkle cornstarch on the rolling surface to prevent sticking. Roll each portion of dough very thinly, 1 to 2 millimeters (1/16 inch). Cut the rolled dough into circles of about 10 centimeters (4 inches) in diameter each. Lightly wipe the surface of each circle with cornstarch, and fit into a tart mold, cornstarch side down to prevent sticking. Gently press the dough onto the sides and bottom of the mold, and trim extra dough from around the rim. Fill three quarters of each mold with the almond filling. Bake on the top shelf at 350 degrees F (175 degrees C) for 20 to 25 minutes, or until the surface of the tart is golden and the dough is firm. Remove the tarts from the molds as soon as they come out of the oven. Dip each tart in the sugar syrup while still hot. Stick a pine nut into the middle of each tart for decoration. Place on a wire rack to drain."}]]}]
