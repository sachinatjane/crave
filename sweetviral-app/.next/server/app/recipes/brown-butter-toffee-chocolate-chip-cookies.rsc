10:T110e,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/brown-butter-toffee-chocolate-chip-cookies/","name":"Brown-Butter Toffee Chocolate Chip Cookies","image":["https://crave.devyy.com/ai-images/brown-butter-toffee-chocolate-chip-cookies.jpg","https://crave.devyy.com/ai-images/brown-butter-toffee-chocolate-chip-cookies.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_kitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Nutty browned butter, pools of dark chocolate shards, crisp edges & gooey caramel centers. Ready in 23 mins (12 servings). 5.0★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT12M","cookTime":"PT11M","totalTime":"PT23M","recipeYield":"12 servings","recipeCategory":"Cookies & Bars","recipeCuisine":"American","keywords":"Brown-Butter Toffee Chocolate Chip Cookies, American, Cookies & Bars, #BrownButter, #CraveMadeMeDoIt, #ViralDesserts, #AmericanSweets","nutrition":{"@type":"NutritionInformation","calories":"295 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":5,"reviewCount":272},"recipeIngredient":["0.5 cup Unsalted butter (browned & cooled)","1 cup Dark brown sugar + white sugar","1 egg Large egg + 1 tsp vanilla","1.5 cups All-purpose flour + 1/2 tsp baking soda","1.25 cups Chopped dark chocolate + flaky sea salt"],"recipeInstructions":[{"@type":"HowToStep","name":"Preheat Oven & Prep Your Pan","text":"Preheat your oven to 350°F (175°C) and line your baking pan with parchment paper, leaving a slight overhang for effortless lifting. Measure out 0.5 cup unsalted butter (browned & cooled), 1 cup dark brown sugar + white sugar, and 1 egg large egg + 1 tsp vanilla so everything is ready and at room temperature for a silky, lump-free batter.","url":"https://crave.devyy.com/recipes/brown-butter-toffee-chocolate-chip-cookies/#step-1"},{"@type":"HowToStep","name":"Toast Butter Until Amber & Nutty","text":"Melt 0.5 cup unsalted butter (browned & cooled) over medium heat swirling 4 mins until golden brown specks form and it smells like toasted hazelnuts. Cool 5 mins.","url":"https://crave.devyy.com/recipes/brown-butter-toffee-chocolate-chip-cookies/#step-2"},{"@type":"HowToStep","name":"Fold Chocolate & Bake 11 Mins","text":"Whisk 1 cup dark brown sugar + white sugar and 1 egg large egg + 1 tsp vanilla into butter, fold in 1.5 cups all-purpose flour + 1/2 tsp baking soda and 1.25 cups chopped dark chocolate + flaky sea salt. Bake at 350°F (175°C) for 11 minutes, tapping the tray once at minute 9 for bakery ripples.","url":"https://crave.devyy.com/recipes/brown-butter-toffee-chocolate-chip-cookies/#step-3"},{"@type":"HowToStep","name":"Cool Completely, Garnish & Serve","text":"Transfer Brown-Butter Toffee Chocolate Chip Cookies to a wire cooling rack and let it cool for 15–20 minutes so the interior sets cleanly without crumbling. Lift out using the parchment overhang, garnish as desired, and slice into 12 portions.","url":"https://crave.devyy.com/recipes/brown-butter-toffee-chocolate-chip-cookies/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Cookies & Bars","item":"https://crave.devyy.com/category/cookies-bars/"},{"@type":"ListItem","position":3,"name":"Brown-Butter Toffee Chocolate Chip Cookies","item":"https://crave.devyy.com/recipes/brown-butter-toffee-chocolate-chip-cookies/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Brown-Butter Toffee Chocolate Chip Cookies?","acceptedAnswer":{"@type":"Answer","text":"Brown-Butter Toffee Chocolate Chip Cookies takes 23 minutes total (12 minutes prep) and yields 12 servings at 295 calories per serving."}},{"@type":"Question","name":"Can I make Brown-Butter Toffee Chocolate Chip Cookies healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Brown-Butter Toffee Chocolate Chip Cookies recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
