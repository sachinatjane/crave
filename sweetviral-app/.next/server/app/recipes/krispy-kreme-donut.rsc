10:T11e7,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/krispy-kreme-donut/","name":"Krispy Kreme Donut","image":["https://crave.devyy.com/ai-images/krispy-kreme-donut.jpg","https://crave.devyy.com/ai-images/krispy-kreme-donut.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"United States-inspired krispy kreme donut with 14 measured ingredients — zero sign-up, instant Cook Mode. Ready in 33 mins (4 servings). 4.7★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT18M","totalTime":"PT33M","recipeYield":"4 servings","recipeCategory":"Pastries & Donuts","recipeCuisine":"United States","keywords":"Krispy Kreme Donut, United States, Pastries & Donuts, #KrispyKreme, #CraveMadeMeDoIt, #ViralDesserts, #UnitedSweets","nutrition":{"@type":"NutritionInformation","calories":"333 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.7,"reviewCount":139},"recipeIngredient":["0.25 oz Yeast","0.25 cup Water","1.5 cups Water","0.5 cup Sugar","1 tsp Salt","2 whole Eggs","0.3333333333333333 cup Shortening","5 drops Flour","1 sprinking Canola Oil","0.5 cup Milk","2 cups Sugar","1.5 cups Vanilla","6 tbsp Boiling Water","0.3333333333333333 cup Butter"],"recipeInstructions":[{"@type":"HowToStep","name":"Dip & Coat Evenly","text":"Dissolve yeast in warm water in 2 1/2-quart bowl. Add milk, sugar, salt, eggs, shortening and 2 cups flour. Beat on low for 30 seconds, scraping bowl constantly. Beat on medium speed for 2 minutes, scraping bowl occasionally. Stir in remaining flour until smooth. Cover and let rise until double, 50-60 minutes. (Dough is ready when indentation remains when touched.) Turn dough onto floured surface; roll around lightly to coat with flour. Gently roll dough 1/2-inch thick with floured rolling pin. Cut with floured doughnut cutter. Cover and let rise until double, 30-40 minutes. Incorporate 0.25 oz yeast, 0.25 cup water, 1.5 cups water, and 0.5 cup sugar smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/krispy-kreme-donut/#step-1"},{"@type":"HowToStep","name":"Dip & Coat Evenly","text":"Heat vegetable oil in deep fryer to 350°. Slide doughnuts into hot oil with wide spatula. Turn doughnuts as they rise to the surface. Fry until golden brown, about 1 minute on each side. Remove carefully from oil (do not prick surface); drain. Dip the doughnuts into creamy glaze set on rack. Incorporate 1 tsp salt, 2 whole eggs, and 0.3333333333333333 cup shortening smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/krispy-kreme-donut/#step-2"},{"@type":"HowToStep","name":"Combine Wet & Dry Smoothly","text":"Fold 5 drops flour, 1 sprinking canola oil, 0.5 cup milk, 2 cups sugar, 1.5 cups vanilla, 6 tbsp boiling water, and 0.3333333333333333 cup butter into the base in two additions using gentle strokes until glossy and uniform with zero dry pockets. Avoid overmixing so the final texture stays light and tender.","url":"https://crave.devyy.com/recipes/krispy-kreme-donut/#step-3"},{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Heat butter until melted. Remove from heat. Stir in powdered sugar and vanilla until smooth. Stir in water, 1 tablespoon at a time, until desired consistency.","url":"https://crave.devyy.com/recipes/krispy-kreme-donut/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Pastries & Donuts","item":"https://crave.devyy.com/category/pastries-donuts/"},{"@type":"ListItem","position":3,"name":"Krispy Kreme Donut","item":"https://crave.devyy.com/recipes/krispy-kreme-donut/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Krispy Kreme Donut?","acceptedAnswer":{"@type":"Answer","text":"Krispy Kreme Donut takes 33 minutes total (15 minutes prep) and yields 4 servings at 333 calories per serving."}},{"@type":"Question","name":"Can I make Krispy Kreme Donut healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Krispy Kreme Donut recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
