nish","badge":"Signature Touch","tone":"primary","items":[{"id":"m52857_7","name":"Cinnamon","baseAmount":1,"usUnit":"tsp","metricAmount":5,"metricUnit":"g","pantryKey":"cinnamon","stepRef":2},{"id":"m52857_8","name":"Eggs","baseAmount":2,"usUnit":"beaten","metricAmount":2,"metricUnit":"beaten","pantryKey":"eggs","stepRef":2},{"id":"m52857_9","name":"Butter","baseAmount":0.9,"usUnit":"oz","metricAmount":25,"metricUnit":"g","pantryKey":"butter","stepRef":2},{"id":"m52857_10","name":"Milk","baseAmount":11.7,"usUnit":"tbsp","metricAmount":175,"metricUnit":"g","pantryKey":"milk","stepRef":2},{"id":"m52857_11","name":"Icing Sugar","baseAmount":1,"usUnit":"tbsp","metricAmount":15,"metricUnit":"g","pantryKey":"sugar","stepRef":2}]}],"steps":[{"stepNumber":1,"phaseLabel":"Prep & Mix","title":"Prep & Mix: Pumpkin Pie","instructionTemplate":"Place the pumpkin in a large saucepan, cover with water and bring to the boil. Cover with a lid and simmer for 15 mins or until tender. Drain pumpkin; let cool. Incorporate {m52857_1}, {m52857_2}, {m52857_3}, and {m52857_4} smoothly until evenly distributed.","durationMin":3,"timerSeconds":180,"activeMeasureSummary":"Pumpkin, Shortcrust Pastry","creatorSecret":"Prep and measure pumpkin first—mise en place makes this dessert twice as fast."},{"stepNumber":2,"phaseLabel":"Build Flavor","title":"Build Flavor: Pumpkin Pie","instructionTemplate":"Heat oven to 180C/160C fan/gas 4. Roll out the pastry on a lightly floured surface and use it to line a 22cm loose-bottomed tart tin. Chill for 15 mins. Line the pastry with baking parchment and baking beans, then bake for 15 mins. Remove the beans and paper, and cook for a further 10 mins until the base is pale golden and biscuity. Remove from the oven and allow to cool slightly. Incorporate {m52857_5}, {m52857_6}, {m52857_7}, {m52857_8}, {m52857_9}, {m52857_10}, and {m52857_11} smoothly until evenly distributed.","durationMin":3,"timerSeconds":180,"activeMeasureSummary":"Plain Flour, Caster Sugar"},{"stepNumber":3,"phaseLabel":"Shape & Layer","title":"Shape & Layer: Pumpkin Pie","instructionTemplate":"Increase oven to 220C/200C fan/gas 7. Push the cooled pumpkin through a sieve into a large bowl. In a separate bowl, combine the sugar, salt, nutmeg and half the cinnamon. Mix in the beaten eggs, melted butter and milk, then add to the pumpkin purée and stir to combine. Pour into the tart shell and cook for 10 mins, then reduce the temperature to 180C/160C fan/gas 4. Continue to bake for 35-40 mins until the filling has just set.","durationMin":3,"timerSeconds":180,"activeMeasureSummary":"Salt, Nutmeg"},{"stepNumber":4,"phaseLabel":"Bake / Chill","title":"Bake / Chill: Pumpkin Pie","instructionTemplate":"Leave to cool, then remove the pie from the tin. Mix the remaining cinnamon with the icing sugar and dust over the pie. Serve chilled.","durationMin":30,"timerSeconds":1800,"activeMeasureSummary":"Cinnamon, Eggs","criticalTip":"Let set for 5–10 minutes before slicing or plating so the textures hold crisp and photogenic!","creatorSecret":"Chill the filled crust 10 minutes before baking—cold butter hits the hot oven and puffs into extra-flaky layers."}],"ugcQuotes":[{"id":"muq-52857","handle":"@baker_pumpkin-","image":"./ai-images/pumpkin-pie.jpg","quote":"Followed the scaled metric steps—came out flawless in 45 mins!","rating":5}]}}]
