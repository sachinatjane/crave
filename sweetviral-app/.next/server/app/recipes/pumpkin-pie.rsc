10:T10b5,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/pumpkin-pie/","name":"Pumpkin Pie","image":["https://crave.devyy.com/ai-images/pumpkin-pie.jpg","https://crave.devyy.com/ai-images/pumpkin-pie.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"United States-inspired pumpkin pie with 11 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (6 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"6 servings","recipeCategory":"Pies, Tarts & Crumbles","recipeCuisine":"United States","keywords":"Pumpkin Pie, United States, Pies, Tarts & Crumbles, #PumpkinPie, #CraveMadeMeDoIt, #ViralDesserts, #UnitedSweets","nutrition":{"@type":"NutritionInformation","calories":"270 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":234},"recipeIngredient":["3.33 cup Pumpkin","1.56 cup Shortcrust Pastry","1 dusting Plain Flour","9.3 tbsp Caster Sugar","1 tsp Salt","1 tsp Nutmeg","1 tsp Cinnamon","2 beaten Eggs","0.9 oz Butter","11.7 tbsp Milk","1 tbsp Icing Sugar"],"recipeInstructions":[{"@type":"HowToStep","name":"Prep & Mix: Pumpkin Pie","text":"Place the pumpkin in a large saucepan, cover with water and bring to the boil. Cover with a lid and simmer for 15 mins or until tender. Drain pumpkin; let cool. Incorporate 3.33 cup pumpkin, 1.56 cup shortcrust pastry, 1 dusting plain flour, and 9.3 tbsp caster sugar smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/pumpkin-pie/#step-1"},{"@type":"HowToStep","name":"Build Flavor: Pumpkin Pie","text":"Heat oven to 180C/160C fan/gas 4. Roll out the pastry on a lightly floured surface and use it to line a 22cm loose-bottomed tart tin. Chill for 15 mins. Line the pastry with baking parchment and baking beans, then bake for 15 mins. Remove the beans and paper, and cook for a further 10 mins until the base is pale golden and biscuity. Remove from the oven and allow to cool slightly. Incorporate 1 tsp salt, 1 tsp nutmeg, 1 tsp cinnamon, 2 beaten eggs, 0.9 oz butter, 11.7 tbsp milk, and 1 tbsp icing sugar smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/pumpkin-pie/#step-2"},{"@type":"HowToStep","name":"Shape & Layer: Pumpkin Pie","text":"Increase oven to 220C/200C fan/gas 7. Push the cooled pumpkin through a sieve into a large bowl. In a separate bowl, combine the sugar, salt, nutmeg and half the cinnamon. Mix in the beaten eggs, melted butter and milk, then add to the pumpkin purée and stir to combine. Pour into the tart shell and cook for 10 mins, then reduce the temperature to 180C/160C fan/gas 4. Continue to bake for 35-40 mins until the filling has just set.","url":"https://crave.devyy.com/recipes/pumpkin-pie/#step-3"},{"@type":"HowToStep","name":"Bake / Chill: Pumpkin Pie","text":"Leave to cool, then remove the pie from the tin. Mix the remaining cinnamon with the icing sugar and dust over the pie. Serve chilled.","url":"https://crave.devyy.com/recipes/pumpkin-pie/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Pies, Tarts & Crumbles","item":"https://crave.devyy.com/category/pies-tarts/"},{"@type":"ListItem","position":3,"name":"Pumpkin Pie","item":"https://crave.devyy.com/recipes/pumpkin-pie/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Pumpkin Pie?","acceptedAnswer":{"@type":"Answer","text":"Pumpkin Pie takes 45 minutes total (15 minutes prep) and yields 6 servings at 270 calories per serving."}},{"@type":"Question","name":"Can I make Pumpkin Pie healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Pumpkin Pie recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
