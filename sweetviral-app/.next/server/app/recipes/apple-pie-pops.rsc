10:T136d,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/apple-pie-pops/","name":"Apple pie pops","image":["https://crave.devyy.com/ai-images/apple-pie-pops.jpg","https://crave.devyy.com/ai-images/apple-pie-pops.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Global-inspired apple pie pops with 16 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (6 servings). 4.8★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"6 servings","recipeCategory":"Pies, Tarts & Crumbles","recipeCuisine":"Global","keywords":"Apple pie pops, Global, Pies, Tarts & Crumbles, #Applepie, #CraveMadeMeDoIt, #ViralDesserts, #GlobalSweets","nutrition":{"@type":"NutritionInformation","calories":"410 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":50},"recipeIngredient":["1 tbsp Sugar","1.5 cups All purpose flour","1 tsp Salt","4 oz Unsalted Butter","1 tbsp Shortening","0.25 cup Cold Water","1 lb Apples","0.25 cup Brown Sugar","1 tsp Cinnamon","3 tbsp Unsalted Butter","0.5 tsp Ground Nutmeg","0.5 tsp Salt","0.75 tsp Lemon Juice","1 topping Sugar","1 whole Egg","2 tsp Water"],"recipeInstructions":[{"@type":"HowToStep","name":"Prep & Mix: Apple pie pops","text":"Need Lollipop sticks Instructions for crust Combine the flour, sugar, and salt to a food processor bowl. Mix using the pulse setting. Add butter and shortening and pulse about 10 -12 times until the texture is changed to small pebbles. Add ¾ of the ice water and pulse a few more times until the dough takes the shape of a ball. Add more water as needed. Don't overmix. Don't worry if the dough isn't completely blended. You will use your rolling pin to finish creating the crust. Place dough ball onto the counter and flatten into a flat disc. Wrap it in plastic wrap and refrigerate for at least an hour or overnight. Incorporate 1 tbsp sugar, 1.5 cups all purpose flour, 1 tsp salt, and 4 oz unsalted butter smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/apple-pie-pops/#step-1"},{"@type":"HowToStep","name":"Build Flavor: Apple pie pops","text":"Instructions for pie filling Heat butter over medium heat, until just golden brown Add brown sugar, spices, salt and lemon juice. Stir to combine ingredients Add diced apples and stir. Allow apples to cook for about 5-7 minutes, over medium heat Remove from heat and let the apple mixture cool. You can place apples in the refrigerator to speed up the process. Incorporate 1 tbsp shortening, 0.25 cup cold water, 1 lb apples, 0.25 cup brown sugar, 1 tsp cinnamon, 3 tbsp unsalted butter, 0.5 tsp ground nutmeg, 0.5 tsp salt, 0.75 tsp lemon juice, 1 topping sugar, 1 whole egg, and 2 tsp water smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/apple-pie-pops/#step-2"},{"@type":"HowToStep","name":"Shape & Press Dough Evenly","text":"Mix egg and water for an egg wash. Roll out pie dough to 1/8 inch thickness. Cut out rounds of 2 ½ to 3 inches and place them on parchment paper. You will need to roll out the extra dough left over scraps from cutting. In half of the rounds, cut out shapes or holes for ventilation purposes On the other half of the rounds, gently press one lollipop stick about halfway up each round. Place one tablespoon of apple mixture in the center of each round.","url":"https://crave.devyy.com/recipes/apple-pie-pops/#step-3"},{"@type":"HowToStep","name":"Bake / Chill: Apple pie pops","text":"Place each round on top of apples seal the edges. Brush each pie pop with egg wash and sprinkle sugar on top. Bake 15-20 minutes or until golden brown.","url":"https://crave.devyy.com/recipes/apple-pie-pops/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Pies, Tarts & Crumbles","item":"https://crave.devyy.com/category/pies-tarts/"},{"@type":"ListItem","position":3,"name":"Apple pie pops","item":"https://crave.devyy.com/recipes/apple-pie-pops/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Apple pie pops?","acceptedAnswer":{"@type":"Answer","text":"Apple pie pops takes 45 minutes total (15 minutes prep) and yields 6 servings at 410 calories per serving."}},{"@type":"Question","name":"Can I make Apple pie pops healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Apple pie pops recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
