10:Tf94,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/molten-nutella-lava-cookie-skillet/","name":"Molten Nutella Lava Cookie Skillet","image":["https://crave.devyy.com/ai-images/molten-nutella-lava-cookie-skillet.jpg","https://crave.devyy.com/ai-images/molten-nutella-lava-cookie-skillet.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@skilletbae"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"1-bowl brown-butter cookie dough hiding a frozen molten Nutella core in 15 mins. Ready in 15 mins (4 servings). 5.0★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT5M","cookTime":"PT10M","totalTime":"PT15M","recipeYield":"4 servings","recipeCategory":"Chocolate & Brownies","recipeCuisine":"American","keywords":"Molten Nutella Lava Cookie Skillet, American, Chocolate & Brownies, #NutellaSkillet, #15MinDessert, #Pizookie, #CraveMadeMeDoIt","nutrition":{"@type":"NutritionInformation","calories":"460 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":5,"reviewCount":620},"recipeIngredient":["0.5 cup Creamy Nutella hazelnut spread","4 tbsp Melted salted butter","0.75 cup All-purpose flour","0.5 cup Semi-sweet chocolate chunks"],"recipeInstructions":[{"@type":"HowToStep","name":"Preheat Air Fryer & Measure Ingredients","text":"Preheat your air fryer to 330°F (165°C) for 3 minutes and line the basket with perforated parchment or a light oil mist. Measure out 0.5 cup creamy nutella hazelnut spread and 4 tbsp melted salted butter in a mixing bowl so they combine evenly.","url":"https://crave.devyy.com/recipes/molten-nutella-lava-cookie-skillet/#step-1"},{"@type":"HowToStep","name":"Whisk Dough & Stuff Nutella Core","text":"Stir 4 tbsp melted salted butter with 1/3 cup brown sugar and 1 egg yolk, then fold in 0.75 cup all-purpose flour. Press half into a mini skillet, spoon 0.5 cup creamy nutella hazelnut spread into the center, and seal with remaining dough.","url":"https://crave.devyy.com/recipes/molten-nutella-lava-cookie-skillet/#step-2"},{"@type":"HowToStep","name":"Bake Until Gooey & Scoop Ice Cream","text":"Top with 0.5 cup semi-sweet chocolate chunks. Bake or air-fry at 350°F (175°C) for 10 minutes until edges are golden crisp while center stays molten. Top immediately with vanilla bean ice cream!","url":"https://crave.devyy.com/recipes/molten-nutella-lava-cookie-skillet/#step-3"},{"@type":"HowToStep","name":"Rest 5 Minutes & Serve Warm","text":"Carefully lift Molten Nutella Lava Cookie Skillet out of the air-fryer basket and rest 5 minutes on a cooling rack so the crust crisps up. Plate into 4 servings and enjoy warm.","url":"https://crave.devyy.com/recipes/molten-nutella-lava-cookie-skillet/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Chocolate & Brownies","item":"https://crave.devyy.com/category/chocolate-brownies/"},{"@type":"ListItem","position":3,"name":"Molten Nutella Lava Cookie Skillet","item":"https://crave.devyy.com/recipes/molten-nutella-lava-cookie-skillet/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Molten Nutella Lava Cookie Skillet?","acceptedAnswer":{"@type":"Answer","text":"Molten Nutella Lava Cookie Skillet takes 15 minutes total (5 minutes prep) and yields 4 servings at 460 calories per serving."}},{"@type":"Question","name":"Can I make Molten Nutella Lava Cookie Skillet healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Molten Nutella Lava Cookie Skillet recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
