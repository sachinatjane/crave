10:Tfa7,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/strawberries-romanoff/","name":"Strawberries Romanoff","image":["https://crave.devyy.com/ai-images/strawberries-romanoff.jpg","https://crave.devyy.com/ai-images/strawberries-romanoff.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Russian-inspired strawberries romanoff with 5 measured ingredients — zero sign-up, instant Cook Mode. Ready in 8 mins (4 servings). 4.7★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT8M","cookTime":"PT0M","totalTime":"PT8M","recipeYield":"4 servings","recipeCategory":"Global Classics","recipeCuisine":"Russian","keywords":"Strawberries Romanoff, Russian, Global Classics, #StrawberriesR, #CraveMadeMeDoIt, #ViralDesserts, #RussianSweets","nutrition":{"@type":"NutritionInformation","calories":"405 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.7,"reviewCount":92},"recipeIngredient":["2 pint Strawberries","4 tbs Sugar","4 tbs Grand Marnier","1 cup Cream","0.25 cup Sour Cream"],"recipeInstructions":[{"@type":"HowToStep","name":"Chill Until Firmly Set","text":"In a medium bowl, combine hulled and quartered strawberries, 4 Tbsp sugar and 4 Tbsp liqueur, stir to combine then cover and refrigerate at least 1 hour and up to 2 hours, stirring once or twice. Incorporate 2 pint strawberries, 4 tbs sugar, 4 tbs grand marnier, and 1 cup cream smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/strawberries-romanoff/#step-1"},{"@type":"HowToStep","name":"Fold In Flavorings & Mix-Ins","text":"Two photos of cut strawberries in a bowl with one having sugar being added to the bowl Two photos of cut up strawberries for Strawberry Romanoff. Incorporate 0.25 cup sour cream smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/strawberries-romanoff/#step-2"},{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Just before serving, in a large mixing bowl, combine 1 cup cold heavy cream and 1/4 cup powdered sugar, and beat with an electric mixer until stiff peaks form. Using a spatula, fold in 1/4 cup sour cream just until well blended.","url":"https://crave.devyy.com/recipes/strawberries-romanoff/#step-3"},{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"To serve, stir strawberries then divide between 6 serving glasses or bowls. You can spoon a little syrup over the berries if you like. You can also use this syrup to soak a cake. Spoon cream over strawberries, dividing evenly. You can also use an ice cream scoop with trigger release for a nice rounded puff of cream. Serve right away or chill and enjoy within 2 hours of assembly.","url":"https://crave.devyy.com/recipes/strawberries-romanoff/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"Strawberries Romanoff","item":"https://crave.devyy.com/recipes/strawberries-romanoff/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Strawberries Romanoff?","acceptedAnswer":{"@type":"Answer","text":"Strawberries Romanoff takes 8 minutes total (8 minutes prep) and yields 4 servings at 405 calories per serving."}},{"@type":"Question","name":"Can I make Strawberries Romanoff healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Strawberries Romanoff recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
