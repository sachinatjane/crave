10:Tfff,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/microwave-cinnamon-roll-mug-cake/","name":"Microwave Cinnamon Roll Mug Cake","image":["https://crave.devyy.com/ai-images/microwave-cinnamon-roll-mug-cake.jpg","https://crave.devyy.com/ai-images/microwave-cinnamon-roll-mug-cake.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@mugmagic"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Warm fluffy bakery cinnamon roll in a coffee mug in literally 90 seconds of microwave time. Ready in 5 mins (1 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT3M","cookTime":"PT2M","totalTime":"PT5M","recipeYield":"1 servings","recipeCategory":"Cakes & Mug Cakes","recipeCuisine":"American","keywords":"Microwave Cinnamon Roll Mug Cake, American, Cakes & Mug Cakes, #MugCake, #2MinDessert, #CinnamonRoll, #CraveMadeMeDoIt","nutrition":{"@type":"NutritionInformation","calories":"290 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":490},"recipeIngredient":["4 tbsp Self-rising flour (or flour + 1/4 tsp baking powder)","3 tbsp Whole milk or oat milk","1.5 tbsp Brown sugar + ground cinnamon swirl"],"recipeInstructions":[{"@type":"HowToStep","name":"Grease Mug & Measure Base","text":"Lightly coat a wide, microwave-safe mug or ramekin with a thin swipe of oil or butter so the cake releases cleanly. Measure 4 tbsp self-rising flour (or flour + 1/4 tsp baking powder) and 3 tbsp whole milk or oat milk right into the mug and whisk with a fork until completely smooth.","url":"https://crave.devyy.com/recipes/microwave-cinnamon-roll-mug-cake/#step-1"},{"@type":"HowToStep","name":"Mix Batter Right in Your Mug","text":"Whisk 4 tbsp self-rising flour (or flour + 1/4 tsp baking powder), 3 tbsp whole milk or oat milk, and 1 tbsp melted butter in a microwave-safe mug until lump-free. Keep 4 tbsp self-rising flour (or flour + 1/4 tsp baking powder) and 3 tbsp whole milk or oat milk prepped and measured within reach so each step comes together smoothly and evenly.","url":"https://crave.devyy.com/recipes/microwave-cinnamon-roll-mug-cake/#step-2"},{"@type":"HowToStep","name":"Swirl Cinnamon & Microwave 75 Seconds","text":"Swirl 1.5 tbsp brown sugar + ground cinnamon swirl into the center with a toothpick. Microwave 75 seconds until pillowy, then drizzle cream cheese icing while steaming.","url":"https://crave.devyy.com/recipes/microwave-cinnamon-roll-mug-cake/#step-3"},{"@type":"HowToStep","name":"Rest 1 Minute & Add Toppings","text":"Let the mug rest 60 seconds after microwaving so the steam settles and the center finishes setting into a tender, spoonable crumb. Top with 1.5 tbsp brown sugar + ground cinnamon swirl and enjoy warm right from the mug.","url":"https://crave.devyy.com/recipes/microwave-cinnamon-roll-mug-cake/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Cakes & Mug Cakes","item":"https://crave.devyy.com/category/cakes-cupcakes/"},{"@type":"ListItem","position":3,"name":"Microwave Cinnamon Roll Mug Cake","item":"https://crave.devyy.com/recipes/microwave-cinnamon-roll-mug-cake/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Microwave Cinnamon Roll Mug Cake?","acceptedAnswer":{"@type":"Answer","text":"Microwave Cinnamon Roll Mug Cake takes 5 minutes total (3 minutes prep) and yields 1 servings at 290 calories per serving."}},{"@type":"Question","name":"Can I make Microwave Cinnamon Roll Mug Cake healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Microwave Cinnamon Roll Mug Cake recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
