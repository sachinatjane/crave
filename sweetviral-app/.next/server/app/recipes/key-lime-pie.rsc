10:T105c,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/key-lime-pie/","name":"Key Lime Pie","image":["https://crave.devyy.com/ai-images/key-lime-pie.jpg","https://crave.devyy.com/ai-images/key-lime-pie.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"United States-inspired key lime pie with 8 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (6 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"6 servings","recipeCategory":"Pies, Tarts & Crumbles","recipeCuisine":"United States","keywords":"Key Lime Pie, United States, Pies, Tarts & Crumbles, #KeyLime, #CraveMadeMeDoIt, #ViralDesserts, #UnitedSweets","nutrition":{"@type":"NutritionInformation","calories":"368 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":247},"recipeIngredient":["1.33 cup Digestive Biscuits","10 tbsp Butter","1.78 cup Condensed Milk","3 whole Egg Yolks","4 whole Lime","1.25 cup Double Cream","1 tbsp Icing Sugar","1 to serve Lime"],"recipeInstructions":[{"@type":"HowToStep","name":"Prep & Mix: Key Lime Pie","text":"Heat the oven to 160C/fan 140C/gas 3. Whizz the biscuits to crumbs in a food processor (or put in a strong plastic bag and bash with a rolling pin). Mix with the melted butter and press into the base and up the sides of a 22cm loose-based tart tin. Bake in the oven for 10 minutes. Remove and cool. Incorporate 1.33 cup digestive biscuits, 10 tbsp butter, 1.78 cup condensed milk, and 3 whole egg yolks smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/key-lime-pie/#step-1"},{"@type":"HowToStep","name":"Build Flavor: Key Lime Pie","text":"Put the egg yolks in a large bowl and whisk for a minute with electric beaters. Add the condensed milk and whisk for 3 minutes then add the zest and juice and whisk again for 3 minutes. Pour the filling into the cooled base then put back in the oven for 15 minutes. Cool then chill for at least 3 hours or overnight if you like. Incorporate 4 whole lime, 1.25 cup double cream, 1 tbsp icing sugar, and 1 to serve lime smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/key-lime-pie/#step-2"},{"@type":"HowToStep","name":"Shape & Layer: Key Lime Pie","text":"When you are ready to serve, carefully remove the pie from the tin and put on a serving plate. To decorate, softly whip together the cream and icing sugar. Dollop or pipe the cream onto the top of the pie and finish with extra lime zest.","url":"https://crave.devyy.com/recipes/key-lime-pie/#step-3"},{"@type":"HowToStep","name":"Cool Completely, Garnish & Serve","text":"Transfer Key Lime Pie to a wire cooling rack and let it cool for 15–20 minutes so the interior sets cleanly without crumbling. Lift out using the parchment overhang, garnish as desired, and slice into 6 portions.","url":"https://crave.devyy.com/recipes/key-lime-pie/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Pies, Tarts & Crumbles","item":"https://crave.devyy.com/category/pies-tarts/"},{"@type":"ListItem","position":3,"name":"Key Lime Pie","item":"https://crave.devyy.com/recipes/key-lime-pie/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Key Lime Pie?","acceptedAnswer":{"@type":"Answer","text":"Key Lime Pie takes 45 minutes total (15 minutes prep) and yields 6 servings at 368 calories per serving."}},{"@type":"Question","name":"Can I make Key Lime Pie healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Key Lime Pie recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
