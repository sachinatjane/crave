.","durationMin":30,"timerSeconds":1800,"activeMeasureSummary":"Lime, Double Cream","criticalTip":"Let set for 5–10 minutes before slicing or plating so the textures hold crisp and photogenic!","creatorSecret":"Chill the filled crust 10 minutes before baking—cold butter hits the hot oven and puffs into extra-flaky layers."},{"stepNumber":4,"phaseLabel":"Cool & Slice","title":"Cool Completely, Garnish & Serve","instructionTemplate":"Transfer Key Lime Pie to a wire cooling rack and let it cool for 15–20 minutes so the interior sets cleanly without crumbling. Lift out using the parchment overhang, garnish as desired, and slice into 6 portions.","durationMin":15,"timerSeconds":900,"activeMeasureSummary":"Cool 15m • 6 Servings"}],"ugcQuotes":[{"id":"muq-52859","handle":"@baker_key-lime","image":"./ai-images/key-lime-pie.jpg","quote":"Followed the scaled metric steps—came out flawless in 45 mins!","rating":5}]}}]
