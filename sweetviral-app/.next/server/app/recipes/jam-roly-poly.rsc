10:T120a,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/jam-roly-poly/","name":"Jam Roly-Poly","image":["https://crave.devyy.com/ai-images/jam-roly-poly.jpg","https://crave.devyy.com/ai-images/jam-roly-poly.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"British-inspired jam roly-poly with 7 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (4 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"4 servings","recipeCategory":"Global Classics","recipeCuisine":"British","keywords":"Jam Roly-Poly, British, Global Classics, #JamRolyPoly, #CraveMadeMeDoIt, #ViralDesserts, #BritishSweets","nutrition":{"@type":"NutritionInformation","calories":"235 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":185},"recipeIngredient":["3.3 tbsp Butter","1.11 cup Self-raising Flour","1 pc Vanilla","3.3 tbsp Suet","0.62 cup Milk","6.7 tbsp Raspberry Jam","1 to serve Custard"],"recipeInstructions":[{"@type":"HowToStep","name":"Prep & Mix: Jam Roly-Poly","text":"Put a deep roasting tin onto the bottom shelf of the oven, and make sure that there’s another shelf directly above it. Pull the roasting tin out on its shelf, fill two-thirds with boiling water from the kettle, then carefully slide it back in. Heat oven to 180C/160C fan/gas 4. Tear off a large sheet of foil and greaseproof paper (about 30 x 40cm). Sit the greaseproof on top of the foil and butter it. Incorporate 3.3 tbsp butter, 1.11 cup self-raising flour, 1 pc vanilla, and 3.3 tbsp suet smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/jam-roly-poly/#step-1"},{"@type":"HowToStep","name":"Build Flavor: Jam Roly-Poly","text":"Tip butter, flour and vanilla seeds into a food processor; pulse until the butter has disappeared. Tip into a mixing bowl. Stir through the suet, pour in the milk and work together with a cutlery knife until you get a sticky dough. You may need a drop more milk, depending on your flour. Incorporate 0.62 cup milk, 6.7 tbsp raspberry jam, and 1 to serve custard smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/jam-roly-poly/#step-2"},{"@type":"HowToStep","name":"Shape & Layer: Jam Roly-Poly","text":"Tip the dough out onto a floured surface, quickly pat together to smooth, then roll out to a square roughly 25 x 25cm. Spread the jam all over, leaving a gap along one edge, then roll up from the opposite edge. Pinch the jam-free edge into the dough where it meets, and pinch the ends roughly, too. Carefully lift onto the greased paper, join-side down (you might find a flat baking sheet helpful for this), loosely bring up the paper and foil around it, then scrunch together along the edges and ends to seal. The roly-poly will puff quite a bit during cooking so don’t wrap it tightly. Lift the parcel directly onto the rack above the tin and cook for 1 hr.","url":"https://crave.devyy.com/recipes/jam-roly-poly/#step-3"},{"@type":"HowToStep","name":"Bake / Chill: Jam Roly-Poly","text":"Let the pudding sit for 5 mins before unwrapping, then carefully open the foil and paper, and thickly slice to serve. Plate into 4 generous servings while the flavors and textures are at their peak, and store any leftovers covered.","url":"https://crave.devyy.com/recipes/jam-roly-poly/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"Jam Roly-Poly","item":"https://crave.devyy.com/recipes/jam-roly-poly/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Jam Roly-Poly?","acceptedAnswer":{"@type":"Answer","text":"Jam Roly-Poly takes 45 minutes total (15 minutes prep) and yields 4 servings at 235 calories per serving."}},{"@type":"Question","name":"Can I make Jam Roly-Poly healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Jam Roly-Poly recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
