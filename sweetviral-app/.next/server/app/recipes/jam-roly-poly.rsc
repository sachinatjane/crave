"children":[["$","h3",null,{"children":"Shape & Layer: Jam Roly-Poly"}],["$","p",null,{"children":"Tip the dough out onto a floured surface, quickly pat together to smooth, then roll out to a square roughly 25 x 25cm. Spread the jam all over, leaving a gap along one edge, then roll up from the opposite edge. Pinch the jam-free edge into the dough where it meets, and pinch the ends roughly, too. Carefully lift onto the greased paper, join-side down (you might find a flat baking sheet helpful for this), loosely bring up the paper and foil around it, then scrunch together along the edges and ends to seal. The roly-poly will puff quite a bit during cooking so don’t wrap it tightly. Lift the parcel directly onto the rack above the tin and cook for 1 hr."}]]}],["$","li","4",{"children":[["$","h3",null,{"children":"Bake / Chill: Jam Roly-Poly"}],["$","p",null,{"children":"Let the pudding sit for 5 mins before unwrapping, then carefully open the foil and paper, and thickly slice to serve. Plate into 4 generous servings while the flavors and textures are at their peak, and store any leftovers covered."}]]}]]}],["$","ul",null,{"children":[["$","li","viral-4",{"children":["$","a",null,{"href":"/recipes/crispy-pistachio-kunafa-cheese-roll/","children":"Crispy Pistachio Kunafa Cheese Roll"}]}],["$","li","viral-14",{"children":["$","a",null,{"href":"/recipes/thai-coconut-mango-sticky-rice-parfait/","children":"Thai Coconut Mango Sticky Rice Parfait"}]}],["$","li","viral-17",{"children":["$","a",null,{"href":"/recipes/cardamom-saffron-rasmalai-milk-cake/","children":"Cardamom Saffron Rasmalai Milk Cake"}]}],["$","li","viral-18",{"children":["$","a",null,{"href":"/recipes/warm-honey-cardamom-gulab-jamun/","children":"Warm Honey Cardamom Gulab Jamun"}]}],["$","li","mdb-53120",{"children":"$L13"}],"$L14"]}]]}]}]
