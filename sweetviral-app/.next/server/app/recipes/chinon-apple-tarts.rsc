10:T122e,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/chinon-apple-tarts/","name":"Chinon Apple Tarts","image":["https://crave.devyy.com/ai-images/chinon-apple-tarts.jpg","https://crave.devyy.com/ai-images/chinon-apple-tarts.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"France-inspired chinon apple tarts with 7 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (6 servings). 4.7★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"6 servings","recipeCategory":"Pies, Tarts & Crumbles","recipeCuisine":"France","keywords":"Chinon Apple Tarts, France, Pies, Tarts & Crumbles, #ChinonApple, #CraveMadeMeDoIt, #ViralDesserts, #FranceSweets","nutrition":{"@type":"NutritionInformation","calories":"269 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.7,"reviewCount":47},"recipeIngredient":["1.42 cup Puff Pastry","4 tbs Dark Brown Soft Sugar","3 whole Braeburn Apples","4 tbs Red Wine Jelly","6.7 tbsp Creme Fraiche","1 tbs Icing Sugar","3 whole Cardamom"],"recipeInstructions":[{"@type":"HowToStep","name":"Simmer & Dissolve Smoothly","text":"To make the red wine jelly, put the red wine, jam sugar, star anise, clove, cinnamon stick, allspice, split vanilla pod and seeds in a medium saucepan. Stir together, then heat gently to dissolve the sugar. Turn up the heat and boil for 20 mins until reduced and syrupy. Strain into a small, sterilised jam jar and leave to cool completely. Will keep in the fridge for up to 1 month. Incorporate 1.42 cup puff pastry, 4 tbs dark brown soft sugar, 3 whole braeburn apples, and 4 tbs red wine jelly smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/chinon-apple-tarts/#step-1"},{"@type":"HowToStep","name":"Fold In Flavorings & Mix-Ins","text":"Take the pastry out of the fridge and leave at room temperature for 10 mins, then unroll. Heat the grill to high and heat the oven to 180C/160C fan/gas 4. Cut out 2 x 13cm circles of pastry, using a plate as a guide, and place on a non-stick baking sheet. Sprinkle each circle with 1 tbsp sugar and grill for 5 mins to caramelise, watching carefully so that the sugar doesn’t burn. Remove from the grill. Can be done a few hours ahead, and left, covered, out of the fridge. Incorporate 6.7 tbsp creme fraiche, 1 tbs icing sugar, and 3 whole cardamom smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/chinon-apple-tarts/#step-2"},{"@type":"HowToStep","name":"Portion, Shape & Layer Evenly","text":"Peel, quarter and core the apples, cut into 2mm-thin slices and arrange on top of the pastry. Sprinkle over the remaining sugar and pop in the oven for 20-25 mins until the pastry is cooked through and golden, and the apples are softened. Remove and allow to cool slightly. Warm 3 tbsp of the red wine jelly in a small pan over a low heat with 1 tsp water to make it a little more runny, then brush over the top of the tarts.","url":"https://crave.devyy.com/recipes/chinon-apple-tarts/#step-3"},{"@type":"HowToStep","name":"Sift & Whisk Dry Ingredients","text":"Tip the crème fraîche into a bowl, sift over the icing sugar and cardamom, and mix together. Carefully lift the warm tarts onto serving plates and serve with the cardamom crème fraîche.","url":"https://crave.devyy.com/recipes/chinon-apple-tarts/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Pies, Tarts & Crumbles","item":"https://crave.devyy.com/category/pies-tarts/"},{"@type":"ListItem","position":3,"name":"Chinon Apple Tarts","item":"https://crave.devyy.com/recipes/chinon-apple-tarts/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Chinon Apple Tarts?","acceptedAnswer":{"@type":"Answer","text":"Chinon Apple Tarts takes 45 minutes total (15 minutes prep) and yields 6 servings at 269 calories per serving."}},{"@type":"Question","name":"Can I make Chinon Apple Tarts healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Chinon Apple Tarts recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
