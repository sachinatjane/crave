10:T10b6,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/crispy-pistachio-kunafa-cheese-roll/","name":"Crispy Pistachio Kunafa Cheese Roll","image":["https://crave.devyy.com/ai-images/crispy-pistachio-kunafa-cheese-roll.jpg","https://crave.devyy.com/ai-images/crispy-pistachio-kunafa-cheese-roll.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_kitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Golden buttered kataifi rolled around stretchy mozzarella & drenched in blossom syrup. Ready in 28 mins (6 servings). 5.0★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT10M","cookTime":"PT18M","totalTime":"PT28M","recipeYield":"6 servings","recipeCategory":"Global Classics","recipeCuisine":"Middle Eastern","keywords":"Crispy Pistachio Kunafa Cheese Roll, Middle Eastern, Global Classics, #KunafaRoll, #CraveMadeMeDoIt, #ViralDesserts, #MiddleSweets","nutrition":{"@type":"NutritionInformation","calories":"380 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":5,"reviewCount":142},"recipeIngredient":["8 oz Fresh shredded kataifi pastry","0.33 cup Melted ghee or clarified butter","6 oz Low-moisture unsalted mozzarella","0.33 cup Crushed roasted pistachios","0.5 cup Warm honey-rosewater syrup"],"recipeInstructions":[{"@type":"HowToStep","name":"Preheat Air Fryer & Measure Ingredients","text":"Preheat your air fryer to 330°F (165°C) for 3 minutes and line the basket with perforated parchment or a light oil mist. Measure out 8 oz fresh shredded kataifi pastry, 0.33 cup melted ghee or clarified butter, and 6 oz low-moisture unsalted mozzarella in a mixing bowl so they combine evenly.","url":"https://crave.devyy.com/recipes/crispy-pistachio-kunafa-cheese-roll/#step-1"},{"@type":"HowToStep","name":"Wrap Stretchy Cheese in Kataifi","text":"Toss 8 oz fresh shredded kataifi pastry with 0.33 cup melted ghee or clarified butter, lay flat strips, place sticks of 6 oz low-moisture unsalted mozzarella inside, and roll tightly into golden cylinders. Keep 8 oz fresh shredded kataifi pastry, 0.33 cup melted ghee or clarified butter, and 6 oz low-moisture unsalted mozzarella prepped and measured within reach so each step comes together smoothly and evenly.","url":"https://crave.devyy.com/recipes/crispy-pistachio-kunafa-cheese-roll/#step-2"},{"@type":"HowToStep","name":"Bake Until Amber & Pour Syrup","text":"Bake or air-fry at 390°F (200°C) for 18 minutes until crackling amber. Immediately pour cool 0.5 cup warm honey-rosewater syrup over hot rolls and scatter 0.33 cup crushed roasted pistachios.","url":"https://crave.devyy.com/recipes/crispy-pistachio-kunafa-cheese-roll/#step-3"},{"@type":"HowToStep","name":"Rest 5 Minutes & Serve Warm","text":"Carefully lift Crispy Pistachio Kunafa Cheese Roll out of the air-fryer basket and rest 5 minutes on a cooling rack so the crust crisps up. Plate into 6 servings and enjoy warm.","url":"https://crave.devyy.com/recipes/crispy-pistachio-kunafa-cheese-roll/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"Crispy Pistachio Kunafa Cheese Roll","item":"https://crave.devyy.com/recipes/crispy-pistachio-kunafa-cheese-roll/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Crispy Pistachio Kunafa Cheese Roll?","acceptedAnswer":{"@type":"Answer","text":"Crispy Pistachio Kunafa Cheese Roll takes 28 minutes total (10 minutes prep) and yields 6 servings at 380 calories per serving."}},{"@type":"Question","name":"Can I make Crispy Pistachio Kunafa Cheese Roll healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Crispy Pistachio Kunafa Cheese Roll recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
