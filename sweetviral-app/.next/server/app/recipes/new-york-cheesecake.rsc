10:T16c7,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/new-york-cheesecake/","name":"New York cheesecake","image":["https://crave.devyy.com/ai-images/new-york-cheesecake.jpg","https://crave.devyy.com/ai-images/new-york-cheesecake.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"United States-inspired new york cheesecake with 12 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (6 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"6 servings","recipeCategory":"Cheesecake & Tiramisu","recipeCuisine":"United States","keywords":"New York cheesecake, United States, Cheesecake & Tiramisu, #NewYork, #CraveMadeMeDoIt, #ViralDesserts, #UnitedSweets","nutrition":{"@type":"NutritionInformation","calories":"257 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":164},"recipeIngredient":["5.7 tbsp Butter","9.3 tbsp Sour Cream","1 tbsp Sugar","4 cup Cream Cheese","1.11 cup Caster Sugar","3 tbs Plain Flour","1 tsp Lemon Juice","3 pcs Eggs","1.04 cup Sour Cream","0.62 cup Sour Cream","1 tbsp Caster Sugar","2 tsp Lemon Juice"],"recipeInstructions":[{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Position an oven shelf in the middle of the oven. Preheat the oven to fan 160C/conventional 180C/gas 4. Line the base of a 23cm springform cake tin with parchment paper. For the crust, melt the butter in a medium pan. Stir in the biscuit crumbs and sugar so the mixture is evenly moistened. Press the mixture into the bottom of the pan and bake for 10 minutes. Cool on a wire rack while preparing the filling. For the filling, increase the oven temperature to fan 200C/conventional 240C/gas 9. In a table top mixer fitted with the paddle attachment, beat the soft cheese at medium-low speed until creamy, about 2 minutes. With the mixer on low, gradually add the sugar, then the flour and a pinch of salt, scraping down the sides of the bowl and the paddle twice. Incorporate 5.7 tbsp butter, 9.3 tbsp sour cream, 1 tbsp sugar, and 4 cup cream cheese smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/new-york-cheesecake/#step-1"},{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Swap the paddle attachment for the whisk. Continue by adding the vanilla, lemon zest and juice. Whisk in the eggs and yolk, one at a time, scraping the bowl and whisk at least twice. Stir the 284ml carton of soured cream until smooth, then measure 200ml/7fl oz (just over 3⁄4 of the carton). Continue on low speed as you add the measured soured cream (reserve the rest). Whisk to blend, but don't over-beat. The batter should be smooth, light and somewhat airy. Brush the sides of the springform tin with melted butter and put on a baking sheet. Pour in the filling - if there are any lumps, sink them using a knife - the top should be as smooth as possible. Bake for 10 minutes. Reduce oven temperature to fan 90C/conventional 110C/gas 1⁄4 and bake for 25 minutes more. If you gently shake the tin, the filling should have a slight wobble. Turn off the oven and open the oven door for a cheesecake that's creamy in the centre, or leave it closed if you prefer a drier texture. Let cool in the oven for 2 hours. The cheesecake may get a slight crack on top as it cools. Incorporate 1.11 cup caster sugar, 3 tbs plain flour, 1 tsp lemon juice, 3 pcs eggs, 1.04 cup sour cream, 0.62 cup sour cream, 1 tbsp caster sugar, and 2 tsp lemon juice smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/new-york-cheesecake/#step-2"},{"@type":"HowToStep","name":"Bake New York cheesecake & Check Doneness","text":"Bake for 30 minutes until the edges turn golden and set while the center remains tender. Test with a toothpick—if it comes out with a few moist crumbs rather than wet batter, it is ready.","url":"https://crave.devyy.com/recipes/new-york-cheesecake/#step-3"},{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Combine the reserved soured cream with the 142ml carton, the sugar and lemon juice for the topping. Spread over the cheesecake right to the edges. Cover loosely with foil and refrigerate for at least 8 hours or overnight. Run a round-bladed knife around the sides of the tin to loosen any stuck edges. Unlock the side, slide the cheesecake off the bottom of the tin onto a plate, then slide the parchment paper out from underneath.","url":"https://crave.devyy.com/recipes/new-york-cheesecake/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Cheesecake & Tiramisu","item":"https://crave.devyy.com/category/cheesecake-tiramisu/"},{"@type":"ListItem","position":3,"name":"New York cheesecake","item":"https://crave.devyy.com/recipes/new-york-cheesecake/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make New York cheesecake?","acceptedAnswer":{"@type":"Answer","text":"New York cheesecake takes 45 minutes total (15 minutes prep) and yields 6 servings at 257 calories per serving."}},{"@type":"Question","name":"Can I make New York cheesecake healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this New York cheesecake recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
