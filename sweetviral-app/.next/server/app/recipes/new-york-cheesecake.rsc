17:T4c6,Swap the paddle attachment for the whisk. Continue by adding the vanilla, lemon zest and juice. Whisk in the eggs and yolk, one at a time, scraping the bowl and whisk at least twice. Stir the 284ml carton of soured cream until smooth, then measure 200ml/7fl oz (just over 3⁄4 of the carton). Continue on low speed as you add the measured soured cream (reserve the rest). Whisk to blend, but don't over-beat. The batter should be smooth, light and somewhat airy. Brush the sides of the springform tin with melted butter and put on a baking sheet. Pour in the filling - if there are any lumps, sink them using a knife - the top should be as smooth as possible. Bake for 10 minutes. Reduce oven temperature to fan 90C/conventional 110C/gas 1⁄4 and bake for 25 minutes more. If you gently shake the tin, the filling should have a slight wobble. Turn off the oven and open the oven door for a cheesecake that's creamy in the centre, or leave it closed if you prefer a drier texture. Let cool in the oven for 2 hours. The cheesecake may get a slight crack on top as it cools. Incorporate {m52858_5}, {m52858_6}, {m52858_7}, {m52858_8}, {m52858_9}, {m52858_10}, {m52858_11}, and {m52858_12} smoothly until evenly distributed.12:["$","$L16",null,{"initialRecipeSlug":"new-york-cheesecake","initialRecipe":{"id":"mdb-52858","slug":"new-york-cheesecake","title":"New York cheesecake","shortTag":"New York","storyViews":"88K","viewsLabel":"88K Views","viewsNumeric":88.6,"remakeSuccessRate":"97.3%","rating":4.9,"ratingCount":"164","prepMin":15,"bakeMin":30,"totalMin":45,"skill":"Easy","baseServings":6,"kcal":257,"zeroMixer":false,"cuisine":"United States","dessertCategory":"cheesecake-tiramisu","primaryPlatform":"tiktok","platforms":["tiktok","instagram","pinterest"],"categories":["all"],"soundName":"creamy slice jiggle","badgeChip":"United States Hit","creatorHandle":"@crave_testkitchen","hookLine":"United States-inspired new york cheesecake with 12 measured ingredients — zero sign-up, instant Cook Mode.","heroImage":"./ai-images/new-york-cheesecake.jpg","thumbImage":"./ai-images/new-york-cheesecake.jpg","pinterestImage":"./ai-images/new-york-cheesecake.jpg","hashtags":["#NewYork","#CraveMadeMeDoIt","#ViralDesserts","#UnitedSweets"],"pantryCore":["butter","milk","sugar","cream_cheese","flour","lemon","eggs"],"ingredientGroups":[{"title":"Primary Base Ingredients","badge":"United States Style","tone":"tertiary","items":[{"id":"m52858_1","name":"Butter","baseAmount":5.7,"usUnit":"tbsp","metricAmount":85,"metricUnit":"g","pantryKey":"butter","stepRef":1},{"id":"m52858_2","name":"Sour Cream","baseAmount":9.3,"usUnit":"tbsp","metricAmount":140,"metricUnit":"g","pantryKey":"milk","stepRef":1},{"id":"m52858_3","name":"Sugar","baseAmount":1,"usUnit":"tbsp","metricAmount":15,"metricUnit":"g","pantryKey":"sugar","stepRef":1},{"id":"m52858_4","name":"Cream Cheese","baseAmount":4,"usUnit":"cup","metricAmount":900,"metricUnit":"g","pantryKey":"cream_cheese","stepRef":1},{"id":"m52858_5","name":"Caster Sugar","baseAmount":1.11,"usUnit":"cup","metricAmount":250,"metricUnit":"g","pantryKey":"sugar","stepRef":2},{"id":"m52858_6","name":"Plain Flour","baseAmount":3,"usUnit":"tbs","metricAmount":3,"metricUnit":"tbs","pantryKey":"flour","stepRef":2}]},{"title":"Flavor, Glaze & Finish","badge":"Signature Touch","tone":"primary","items":[{"id":"m52858_7","name":"Lemon Juice","baseAmount":1,"usUnit":"tsp","metricAmount":5,"metricUnit":"g","pantryKey":"lemon","stepRef":2},{"id":"m52858_8","name":"Eggs","baseAmount":3,"usUnit":"pcs","metricAmount":3,"metricUnit":"pcs","pantryKey":"eggs","stepRef":2},{"id":"m52858_9","name":"Sour Cream","baseAmount":1.04,"usUnit":"cup","metricAmount":250,"metricUnit":"ml","pantryKey":"milk","stepRef":2},{"id":"m52858_10","name":"Sour Cream","baseAmount":0.62,"usUnit":"cup","metricAmount":150,"metricUnit":"ml","pantryKey":"milk","stepRef":2},{"id":"m52858_11","name":"Caster Sugar","baseAmount":1,"usUnit":"tbsp","metricAmount":15,"metricUnit":"g","pantryKey":"sugar","stepRef":2},{"id":"m52858_12","name":"Lemon Juice","baseAmount":2,"usUnit":"tsp","metricAmount":10,"metricUnit":"g","pantryKey":"lemon","stepRef":2}]}],"steps":[{"stepNumber":1,"phaseLabel":"Prep & Mix","title":"Cream Butter & Sugar Fluffy","instructionTemplate":"Position an oven shelf in the middle of the oven. Preheat the oven to fan 160C/conventional 180C/gas 4. Line the base of a 23cm springform cake tin with parchment paper. For the crust, melt the butter in a medium pan. Stir in the biscuit crumbs and sugar so the mixture is evenly moistened. Press the mixture into the bottom of the pan and bake for 10 minutes. Cool on a wire rack while preparing the filling. For the filling, increase the oven temperature to fan 200C/conventional 240C/gas 9. In a table top mixer fitted with the paddle attachment, beat the soft cheese at medium-low speed until creamy, about 2 minutes. With the mixer on low, gradually add the sugar, then the flour and a pinch of salt, scraping down the sides of the bowl and the paddle twice. Incorporate {m52858_1}, {m52858_2}, {m52858_3}, and {m52858_4} smoothly until evenly distributed.","durationMin":5,"timerSeconds":300,"activeMeasureSummary":"Butter, Sour Cream","creatorSecret":"Prep and measure butter first—mise en place makes this dessert twice as fast."},{"stepNumber":2,"phaseLabel":"Build Flavor","title":"Cream Butter & Sugar Fluffy","instructionTemplate":"$17","durationMin":5,"timerSeconds":300,"activeMeasureSummary":"Sugar, Cream Cheese"},{"stepNumber":3,"phaseLabel":"Bake & Check","title":"Bake New York cheesecake & Check Doneness","instructionTemplate":"Bake for 30 minutes until the edges turn golden and set while the center remains tender. Test with a toothpick—if it comes out with a few moist crumbs rather than wet batter, it is ready.","durationMin":30,"timerSeconds":1800,"activeMeasureSummary":"Bake 30m • Toothpick Check"},{"stepNumber":4,"phaseLabel":"Shape & Layer","title":"Cream Butter & Sugar Fluffy","instructionTemplate":"Combine the reserved soured cream with the 142ml carton, the sugar and lemon juice for the topping. Spread over the cheesecake right to the edges. Cover loosely with foil and refrigerate for at least 8 hours or overnight. Run a round-bladed knife around the sides of the tin to loosen any stuck edges. Unlock the side, slide the cheesecake off the bottom of the tin onto a plate, then slide the parchment paper out from underneath.","durationMin":30,"timerSeconds":1800,"activeMeasureSummary":"Caster Sugar, Plain Flour","criticalTip":"Let set for 5–10 minutes before slicing or plating so the textures hold crisp and photogenic!","creatorSecret":"Dip a sharp knife in hot water and wipe dry between every cut for razor-clean cafe slices."}],"ugcQuotes":[{"id":"muq-52858","handle":"@baker_new-york","image":"./ai-images/new-york-cheesecake.jpg","quote":"Followed the scaled metric steps—came out flawless in 45 mins!","rating":5}]}}]
14:["$","li","4",{"children":[["$","h3",null,{"children":"Cream Butter & Sugar Fluffy"}],["$","p",null,{"children":"Combine the reserved soured cream with the 142ml carton, the sugar and lemon juice for the topping. Spread over the cheesecake right to the edges. Cover loosely with foil and refrigerate for at least 8 hours or overnight. Run a round-bladed knife around the sides of the tin to loosen any stuck edges. Unlock the side, slide the cheesecake off the bottom of the tin onto a plate, then slide the parchment paper out from underneath."}]]}]
