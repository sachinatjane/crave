10:T10af,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/portuguese-pastel-de-nata-custard-tarts/","name":"Portuguese Pastel de Nata Custard Tarts","image":["https://crave.devyy.com/ai-images/portuguese-pastel-de-nata-custard-tarts.jpg","https://crave.devyy.com/ai-images/portuguese-pastel-de-nata-custard-tarts.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_kitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Shattering puff pastry spirals cradling silky lemon-cinnamon vanilla custard with caramelized blisters. Ready in 26 mins (12 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT12M","cookTime":"PT14M","totalTime":"PT26M","recipeYield":"12 servings","recipeCategory":"Pies, Tarts & Crumbles","recipeCuisine":"Portuguese","keywords":"Portuguese Pastel de Nata Custard Tarts, Portuguese, Pies, Tarts & Crumbles, #PastelNata, #CraveMadeMeDoIt, #ViralDesserts, #PortugueseSweets","nutrition":{"@type":"NutritionInformation","calories":"210 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":427},"recipeIngredient":["1 sheet All-butter puff pastry sheet","1.5 cups Whole milk + 4 egg yolks + 1/2 cup sugar + 2 tbsp cornstarch","1 each Cinnamon stick + lemon peel strip"],"recipeInstructions":[{"@type":"HowToStep","name":"Set Up Heavy Saucepan & Ingredients","text":"Place a heavy-bottomed saucepan over medium-low heat and have a heatproof silicone whisk ready. Measure out 1 sheet all-butter puff pastry sheet and 1.5 cups whole milk + 4 egg yolks + 1/2 cup sugar + 2 tbsp cornstarch and 1 each cinnamon stick + lemon peel strip in advance—stovetop desserts move fast once they start bubbling.","url":"https://crave.devyy.com/recipes/portuguese-pastel-de-nata-custard-tarts/#step-1"},{"@type":"HowToStep","name":"Roll Puff & Press Muffin Cups","text":"Roll 1 sheet all-butter puff pastry sheet into a tight log, slice 12 rounds, and press swirls up the sides of a muffin tin. Keep 1 sheet all-butter puff pastry sheet prepped and measured within reach so each step comes together smoothly and evenly.","url":"https://crave.devyy.com/recipes/portuguese-pastel-de-nata-custard-tarts/#step-2"},{"@type":"HowToStep","name":"Simmer Custard & Bake at 475°F","text":"Whisk 1.5 cups whole milk + 4 egg yolks + 1/2 cup sugar + 2 tbsp cornstarch infused with 1 each cinnamon stick + lemon peel strip until thick, fill pastry cups, and bake at 475°F (245°C) for 13–14 mins until blistered.","url":"https://crave.devyy.com/recipes/portuguese-pastel-de-nata-custard-tarts/#step-3"},{"@type":"HowToStep","name":"Remove from Heat, Cool & Serve","text":"Pull the pan off the heat as soon as Portuguese Pastel de Nata Custard Tarts coats the spoon thickly. Let cool slightly so the glaze or custard thickens even more, then spoon into 12 bowls and garnish before serving.","url":"https://crave.devyy.com/recipes/portuguese-pastel-de-nata-custard-tarts/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Pies, Tarts & Crumbles","item":"https://crave.devyy.com/category/pies-tarts/"},{"@type":"ListItem","position":3,"name":"Portuguese Pastel de Nata Custard Tarts","item":"https://crave.devyy.com/recipes/portuguese-pastel-de-nata-custard-tarts/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Portuguese Pastel de Nata Custard Tarts?","acceptedAnswer":{"@type":"Answer","text":"Portuguese Pastel de Nata Custard Tarts takes 26 minutes total (12 minutes prep) and yields 12 servings at 210 calories per serving."}},{"@type":"Question","name":"Can I make Portuguese Pastel de Nata Custard Tarts healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Portuguese Pastel de Nata Custard Tarts recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
