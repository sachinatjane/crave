10:T1066,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/baked-cinnamon-honey-apples/","name":"Warm Baked Cinnamon Oat-Stuffed Apples","image":["https://crave.devyy.com/ai-images/baked-cinnamon-honey-apples.jpg","https://crave.devyy.com/ai-images/baked-cinnamon-honey-apples.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_healthy"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Tender caramelized apples stuffed with toasted oats, pecans, cinnamon & a drizzle of warm raw honey. Ready in 25 mins (2 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT5M","cookTime":"PT20M","totalTime":"PT25M","recipeYield":"2 servings","recipeCategory":"Healthy & Zero-Sugar","recipeCuisine":"Healthy American","keywords":"Warm Baked Cinnamon Oat-Stuffed Apples, Healthy American, Healthy & Zero-Sugar, #BakedApples, #GuiltFreeCravings, #HealthyDesserts, #CraveMadeMeDoIt","nutrition":{"@type":"NutritionInformation","calories":"170 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":260},"recipeIngredient":["2 apples Crisp Honeycrisp apples (cored)","0.33 cup Rolled oats + chopped pecans + 1 tsp cinnamon","1.5 tbsp Pure maple or raw honey + 1 tsp coconut oil"],"recipeInstructions":[{"@type":"HowToStep","name":"Preheat Air Fryer & Measure Ingredients","text":"Preheat your air fryer to 330°F (165°C) for 3 minutes and line the basket with perforated parchment or a light oil mist. Measure out 2 apples crisp honeycrisp apples (cored) and 0.33 cup rolled oats + chopped pecans + 1 tsp cinnamon in a mixing bowl so they combine evenly.","url":"https://crave.devyy.com/recipes/baked-cinnamon-honey-apples/#step-1"},{"@type":"HowToStep","name":"Stuff Apples & Air Fry 18 Mins","text":"Mix 0.33 cup rolled oats + chopped pecans + 1 tsp cinnamon and 1.5 tbsp pure maple or raw honey + 1 tsp coconut oil, pack into 2 apples crisp honeycrisp apples (cored), and air-fry at 350°F (175°C) for 18–20 minutes until fork-tender and bubbling. Plate into 2 generous servings while the flavors and textures are at their peak, and store any leftovers covered.","url":"https://crave.devyy.com/recipes/baked-cinnamon-honey-apples/#step-2"},{"@type":"HowToStep","name":"Bake Warm Baked Cinnamon Oat-Stuffed Apples & Check Doneness","text":"Bake for 20 minutes until the edges turn golden and set while the center remains tender. Test with a toothpick—if it comes out with a few moist crumbs rather than wet batter, it is ready.","url":"https://crave.devyy.com/recipes/baked-cinnamon-honey-apples/#step-3"},{"@type":"HowToStep","name":"Rest 5 Minutes & Serve Warm","text":"Carefully lift Warm Baked Cinnamon Oat-Stuffed Apples out of the air-fryer basket and rest 5 minutes on a cooling rack so the crust crisps up. Plate into 2 servings and enjoy warm.","url":"https://crave.devyy.com/recipes/baked-cinnamon-honey-apples/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Healthy & Zero-Sugar","item":"https://crave.devyy.com/category/healthy-light/"},{"@type":"ListItem","position":3,"name":"Warm Baked Cinnamon Oat-Stuffed Apples","item":"https://crave.devyy.com/recipes/baked-cinnamon-honey-apples/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Warm Baked Cinnamon Oat-Stuffed Apples?","acceptedAnswer":{"@type":"Answer","text":"Warm Baked Cinnamon Oat-Stuffed Apples takes 25 minutes total (5 minutes prep) and yields 2 servings at 170 calories per serving."}},{"@type":"Question","name":"Can I make Warm Baked Cinnamon Oat-Stuffed Apples healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Warm Baked Cinnamon Oat-Stuffed Apples recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
