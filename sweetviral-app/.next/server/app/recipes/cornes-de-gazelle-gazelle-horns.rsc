10:T1691,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/cornes-de-gazelle-gazelle-horns/","name":"Cornes de Gazelle (Gazelle Horns)","image":["https://crave.devyy.com/ai-images/cornes-de-gazelle-gazelle-horns.jpg","https://crave.devyy.com/ai-images/cornes-de-gazelle-gazelle-horns.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Algerian-inspired cornes de gazelle (gazelle horns) with 13 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (4 servings). 4.7★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"4 servings","recipeCategory":"Global Classics","recipeCuisine":"Algerian","keywords":"Cornes de Gazelle (Gazelle Horns), Algerian, Global Classics, #Cornesde, #CraveMadeMeDoIt, #ViralDesserts, #AlgerianSweets","nutrition":{"@type":"NutritionInformation","calories":"355 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.7,"reviewCount":166},"recipeIngredient":["2 cups Almonds","0.75 cup Sugar","1 tbsp Sugar","0.25 tsp Ground Cinnamon","1 whole Egg","1 tbsp Orange Blossom Water","2 cups All purpose flour","0.5 cup Unsalted Butter","1 pinch Salt","1 beaten Egg","3 tbsp Vegetable Oil","1 tbsp Orange Blossom Water","3 tbsp Pistachio"],"recipeInstructions":[{"@type":"HowToStep","name":"Dip & Coat Evenly","text":"Preheat oven to 300 degrees F (150 degrees C). Line a baking sheet with parchment paper. Spread almonds over the baking sheet. Bake in the preheated oven until almonds are fragrant and roasted, 20 to 25 minutes. Prepare pastry dough while almonds are roasting. Combine flour, 1/2 cup plus 1 tablespoon butter, and salt in a bowl and rub together until the mixture resembles breadcrumbs. Add egg, oil, and 1 1/2 tablespoons orange blossom water; knead everything into a smooth pastry dough. Add a little water, 1 teaspoon at a time, if dough is too dry. Shape pastry dough into a ball, wrap in plastic wrap, and set aside for 30 minutes. Incorporate 2 cups almonds, 0.75 cup sugar, 1 tbsp sugar, and 0.25 tsp ground cinnamon smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/cornes-de-gazelle-gazelle-horns/#step-1"},{"@type":"HowToStep","name":"Shape & Press Dough Evenly","text":"Remove almonds from oven and cool slightly, about 5 minutes. Place almonds in the bowl of a food processor; process until finely and evenly ground. Add 3/4 cup plus 1 tablespoon sugar, cinnamon, egg, and 1 tablespoon orange blossom water in that order to the food processor, pulsing after each addition until mixture is evenly combined and resembles a paste. Remove small walnut-sized portions of filling with greased hands. Roll them into small logs with thin ends. Set aside. Preheat oven to 325 degrees F (165 degrees C). Line a baking sheet with parchment paper. Incorporate 1 whole egg, 1 tbsp orange blossom water, 2 cups all purpose flour, 0.5 cup unsalted butter, 1 pinch salt, 1 beaten egg, 3 tbsp vegetable oil, 1 tbsp orange blossom water, and 3 tbsp pistachio smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/cornes-de-gazelle-gazelle-horns/#step-2"},{"@type":"HowToStep","name":"Bake Cornes de Gazelle (Gazelle Horns) & Check Doneness","text":"Bake for 30 minutes until the edges turn golden and set while the center remains tender. Test with a toothpick—if it comes out with a few moist crumbs rather than wet batter, it is ready.","url":"https://crave.devyy.com/recipes/cornes-de-gazelle-gazelle-horns/#step-3"},{"@type":"HowToStep","name":"Dip & Coat Evenly","text":"Roll out half of the pastry dough on a lightly floured surface until very thin. Place one of the almond paste logs on the edge of the pastry, fold pastry over the filling, covering it completely, and seal the edges. Mold with your fingers into a crescent shape. Using a pastry cutter, cut around the crescent, and transfer to the prepared baking sheet. Repeat with remaining dough and filling. Bake in the preheated oven until gazelle horns are lightly golden and baked through, about 20 minutes. They should not get too dark. Let cool slightly, about 3 minutes. Heat honey in a small saucepan over low-medium heat. Remove from heat and stir in 1 tablespoon orange blossom water. Dip gazelle horns into the honey and place on a serving plate. Sprinkle with crushed pistachios.","url":"https://crave.devyy.com/recipes/cornes-de-gazelle-gazelle-horns/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"Cornes de Gazelle (Gazelle Horns)","item":"https://crave.devyy.com/recipes/cornes-de-gazelle-gazelle-horns/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Cornes de Gazelle (Gazelle Horns)?","acceptedAnswer":{"@type":"Answer","text":"Cornes de Gazelle (Gazelle Horns) takes 45 minutes total (15 minutes prep) and yields 4 servings at 355 calories per serving."}},{"@type":"Question","name":"Can I make Cornes de Gazelle (Gazelle Horns) healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Cornes de Gazelle (Gazelle Horns) recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
