10:T1118,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/3-milk-cloud-tres-leches-cake/","name":"3-Milk Cloud Tres Leches Cake","image":["https://crave.devyy.com/ai-images/3-milk-cloud-tres-leches-cake.jpg","https://crave.devyy.com/ai-images/3-milk-cloud-tres-leches-cake.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_kitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Featherlight sponge soaked in three milks and crowned with vanilla bean chantilly cream. Ready in 40 mins (9 servings). 5.0★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT25M","totalTime":"PT40M","recipeYield":"9 servings","recipeCategory":"Cakes & Mug Cakes","recipeCuisine":"Latin American","keywords":"3-Milk Cloud Tres Leches Cake, Latin American, Cakes & Mug Cakes, #TresLeches, #CraveMadeMeDoIt, #ViralDesserts, #LatinSweets","nutrition":{"@type":"NutritionInformation","calories":"340 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":5,"reviewCount":448},"recipeIngredient":["5 eggs Separated large eggs","1 cup All-purpose flour + 1 tsp baking powder","0.75 cup Granulated sugar","2 cups Evaporated + condensed + whole milk mix","1.5 cups Whipped cream + cinnamon dust"],"recipeInstructions":[{"@type":"HowToStep","name":"Preheat Oven & Prep Your Pan","text":"Preheat your oven to 350°F (175°C) and line your baking pan with parchment paper, leaving a slight overhang for effortless lifting. Measure out 5 eggs separated large eggs, 1 cup all-purpose flour + 1 tsp baking powder, and 0.75 cup granulated sugar so everything is ready and at room temperature for a silky, lump-free batter.","url":"https://crave.devyy.com/recipes/3-milk-cloud-tres-leches-cake/#step-1"},{"@type":"HowToStep","name":"Whip Airy Sponge & Bake 25m","text":"Beat egg yolks + half of 0.75 cup granulated sugar, fold in whipped egg whites and 1 cup all-purpose flour + 1 tsp baking powder. Bake at 350°F (175°C) for 25 minutes. Line your baking pan with parchment paper or grease lightly, and make sure 5 eggs separated large eggs, 1 cup all-purpose flour + 1 tsp baking powder, and 0.75 cup granulated sugar are measured and at room temperature so they blend smoothly.","url":"https://crave.devyy.com/recipes/3-milk-cloud-tres-leches-cake/#step-2"},{"@type":"HowToStep","name":"Pour 3-Milk Blend Over Cake","text":"Poke holes all over cooled sponge with a fork and slowly pour 2 cups evaporated + condensed + whole milk mix until fully absorbed. Chill 2 hours. Mix gently until just combined with no dry streaks remaining, then bake until the edges are golden and a toothpick comes out with moist crumbs.","url":"https://crave.devyy.com/recipes/3-milk-cloud-tres-leches-cake/#step-3"},{"@type":"HowToStep","name":"Frost with Chantilly & Cinnamon","text":"Spread fluffy 1.5 cups whipped cream + cinnamon dust across the top and dust lightly with cinnamon. Let 3-Milk Cloud Tres Leches Cake cool for 10–15 minutes so the crumb sets cleanly before slicing into 9 portions, then garnish and serve.","url":"https://crave.devyy.com/recipes/3-milk-cloud-tres-leches-cake/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Cakes & Mug Cakes","item":"https://crave.devyy.com/category/cakes-cupcakes/"},{"@type":"ListItem","position":3,"name":"3-Milk Cloud Tres Leches Cake","item":"https://crave.devyy.com/recipes/3-milk-cloud-tres-leches-cake/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make 3-Milk Cloud Tres Leches Cake?","acceptedAnswer":{"@type":"Answer","text":"3-Milk Cloud Tres Leches Cake takes 40 minutes total (15 minutes prep) and yields 9 servings at 340 calories per serving."}},{"@type":"Question","name":"Can I make 3-Milk Cloud Tres Leches Cake healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this 3-Milk Cloud Tres Leches Cake recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
