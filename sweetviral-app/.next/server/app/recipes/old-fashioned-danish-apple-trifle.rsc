10:T130a,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/old-fashioned-danish-apple-trifle/","name":"Old-fashioned Danish Apple Trifle","image":["https://crave.devyy.com/ai-images/old-fashioned-danish-apple-trifle.jpg","https://crave.devyy.com/ai-images/old-fashioned-danish-apple-trifle.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Global-inspired old-fashioned danish apple trifle with 9 measured ingredients — zero sign-up, instant Cook Mode. Ready in 15 mins (4 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT0M","totalTime":"PT15M","recipeYield":"4 servings","recipeCategory":"Pastries & Donuts","recipeCuisine":"Global","keywords":"Old-fashioned Danish Apple Trifle, Global, Pastries & Donuts, #Oldfashioned, #CraveMadeMeDoIt, #ViralDesserts, #GlobalSweets","nutrition":{"@type":"NutritionInformation","calories":"339 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":43},"recipeIngredient":["3.56 cup Cooking Apples","0.25 cup Water","1 tsp Vanilla Powder","1 tbsp Lemon Juice","4 tbsp Sugar","3.3 tbsp Butter","6.7 tbsp Breadcrumbs","3.3 tbsp Sugar","0.75 cup Double Cream"],"recipeInstructions":[{"@type":"HowToStep","name":"Dip & Coat Evenly","text":"Peel and cut the apples into cubes. Discard the cores. Transfer apple cubes to a saucepan with water, vanilla and lemon juice. Bring apples to a boil, cover and reduce heat to medium-low. Add the sugar to taste after the apples release their juices. The amount of sugar depends on the tartness of the apples and your preferred level of sweetness. Remember that the breadcrumb mixture and whipped cream are also sweet, so it is okay if the apple sauce is still a bit tart. Cook the apples for about 15 minutes until you have a coarse apple sauce. If you prefer, cook the apples longer for a finer consistency. Incorporate 3.56 cup cooking apples, 0.25 cup water, 1 tsp vanilla powder, and 1 tbsp lemon juice smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/old-fashioned-danish-apple-trifle/#step-1"},{"@type":"HowToStep","name":"Dip & Coat Evenly","text":"Refrigerate the applesauce. Breadcrumbs mixture: Melt butter in a pan. The butter must not brown. Add breadcrumbs and sugar and stir to combine. Incorporate 4 tbsp sugar, 3.3 tbsp butter, 6.7 tbsp breadcrumbs, 3.3 tbsp sugar, and 0.75 cup double cream smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/old-fashioned-danish-apple-trifle/#step-2"},{"@type":"HowToStep","name":"Dip & Coat Evenly","text":"Slowly toast the mixture as you stir with a spatula. Do not heat the mixture for too long – it only takes a short time to make. Once the breadcrumbs are lightly golden, remove from the pan and cool on a sheet of baking paper. Assembling the apple trifle:.","url":"https://crave.devyy.com/recipes/old-fashioned-danish-apple-trifle/#step-3"},{"@type":"HowToStep","name":"Dip & Coat Evenly","text":"Do not assemble the trifle until right before serving. Otherwise, the rasp will become soggy. Serve the trifle in individual small glasses or a large glass bowl. Lightly whip the double cream. Layer the ingredients in the glasses or bowl, starting with breadcrumbs in the bottom, followed by chilled apple sauce and breadcrumbs again. You can make several layers of breadcrumbs and apple sauce, then top with a generous layer of whipped cream. Serve immediately.","url":"https://crave.devyy.com/recipes/old-fashioned-danish-apple-trifle/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Pastries & Donuts","item":"https://crave.devyy.com/category/pastries-donuts/"},{"@type":"ListItem","position":3,"name":"Old-fashioned Danish Apple Trifle","item":"https://crave.devyy.com/recipes/old-fashioned-danish-apple-trifle/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Old-fashioned Danish Apple Trifle?","acceptedAnswer":{"@type":"Answer","text":"Old-fashioned Danish Apple Trifle takes 15 minutes total (15 minutes prep) and yields 4 servings at 339 calories per serving."}},{"@type":"Question","name":"Can I make Old-fashioned Danish Apple Trifle healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Old-fashioned Danish Apple Trifle recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
