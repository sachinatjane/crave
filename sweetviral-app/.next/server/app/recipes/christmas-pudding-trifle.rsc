10:T1034,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/christmas-pudding-trifle/","name":"Christmas Pudding Trifle","image":["https://crave.devyy.com/ai-images/christmas-pudding-trifle.jpg","https://crave.devyy.com/ai-images/christmas-pudding-trifle.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"British-inspired christmas pudding trifle with 9 measured ingredients — zero sign-up, instant Cook Mode. Ready in 15 mins (4 servings). 4.7★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT0M","totalTime":"PT15M","recipeYield":"4 servings","recipeCategory":"Puddings & Custards","recipeCuisine":"British","keywords":"Christmas Pudding Trifle, British, Puddings & Custards, #ChristmasPudd, #CraveMadeMeDoIt, #ViralDesserts, #BritishSweets","nutrition":{"@type":"NutritionInformation","calories":"348 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.7,"reviewCount":131},"recipeIngredient":["3 whole Orange","1 tbs Demerara Sugar","2 tbs Grand Marnier","1.33 cup Christmas Pudding","2.22 cup Custard","1.11 cup Mascarpone","1.18 cup Double Cream","1 handful Flaked Almonds","1 grated Dark Chocolate"],"recipeInstructions":[{"@type":"HowToStep","name":"Whisk & Combine Base Ingredients","text":"Peel the oranges using a sharp knife, ensuring all the pith is removed. Slice as thinly as possible and arrange over a dinner plate. Sprinkle with the demerara sugar followed by the Grand Marnier and set aside. Incorporate 3 whole orange, 1 tbs demerara sugar, 2 tbs grand marnier, and 1.33 cup christmas pudding smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/christmas-pudding-trifle/#step-1"},{"@type":"HowToStep","name":"Fold In Flavorings & Mix-Ins","text":"Crumble the Christmas pudding into large pieces and scatter over the bottom of a trifle bowl. Lift the oranges onto the pudding in a layer and pour over any juices. Incorporate 2.22 cup custard, 1.11 cup mascarpone, 1.18 cup double cream, 1 handful flaked almonds, and 1 grated dark chocolate smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/christmas-pudding-trifle/#step-2"},{"@type":"HowToStep","name":"Dip & Coat Evenly","text":"Beat the mascarpone until smooth, then stir in the custard. Spoon the mixture over the top of the oranges. Whisk steadily around the bottom and corners of the pan until glossy, thickened, and smooth enough to coat the back of a spoon.","url":"https://crave.devyy.com/recipes/christmas-pudding-trifle/#step-3"},{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Lightly whip the cream and spoon over the custard. Sprinkle with the flaked almonds and grated chocolate. You can make this a day in advance if you like, chill until ready to serve.","url":"https://crave.devyy.com/recipes/christmas-pudding-trifle/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Puddings & Custards","item":"https://crave.devyy.com/category/puddings-custards/"},{"@type":"ListItem","position":3,"name":"Christmas Pudding Trifle","item":"https://crave.devyy.com/recipes/christmas-pudding-trifle/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Christmas Pudding Trifle?","acceptedAnswer":{"@type":"Answer","text":"Christmas Pudding Trifle takes 15 minutes total (15 minutes prep) and yields 4 servings at 348 calories per serving."}},{"@type":"Question","name":"Can I make Christmas Pudding Trifle healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Christmas Pudding Trifle recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
