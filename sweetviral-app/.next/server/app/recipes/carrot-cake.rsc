10:Tfa1,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/carrot-cake/","name":"Carrot Cake","image":["https://crave.devyy.com/ai-images/carrot-cake.jpg","https://crave.devyy.com/ai-images/carrot-cake.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"British-inspired carrot cake with 12 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (6 servings). 4.7★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"6 servings","recipeCategory":"Cakes & Mug Cakes","recipeCuisine":"British","keywords":"Carrot Cake, British, Cakes & Mug Cakes, #CarrotCake, #CraveMadeMeDoIt, #ViralDesserts, #BritishSweets","nutrition":{"@type":"NutritionInformation","calories":"376 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.7,"reviewCount":63},"recipeIngredient":["1.88 cup Vegetable Oil","1.78 cup Plain Flour","2 tsp Bicarbonate Of Soda","2.29 cup Sugar","5 whole Eggs","1 tsp Salt","2 tsp Cinnamon","2.22 cup Carrots","10 tbsp Walnuts","0.89 cup Cream Cheese","10 tbsp Caster Sugar","6.7 tbsp Butter"],"recipeInstructions":[{"@type":"HowToStep","name":"Prep & Mix: Carrot Cake","text":"For the carrot cake, preheat the oven to 160C/325F/Gas 3. Grease and line a 26cm/10in springform cake tin. Line your baking pan with parchment paper or grease lightly, and make sure 1.88 cup vegetable oil, 1.78 cup plain flour, 2 tsp bicarbonate of soda, and 2.29 cup sugar are measured and at room temperature so they blend smoothly.","url":"https://crave.devyy.com/recipes/carrot-cake/#step-1"},{"@type":"HowToStep","name":"Build Flavor: Carrot Cake","text":"Mix all of the ingredients for the carrot cake, except the carrots and walnuts, together in a bowl until well combined. Stir in the carrots and walnuts. Incorporate 5 whole eggs, 1 tsp salt, 2 tsp cinnamon, 2.22 cup carrots, 10 tbsp walnuts, 0.89 cup cream cheese, 10 tbsp caster sugar, and 6.7 tbsp butter smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/carrot-cake/#step-2"},{"@type":"HowToStep","name":"Shape & Layer: Carrot Cake","text":"Spoon the mixture into the cake tin and bake for 1 hour 15 minutes, or until a skewer inserted into the middle comes out clean. Remove the cake from the oven and set aside to cool for 10 minutes, then carefully remove the cake from the tin and set aside to cool completely on a cooling rack.","url":"https://crave.devyy.com/recipes/carrot-cake/#step-3"},{"@type":"HowToStep","name":"Bake / Chill: Carrot Cake","text":"Meanwhile, for the icing, beat the cream cheese, caster sugar and butter together in a bowl until fluffy. Spread the icing over the top of the cake with a palette knife.","url":"https://crave.devyy.com/recipes/carrot-cake/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Cakes & Mug Cakes","item":"https://crave.devyy.com/category/cakes-cupcakes/"},{"@type":"ListItem","position":3,"name":"Carrot Cake","item":"https://crave.devyy.com/recipes/carrot-cake/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Carrot Cake?","acceptedAnswer":{"@type":"Answer","text":"Carrot Cake takes 45 minutes total (15 minutes prep) and yields 6 servings at 376 calories per serving."}},{"@type":"Question","name":"Can I make Carrot Cake healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Carrot Cake recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
