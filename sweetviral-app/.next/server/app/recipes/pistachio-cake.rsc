10:T133f,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/pistachio-cake/","name":"Pistachio cake","image":["https://crave.devyy.com/ai-images/pistachio-cake.jpg","https://crave.devyy.com/ai-images/pistachio-cake.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Polish-inspired pistachio cake with 13 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (6 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"6 servings","recipeCategory":"Cakes & Mug Cakes","recipeCuisine":"Polish","keywords":"Pistachio cake, Polish, Cakes & Mug Cakes, #Pistachiocake, #CraveMadeMeDoIt, #ViralDesserts, #PolishSweets","nutrition":{"@type":"NutritionInformation","calories":"207 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":232},"recipeIngredient":["1.11 cup Butter","0.89 cup Pistachio","5.3 tbsp Plain Flour","1 tsp Baking Powder","1 cup Caster Sugar","4 whole Egg","1 tsp Vanilla Extract","6.7 tbsp Icing Sugar","1.11 cup Mascarpone","0.83 cup Double Cream","6.7 tbsp Pistachio Paste","1.78 cup Raspberries","1 whole Unwaxed Lime"],"recipeInstructions":[{"@type":"HowToStep","name":"Prep & Mix: Pistachio cake","text":"Heat the oven to 180C/160C fan/gas 4. Butter and line a 23cm springform cake tin. Tip 150g of the pistachios into a food processor and blitz until finely ground. Tip into a bowl and mix in the flour, baking powder and pinch of salt. Beat the butter and sugar in a separate bowl until fluffy and pale, around 5 mins. Crack in the eggs one at a time, beating well for 1 min after each addition, until they have all been added. Beat in the vanilla, then fold in the flour mixture gently. Carefully spoon into the prepared tin and bake for 35-40 mins until a skewer inserted into the middle comes out clean. Set aside to cool completely on a wire rack in the tin. Incorporate 1.11 cup butter, 0.89 cup pistachio, 5.3 tbsp plain flour, and 1 tsp baking powder smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/pistachio-cake/#step-1"},{"@type":"HowToStep","name":"Build Flavor: Pistachio cake","text":"Meanwhile, sift the icing sugar into a bowl, then tip in the mascarpone, double cream and pistachio paste. Beat until well combined, then set aside in the fridge for 20-30 mins to thicken to a spooning consistency. Incorporate 1 cup caster sugar, 4 whole egg, 1 tsp vanilla extract, 6.7 tbsp icing sugar, 1.11 cup mascarpone, 0.83 cup double cream, 6.7 tbsp pistachio paste, 1.78 cup raspberries, and 1 whole unwaxed lime smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/pistachio-cake/#step-2"},{"@type":"HowToStep","name":"Bake Pistachio cake & Check Doneness","text":"Bake for 30 minutes until the edges turn golden and set while the center remains tender. Test with a toothpick—if it comes out with a few moist crumbs rather than wet batter, it is ready.","url":"https://crave.devyy.com/recipes/pistachio-cake/#step-3"},{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Cut the cooled cake in half horizontally using a serrated knife, so you have two layers. Put the bottom layer on a plate or cake stand and spread over a generous spoonful of the pistachio cream. Top with a generous handful of the raspberries so the cake is covered. Top with the other sponge half, then cover the top and sides of the cake with the remaining cream. Scatter over the last of the raspberries, the remaining pistachios and the lime zest to serve. Will keep chilled in an airtight container for two days.","url":"https://crave.devyy.com/recipes/pistachio-cake/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Cakes & Mug Cakes","item":"https://crave.devyy.com/category/cakes-cupcakes/"},{"@type":"ListItem","position":3,"name":"Pistachio cake","item":"https://crave.devyy.com/recipes/pistachio-cake/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Pistachio cake?","acceptedAnswer":{"@type":"Answer","text":"Pistachio cake takes 45 minutes total (15 minutes prep) and yields 6 servings at 207 calories per serving."}},{"@type":"Question","name":"Can I make Pistachio cake healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Pistachio cake recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
