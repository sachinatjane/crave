10:T1196,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/peach-blueberry-grunt/","name":"Peach & Blueberry Grunt","image":["https://crave.devyy.com/ai-images/peach-blueberry-grunt.jpg","https://crave.devyy.com/ai-images/peach-blueberry-grunt.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"United States-inspired peach & blueberry grunt with 11 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (4 servings). 4.7★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"4 servings","recipeCategory":"Global Classics","recipeCuisine":"United States","keywords":"Peach & Blueberry Grunt, United States, Global Classics, #Peach, #CraveMadeMeDoIt, #ViralDesserts, #UnitedSweets","nutrition":{"@type":"NutritionInformation","calories":"219 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.7,"reviewCount":127},"recipeIngredient":["1 tsp Corn Flour","1 juice of 2 Orange","1 zest of 1 Orange","2 tbs Caster Sugar","6 whole Peaches","1.11 cup Blueberries","0.89 cup Self-raising Flour","3.3 tbsp Butter","6.7 tbsp Muscovado Sugar","1 tsp Cinnamon","6 tbsp Milk"],"recipeInstructions":[{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Heat oven to 190C/170C fan/gas 5. Butter a wide shallow ovenproof dish. Blend the cornflour with the orange zest and juice, and put in a large pan with the sugar. Halve, stone and slice the peaches and add to the pan. Bring slowly to the boil, stirring gently until the sauce is shiny and thickened, about 3-4 mins. Remove from the heat, stir in the blueberries and tip into the prepared dish. Incorporate 1 tsp corn flour, 1 juice of 2 orange, 1 zest of 1 orange, and 2 tbs caster sugar smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/peach-blueberry-grunt/#step-1"},{"@type":"HowToStep","name":"Dip & Coat Evenly","text":"Tip the flour into a mixing bowl and add the 50g butter. Rub the butter into the flour until it resembles fine breadcrumbs, then stir in half the sugar. Mix the remaining sugar with the cinnamon and set aside. Incorporate 6 whole peaches, 1.11 cup blueberries, 0.89 cup self-raising flour, 3.3 tbsp butter, 6.7 tbsp muscovado sugar, 1 tsp cinnamon, and 6 tbsp milk smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/peach-blueberry-grunt/#step-2"},{"@type":"HowToStep","name":"Sift & Whisk Dry Ingredients","text":"Add the milk to the dry ingredients and mix to a soft dough. Turn out onto a lightly floured surface and knead briefly. Roll out to an oblong roughly 16 x 24cm. Brush with melted butter and sprinkle evenly with the spicy sugar. Roll up from one long side and cut into 12 slices. Arrange around the top of the dish, leaving the centre uncovered.","url":"https://crave.devyy.com/recipes/peach-blueberry-grunt/#step-3"},{"@type":"HowToStep","name":"Cool, Garnish & Serve","text":"Bake for 20-25 mins, until the topping is crisp and golden. Serve warm. Let Peach & Blueberry Grunt cool for 10–15 minutes so the crumb sets cleanly before slicing into 4 portions, then garnish and serve.","url":"https://crave.devyy.com/recipes/peach-blueberry-grunt/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"Peach & Blueberry Grunt","item":"https://crave.devyy.com/recipes/peach-blueberry-grunt/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Peach & Blueberry Grunt?","acceptedAnswer":{"@type":"Answer","text":"Peach & Blueberry Grunt takes 45 minutes total (15 minutes prep) and yields 4 servings at 219 calories per serving."}},{"@type":"Question","name":"Can I make Peach & Blueberry Grunt healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Peach & Blueberry Grunt recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
