10:T1063,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/chocolate-coconut-squares/","name":"Chocolate Coconut Squares","image":["https://crave.devyy.com/ai-images/chocolate-coconut-squares.jpg","https://crave.devyy.com/ai-images/chocolate-coconut-squares.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Australian-inspired chocolate coconut squares with 11 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (4 servings). 4.7★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"4 servings","recipeCategory":"Chocolate & Brownies","recipeCuisine":"Australian","keywords":"Chocolate Coconut Squares, Australian, Chocolate & Brownies, #ChocolateCoco, #CraveMadeMeDoIt, #ViralDesserts, #AustralianSweets","nutrition":{"@type":"NutritionInformation","calories":"287 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.7,"reviewCount":191},"recipeIngredient":["6.7 tbsp Butter","6.7 tbsp Caster Sugar","2 whole Egg","9.3 tbsp Self-raising Flour","1 tsp Baking Powder","2 tbsp Cocoa Powder","2 tbsp Milk","6.7 tbsp Plain Chocolate","0.9 oz Butter","6.7 tbsp Icing Sugar","6.7 tbsp Desiccated Coconut"],"recipeInstructions":[{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Heat oven to 180C/fan 160C/gas 4. Butter and line the base of a 20cm square baking tin. Beat together the butter and sugar until pale and creamy, then beat in the eggs. Add 1 tbsp of the flour if the mix starts to curdle. Incorporate 6.7 tbsp butter, 6.7 tbsp caster sugar, 2 whole egg, and 9.3 tbsp self-raising flour smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/chocolate-coconut-squares/#step-1"},{"@type":"HowToStep","name":"Bake Until Golden & Set","text":"Sieve in the flour, baking powder and cocoa and fold in with a metal spoon. Stir in the milk. Scrape mix into the tin and level the top. Bake for 18-20 mins or until the cake springs back when pressed. Allow to cool in the tin. Incorporate 1 tsp baking powder, 2 tbsp cocoa powder, 2 tbsp milk, 6.7 tbsp plain chocolate, 0.9 oz butter, 6.7 tbsp icing sugar, and 6.7 tbsp desiccated coconut smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/chocolate-coconut-squares/#step-2"},{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"To make the icing, put the chocolate, butter and 4 tbsp water in a pan and gently heat until melted. Allow to cool slightly, then beat in the icing sugar.","url":"https://crave.devyy.com/recipes/chocolate-coconut-squares/#step-3"},{"@type":"HowToStep","name":"Dip & Coat Evenly","text":"Remove cake from tin and peel away paper. Cut into 16 squares. Dip the squares into the icing, then roll in the coconut. Allow to set on cooling rack.","url":"https://crave.devyy.com/recipes/chocolate-coconut-squares/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Chocolate & Brownies","item":"https://crave.devyy.com/category/chocolate-brownies/"},{"@type":"ListItem","position":3,"name":"Chocolate Coconut Squares","item":"https://crave.devyy.com/recipes/chocolate-coconut-squares/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Chocolate Coconut Squares?","acceptedAnswer":{"@type":"Answer","text":"Chocolate Coconut Squares takes 45 minutes total (15 minutes prep) and yields 4 servings at 287 calories per serving."}},{"@type":"Question","name":"Can I make Chocolate Coconut Squares healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Chocolate Coconut Squares recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
