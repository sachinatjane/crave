10:T12fe,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/traditional-dutch-rice-tart-rijstevlaai/","name":"Traditional Dutch rice tart (rijstevlaai)","image":["https://crave.devyy.com/ai-images/traditional-dutch-rice-tart-rijstevlaai.jpg","https://crave.devyy.com/ai-images/traditional-dutch-rice-tart-rijstevlaai.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Global-inspired traditional dutch rice tart (rijstevlaai) with 14 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (6 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"6 servings","recipeCategory":"Pies, Tarts & Crumbles","recipeCuisine":"Global","keywords":"Traditional Dutch rice tart (rijstevlaai), Global, Pies, Tarts & Crumbles, #TraditionalDu, #CraveMadeMeDoIt, #ViralDesserts, #GlobalSweets","nutrition":{"@type":"NutritionInformation","calories":"410 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":116},"recipeIngredient":["0.89 cup Flour","5 tbsp Coconut Oil","6.7 tbsp Vegetable Millk","2 tsp Yeast","3.3 tbsp Sugar","10 tbsp Dessert Rice","6.7 tbsp Sugar","3.11 cup Vegetable Millk","1 tsp Vanilla Extract","2 whole Cardamom","2 whole Star Anise","1 whole Cinnamon Stick","0.5 tsp Baking Powder","0.5 tsp Lemon Juice"],"recipeInstructions":[{"@type":"HowToStep","name":"Simmer & Dissolve Smoothly","text":"Heat the oven to 180°C. For the dough, mix flour and sugar in a bowl. Heat the 100 grams of milk to lukewarm and dissolve the yeast in it. Let stand for a while until it starts to bubble. Then add to the flour along with the coconut oil and mix into a smooth dough. Let rise for 30 minutes, covered, in a warm place. Incorporate 0.89 cup flour, 5 tbsp coconut oil, 6.7 tbsp vegetable millk, and 2 tsp yeast smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/traditional-dutch-rice-tart-rijstevlaai/#step-1"},{"@type":"HowToStep","name":"Simmer & Dissolve Smoothly","text":"Meanwhile, make the rice pudding by putting the rice with sugar, milk and vanilla extract in a saucepan. Add the cardamom, star anise and cinnamon. Bring to a boil and cook, stirring constantly. Take out the spices. In a small bowl, mix baking soda with lemon juice/apple vinegar. Stir well until baking soda is dissolved, then mix into the rice pudding. Incorporate 3.3 tbsp sugar, 10 tbsp dessert rice, and 6.7 tbsp sugar smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/traditional-dutch-rice-tart-rijstevlaai/#step-2"},{"@type":"HowToStep","name":"Combine Wet & Dry Smoothly","text":"Fold 3.11 cup vegetable millk, 1 tsp vanilla extract, 2 whole cardamom, 2 whole star anise, 1 whole cinnamon stick, 0.5 tsp baking powder, and 0.5 tsp lemon juice into the base in two additions using gentle strokes until glossy and uniform with zero dry pockets. Avoid overmixing so the final texture stays light and tender.","url":"https://crave.devyy.com/recipes/traditional-dutch-rice-tart-rijstevlaai/#step-3"},{"@type":"HowToStep","name":"Shape & Press Dough Evenly","text":"Roll out the dough on a floured work surface (it is very sticky, but don’t stress it will be fine) and line the bottom and edges of a greased mold with it. Spread the rice pudding over the bottom and bake for about 25 to 30 minutes.","url":"https://crave.devyy.com/recipes/traditional-dutch-rice-tart-rijstevlaai/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Pies, Tarts & Crumbles","item":"https://crave.devyy.com/category/pies-tarts/"},{"@type":"ListItem","position":3,"name":"Traditional Dutch rice tart (rijstevlaai)","item":"https://crave.devyy.com/recipes/traditional-dutch-rice-tart-rijstevlaai/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Traditional Dutch rice tart (rijstevlaai)?","acceptedAnswer":{"@type":"Answer","text":"Traditional Dutch rice tart (rijstevlaai) takes 45 minutes total (15 minutes prep) and yields 6 servings at 410 calories per serving."}},{"@type":"Question","name":"Can I make Traditional Dutch rice tart (rijstevlaai) healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Traditional Dutch rice tart (rijstevlaai) recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
