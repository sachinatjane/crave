10:T12f4,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/fyrstekake-norwegian-prince-cake/","name":"Fyrstekake – Norwegian Prince Cake","image":["https://crave.devyy.com/ai-images/fyrstekake-norwegian-prince-cake.jpg","https://crave.devyy.com/ai-images/fyrstekake-norwegian-prince-cake.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Norway-inspired fyrstekake – norwegian prince cake with 13 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (6 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"6 servings","recipeCategory":"Cakes & Mug Cakes","recipeCuisine":"Norway","keywords":"Fyrstekake – Norwegian Prince Cake, Norway, Cakes & Mug Cakes, #Fyrstekake, #CraveMadeMeDoIt, #ViralDesserts, #NorwaySweets","nutrition":{"@type":"NutritionInformation","calories":"235 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":236},"recipeIngredient":["0.75 cup Granulated Sugar","1 tsp Vanilla Extract","0.6666666666666666 cup Butter","4 whole Egg Yolks","2 cups Flour","1 tsp Baking Powder","1.5 cups Almonds","0.75 cup Brown Sugar","2 tbsp Melted Butter","2 pcs Egg","2 tbsp Brandy","5 drops Almond Extract","1 whole Egg"],"recipeInstructions":[{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Mix together sugar, vanilla and butter until light and fluffy. Mix in the egg yolks. Add in the flour and baking powder and knead with hands until the dough is smooth. Pack the dough in plastic wrap and chill in refrigerator for at least 30 minutes. Run the almonds and sugar together in a food processor until the almonds are finely ground (you can decide for yourself how coarse or fine you want them). Incorporate 0.75 cup granulated sugar, 1 tsp vanilla extract, 0.6666666666666666 cup butter, and 4 whole egg yolks smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/fyrstekake-norwegian-prince-cake/#step-1"},{"@type":"HowToStep","name":"Preheat & Prep Your Pan","text":"Stir in the butter, egg, cognac and/or almond extract (if using). Line the bottom of your cake form with baking paper and grease the sides of the form. Preheat oven to 350°F (175°C). Incorporate 2 cups flour, 1 tsp baking powder, 1.5 cups almonds, 0.75 cup brown sugar, 2 tbsp melted butter, 2 pcs egg, 2 tbsp brandy, 5 drops almond extract, and 1 whole egg smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/fyrstekake-norwegian-prince-cake/#step-2"},{"@type":"HowToStep","name":"Shape & Press Dough Evenly","text":"Cut 2/3 of the crust dough into slices and press down into the cake form. Cover the bottom of the cake form with the dough and bring the dough 2-3 cm (1 inch) up the sides of the form, pressing until even. Scoop the almond filling on top of the crust, spreading it evenly across the cake form. Roll out of the rest of the dough and slice into long strips. Lay the strips of dough across the cake in a grid. Don't worry of the strips break – simply press them back together on the cake.","url":"https://crave.devyy.com/recipes/fyrstekake-norwegian-prince-cake/#step-3"},{"@type":"HowToStep","name":"Shape & Press Dough Evenly","text":"Gently brush the dough with egg wash. Bake for about 45 minutes. The top of the cake should be golden brown while the almond filling will remain soft.","url":"https://crave.devyy.com/recipes/fyrstekake-norwegian-prince-cake/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Cakes & Mug Cakes","item":"https://crave.devyy.com/category/cakes-cupcakes/"},{"@type":"ListItem","position":3,"name":"Fyrstekake – Norwegian Prince Cake","item":"https://crave.devyy.com/recipes/fyrstekake-norwegian-prince-cake/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Fyrstekake – Norwegian Prince Cake?","acceptedAnswer":{"@type":"Answer","text":"Fyrstekake – Norwegian Prince Cake takes 45 minutes total (15 minutes prep) and yields 6 servings at 235 calories per serving."}},{"@type":"Question","name":"Can I make Fyrstekake – Norwegian Prince Cake healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Fyrstekake – Norwegian Prince Cake recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
