10:T10e3,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/rogaliki-polish-croissant-cookies/","name":"Rogaliki (Polish Croissant Cookies)","image":["https://crave.devyy.com/ai-images/rogaliki-polish-croissant-cookies.jpg","https://crave.devyy.com/ai-images/rogaliki-polish-croissant-cookies.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Polish-inspired rogaliki (polish croissant cookies) with 6 measured ingredients — zero sign-up, instant Cook Mode. Ready in 33 mins (12 servings). 4.8★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT18M","totalTime":"PT33M","recipeYield":"12 servings","recipeCategory":"Cookies & Bars","recipeCuisine":"Polish","keywords":"Rogaliki (Polish Croissant Cookies), Polish, Cookies & Bars, #RogalikiPoli, #CraveMadeMeDoIt, #ViralDesserts, #PolishSweets","nutrition":{"@type":"NutritionInformation","calories":"301 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":95},"recipeIngredient":["1 cup Butter","3 whole Egg Yolks","8 oz Cream Cheese","1 tsp Baking Powder","3 cups Flour","1 jar Jam"],"recipeInstructions":[{"@type":"HowToStep","name":"Shape & Press Dough Evenly","text":"In a medium bowl mix egg yolks, philly cheese and baking powder using a hand held mixer. Carefully start adding the flour. When the mixture will not be mixing well, and will look like wood chips, put away the blending mixer and using your hands knead the dough. Create a roll and cover in foil and freeze for 15 minutes. At this time preheat the oven to 375. Take the dough out and separate into two. Roll and cut out 3 inch trangles. Incorporate 1 cup butter, 3 whole egg yolks, 8 oz cream cheese, and 1 tsp baking powder smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/rogaliki-polish-croissant-cookies/#step-1"},{"@type":"HowToStep","name":"Shape & Press Dough Evenly","text":"Make as many as you can and on centre of each put a small spoon of jam. Roll them into a croissant shape. Place the croissants onto a greased cookie sheet, and bake for 10-12 minutes or until golden. Repeat with the rest of the dough. Incorporate 3 cups flour and 1 jar jam smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/rogaliki-polish-croissant-cookies/#step-2"},{"@type":"HowToStep","name":"Bake Rogaliki (Polish Croissant Cookies) & Check Doneness","text":"Bake for 18 minutes until the edges turn golden and set while the center remains tender. Test with a toothpick—if it comes out with a few moist crumbs rather than wet batter, it is ready.","url":"https://crave.devyy.com/recipes/rogaliki-polish-croissant-cookies/#step-3"},{"@type":"HowToStep","name":"Cool, Garnish & Serve","text":"When you take them out, put aside and sprinkle with powdered sugar on top. This makes about 3 batches of 20 cookies each. Total count about 60 cookies.","url":"https://crave.devyy.com/recipes/rogaliki-polish-croissant-cookies/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Cookies & Bars","item":"https://crave.devyy.com/category/cookies-bars/"},{"@type":"ListItem","position":3,"name":"Rogaliki (Polish Croissant Cookies)","item":"https://crave.devyy.com/recipes/rogaliki-polish-croissant-cookies/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Rogaliki (Polish Croissant Cookies)?","acceptedAnswer":{"@type":"Answer","text":"Rogaliki (Polish Croissant Cookies) takes 33 minutes total (15 minutes prep) and yields 12 servings at 301 calories per serving."}},{"@type":"Question","name":"Can I make Rogaliki (Polish Croissant Cookies) healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Rogaliki (Polish Croissant Cookies) recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
