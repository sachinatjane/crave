10:Tf1f,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/coconut-quindim/","name":"Coconut quindim","image":["https://crave.devyy.com/ai-images/coconut-quindim.jpg","https://crave.devyy.com/ai-images/coconut-quindim.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Global-inspired coconut quindim with 6 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (4 servings). 4.7★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"4 servings","recipeCategory":"Global Classics","recipeCuisine":"Global","keywords":"Coconut quindim, Global, Global Classics, #Coconutquindi, #CraveMadeMeDoIt, #ViralDesserts, #GlobalSweets","nutrition":{"@type":"NutritionInformation","calories":"341 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.7,"reviewCount":249},"recipeIngredient":["2 tbsp Butter","10 whole Egg Yolks","6.7 tbsp Caster Sugar","1.25 cup Coconut Milk","3.3 tbsp Desiccated Coconut","1 tsp Vanilla Extract"],"recipeInstructions":[{"@type":"HowToStep","name":"Prep & Mix: Coconut quindim","text":"Heat oven to 180C/160C fan/gas 4. Rub 4 ramekins, about 175ml capacity, or dariole moulds liberally with the soft butter. Sprinkle with the caster sugar to coat. Incorporate 2 tbsp butter, 10 whole egg yolks, 6.7 tbsp caster sugar, and 1.25 cup coconut milk smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/coconut-quindim/#step-1"},{"@type":"HowToStep","name":"Fold In Flavorings & Mix-Ins","text":"In a medium bowl, press the egg yolks through a wire sieve and mix with the coconut milk, sugar, coconut and vanilla. Pour into ramekins and place in a large roasting tin in the oven. Incorporate 3.3 tbsp desiccated coconut and 1 tsp vanilla extract smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/coconut-quindim/#step-2"},{"@type":"HowToStep","name":"Bake Until Golden & Set","text":"Pour water into the roasting tin to three-quarters up the ramekins so it acts like a bain marie or water bath for the quindim. Bake for 30-35 mins until the tops are golden. Take the ramekins out of the water and leave to cool for 5 mins.","url":"https://crave.devyy.com/recipes/coconut-quindim/#step-3"},{"@type":"HowToStep","name":"Cool, Garnish & Serve","text":"Chill for 4 hrs and then run a knife around the edge. Place a plate on top and turn out the quindims to serve. Let Coconut quindim cool for 10–15 minutes so the crumb sets cleanly before slicing into 4 portions, then garnish and serve.","url":"https://crave.devyy.com/recipes/coconut-quindim/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"Coconut quindim","item":"https://crave.devyy.com/recipes/coconut-quindim/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Coconut quindim?","acceptedAnswer":{"@type":"Answer","text":"Coconut quindim takes 45 minutes total (15 minutes prep) and yields 4 servings at 341 calories per serving."}},{"@type":"Question","name":"Can I make Coconut quindim healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Coconut quindim recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
