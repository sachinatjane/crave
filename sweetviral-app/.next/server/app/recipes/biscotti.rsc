10:Tfb2,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/biscotti/","name":"Biscotti","image":["https://crave.devyy.com/ai-images/biscotti.jpg","https://crave.devyy.com/ai-images/biscotti.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_us_eu"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Biscotti are Italian almond biscuits originating in the city of Prato, Tuscany. Ready in 21 mins (12 servings). 4.8★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT10M","cookTime":"PT11M","totalTime":"PT21M","recipeYield":"12 servings","recipeCategory":"Cookies & Bars","recipeCuisine":"Italian","keywords":"Biscotti, Italian, Cookies & Bars, #Biscotti, #CraveMadeMeDoIt, #ViralDesserts, #ItalianSweets","nutrition":{"@type":"NutritionInformation","calories":"240 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":184},"recipeIngredient":["0.5 cup Softened butter or creamy nut butter","0.75 cup Brown sugar & granulated sugar","1.5 cups All-purpose flour + 1/2 tsp baking soda","0.75 cup Toasted chopped pecans, almonds, or hazelnuts"],"recipeInstructions":[{"@type":"HowToStep","name":"Preheat Oven & Prep Your Pan","text":"Preheat your oven to 350°F (175°C) and line your baking pan with parchment paper, leaving a slight overhang for effortless lifting. Measure out 0.5 cup softened butter or creamy nut butter and 0.75 cup brown sugar & granulated sugar so everything is ready and at room temperature for a silky, lump-free batter.","url":"https://crave.devyy.com/recipes/biscotti/#step-1"},{"@type":"HowToStep","name":"Cream Butter-Sugar & Fold Mix-Ins","text":"Cream 0.5 cup softened butter or creamy nut butter and 0.75 cup brown sugar & granulated sugar fluffy (2 mins), stir in 1.5 cups all-purpose flour + 1/2 tsp baking soda and 0.75 cup toasted chopped pecans, almonds, or hazelnuts. Line your baking pan with parchment paper or grease lightly, and make sure 0.5 cup softened butter or creamy nut butter, 0.75 cup brown sugar & granulated sugar, and 1.5 cups all-purpose flour + 1/2 tsp baking soda are measured and at room temperature so they blend smoothly.","url":"https://crave.devyy.com/recipes/biscotti/#step-2"},{"@type":"HowToStep","name":"Bake Golden Edges & Soft Centers","text":"Bake at 350°F (175°C) for 11 minutes until edges turn golden while centers look slightly soft. Let Biscotti cool for 10–15 minutes so the crumb sets cleanly before slicing into 12 portions, then garnish and serve.","url":"https://crave.devyy.com/recipes/biscotti/#step-3"},{"@type":"HowToStep","name":"Cool Completely, Garnish & Serve","text":"Transfer Biscotti to a wire cooling rack and let it cool for 15–20 minutes so the interior sets cleanly without crumbling. Lift out using the parchment overhang, garnish as desired, and slice into 12 portions.","url":"https://crave.devyy.com/recipes/biscotti/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Cookies & Bars","item":"https://crave.devyy.com/category/cookies-bars/"},{"@type":"ListItem","position":3,"name":"Biscotti","item":"https://crave.devyy.com/recipes/biscotti/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Biscotti?","acceptedAnswer":{"@type":"Answer","text":"Biscotti takes 21 minutes total (10 minutes prep) and yields 12 servings at 240 calories per serving."}},{"@type":"Question","name":"Can I make Biscotti healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Biscotti recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
