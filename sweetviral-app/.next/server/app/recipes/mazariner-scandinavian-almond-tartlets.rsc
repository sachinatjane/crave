10:T125a,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/mazariner-scandinavian-almond-tartlets/","name":"Mazariner – Scandinavian Almond Tartlets","image":["https://crave.devyy.com/ai-images/mazariner-scandinavian-almond-tartlets.jpg","https://crave.devyy.com/ai-images/mazariner-scandinavian-almond-tartlets.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Norway-inspired mazariner – scandinavian almond tartlets with 14 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (6 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"6 servings","recipeCategory":"Pies, Tarts & Crumbles","recipeCuisine":"Norway","keywords":"Mazariner – Scandinavian Almond Tartlets, Norway, Pies, Tarts & Crumbles, #Mazariner, #CraveMadeMeDoIt, #ViralDesserts, #NorwaySweets","nutrition":{"@type":"NutritionInformation","calories":"267 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":211},"recipeIngredient":["3 cups Flour","1.25 cups Powdered Sugar","0.89 cup Butter","1 whole Egg","3 whole Egg","1.25 cups Powdered Sugar","6.7 tbsp Butter","2 tsp Vanilla Extract","2 tbsp Flour","2 cups Almond Flour","1 tsp Almond Extract","2 cups Powdered Sugar","3 tbsp Heavy Cream","0.25 tsp Almond Extract"],"recipeInstructions":[{"@type":"HowToStep","name":"Shape & Press Dough Evenly","text":"Combine the flour and powdered sugar in a food processor. Add the butter and pulse until it's evenly distributed. Add the egg and pulse until the dough comes together. Roll out the dough on a floured surface. Cut the dough in circles with a large mug. Press the circles down into a greased muffin pan. Put the pan of shells in the fridge while you prepare the almond filling. Incorporate 3 cups flour, 1.25 cups powdered sugar, 0.89 cup butter, and 1 whole egg smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/mazariner-scandinavian-almond-tartlets/#step-1"},{"@type":"HowToStep","name":"Melt & Whisk Smooth","text":"Preheat oven to 355°F (180°C). Whisk the egg and powdered sugar together until thick and airy. Melt the butter and stir it into the egg mixture. Stir in the vanilla, flour, and almond extract. Stir in the almond flour. Incorporate 3 whole egg, 1.25 cups powdered sugar, 6.7 tbsp butter, 2 tsp vanilla extract, 2 tbsp flour, 2 cups almond flour, 1 tsp almond extract, 2 cups powdered sugar, 3 tbsp heavy cream, and 0.25 tsp almond extract smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/mazariner-scandinavian-almond-tartlets/#step-2"},{"@type":"HowToStep","name":"Bake Until Golden & Set","text":"Pipe or spoon the almond filling onto the shells, filling the shells about 3/4 full. Bake the mazariner for 20 – 25 minutes, until light golden brown. Cool on a wire rack.","url":"https://crave.devyy.com/recipes/mazariner-scandinavian-almond-tartlets/#step-3"},{"@type":"HowToStep","name":"Cool, Garnish & Serve","text":"Mix together the powdered sugar and liquid until you get a spreadable glaze. Spread the glaze on top of the mazariner and if you wish, decorate with sprinkles, or anything you like.","url":"https://crave.devyy.com/recipes/mazariner-scandinavian-almond-tartlets/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Pies, Tarts & Crumbles","item":"https://crave.devyy.com/category/pies-tarts/"},{"@type":"ListItem","position":3,"name":"Mazariner – Scandinavian Almond Tartlets","item":"https://crave.devyy.com/recipes/mazariner-scandinavian-almond-tartlets/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Mazariner – Scandinavian Almond Tartlets?","acceptedAnswer":{"@type":"Answer","text":"Mazariner – Scandinavian Almond Tartlets takes 45 minutes total (15 minutes prep) and yields 6 servings at 267 calories per serving."}},{"@type":"Question","name":"Can I make Mazariner – Scandinavian Almond Tartlets healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Mazariner – Scandinavian Almond Tartlets recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
