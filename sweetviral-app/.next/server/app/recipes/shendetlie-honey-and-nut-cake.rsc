10:T117f,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/shendetlie-honey-and-nut-cake/","name":"Shendetlie Honey and Nut Cake","image":["https://crave.devyy.com/ai-images/shendetlie-honey-and-nut-cake.jpg","https://crave.devyy.com/ai-images/shendetlie-honey-and-nut-cake.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Global-inspired shendetlie honey and nut cake with 9 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (6 servings). 4.8★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"6 servings","recipeCategory":"Cakes & Mug Cakes","recipeCuisine":"Global","keywords":"Shendetlie Honey and Nut Cake, Global, Cakes & Mug Cakes, #ShendetlieHon, #CraveMadeMeDoIt, #ViralDesserts, #GlobalSweets","nutrition":{"@type":"NutritionInformation","calories":"363 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":50},"recipeIngredient":["1.33 cup Sugar","3 whole Eggs","12 tbsp Melted Butter","3.11 cup Flour","6.7 tbsp Walnuts","4 tbsp Honey","1 tsp Baking Powder","0.98 cup Sugar","1.88 cup Water"],"recipeInstructions":[{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"In a mixing bowl cream together the eggs, sugar and cooled melted butter then add the honey and soda. Add half the flour and the walnuts (you can add the walnuts whole or ground them) and mix well. Incorporate 1.33 cup sugar, 3 whole eggs, 12 tbsp melted butter, and 3.11 cup flour smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/shendetlie-honey-and-nut-cake/#step-1"},{"@type":"HowToStep","name":"Dip & Coat Evenly","text":"Add the rest of the flour and using your hands kneed the mixture together until a firm dough is formed. Coat a large baking tray (traditionally a circle tray is used about 30cm is best with a 2 - 3 inch height) with olive oil. Add the dough and press it down so that it fits the whole tray. Try and get the dough flat and equal in height all over. Incorporate 6.7 tbsp walnuts, 4 tbsp honey, 1 tsp baking powder, 0.98 cup sugar, and 1.88 cup water smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/shendetlie-honey-and-nut-cake/#step-2"},{"@type":"HowToStep","name":"Shape & Press Dough Evenly","text":"Place on the bottom shelf of a cold oven and turn the temperture up to 180 degrees. Bake for 35 minutes and the dough has turned dark brown and is firm to touch. Remove from the oven and leave to cool while making the syrup.","url":"https://crave.devyy.com/recipes/shendetlie-honey-and-nut-cake/#step-3"},{"@type":"HowToStep","name":"Simmer & Dissolve Smoothly","text":"Add the sugar and water to a saucepan and bring to the boil. Leave boiling for 10 minutes, mixing occasionally. Remove from the heat. Cut the Shendetlie into squares of diamond shapes and pour over the hot syrup. Use enough of the syrup to cover the cake plus 1 cm overflowing, sitting on top. This will soak into the cake while you leave it to cool for at least 1 hour before serving.","url":"https://crave.devyy.com/recipes/shendetlie-honey-and-nut-cake/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Cakes & Mug Cakes","item":"https://crave.devyy.com/category/cakes-cupcakes/"},{"@type":"ListItem","position":3,"name":"Shendetlie Honey and Nut Cake","item":"https://crave.devyy.com/recipes/shendetlie-honey-and-nut-cake/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Shendetlie Honey and Nut Cake?","acceptedAnswer":{"@type":"Answer","text":"Shendetlie Honey and Nut Cake takes 45 minutes total (15 minutes prep) and yields 6 servings at 363 calories per serving."}},{"@type":"Question","name":"Can I make Shendetlie Honey and Nut Cake healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Shendetlie Honey and Nut Cake recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
