10:T1125,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/sticky-toffee-pudding/","name":"Sticky Toffee Pudding","image":["https://crave.devyy.com/ai-images/sticky-toffee-pudding.jpg","https://crave.devyy.com/ai-images/sticky-toffee-pudding.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"British-inspired sticky toffee pudding with 14 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (4 servings). 4.7★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"4 servings","recipeCategory":"Puddings & Custards","recipeCuisine":"British","keywords":"Sticky Toffee Pudding, British, Puddings & Custards, #StickyToffee, #CraveMadeMeDoIt, #ViralDesserts, #BritishSweets","nutrition":{"@type":"NutritionInformation","calories":"248 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.7,"reviewCount":246},"recipeIngredient":["6.7 tbsp Butter","11.7 tbsp Muscovado Sugar","2 pcs Eggs","1 cup Self-raising Flour","1 tsp Baking Powder","1 tsp Bicarbonate Of Soda","3 tbs Black Treacle","1.15 cup Milk","1 to serve Double Cream","6.7 tbsp Butter","8.3 tbsp Muscovado Sugar","1 tbs Black Treacle","1.25 cup Double Cream","1 tsp Vanilla Extract"],"recipeInstructions":[{"@type":"HowToStep","name":"Preheat & Prep Your Pan","text":"Preheat the oven to 180C/160C Fan/Gas 4. Butter a wide shallow 1.7-litre/3-pint ovenproof dish. Keep 6.7 tbsp butter, 11.7 tbsp muscovado sugar, 2 pcs eggs, and 1 cup self-raising flour prepped and measured within reach so each step comes together smoothly and evenly.","url":"https://crave.devyy.com/recipes/sticky-toffee-pudding/#step-1"},{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Put the butter, sugar, eggs, flour, baking powder, bicarbonate of soda and treacle into a mixing bowl. Beat using an electric handheld whisk for about 30 seconds or until combined. Pour in the milk gradually and whisk again until smooth. Pour into the prepared dish. Bake for 35–40 minutes or until well risen and springy in the centre. Incorporate 1 tsp baking powder, 1 tsp bicarbonate of soda, 3 tbs black treacle, 1.15 cup milk, 1 to serve double cream, 6.7 tbsp butter, 8.3 tbsp muscovado sugar, 1 tbs black treacle, 1.25 cup double cream, and 1 tsp vanilla extract smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/sticky-toffee-pudding/#step-2"},{"@type":"HowToStep","name":"Simmer & Dissolve Smoothly","text":"To make the sauce, put all the ingredients into a saucepan and stir over a low heat until the sugar has dissolved and the butter has melted. Bring to the boil, stirring for a minute.","url":"https://crave.devyy.com/recipes/sticky-toffee-pudding/#step-3"},{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"To serve, pour half the sauce over the pudding in the baking dish. Serve with the cream or ice cream. Plate into 4 generous servings while the flavors and textures are at their peak, and store any leftovers covered.","url":"https://crave.devyy.com/recipes/sticky-toffee-pudding/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Puddings & Custards","item":"https://crave.devyy.com/category/puddings-custards/"},{"@type":"ListItem","position":3,"name":"Sticky Toffee Pudding","item":"https://crave.devyy.com/recipes/sticky-toffee-pudding/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Sticky Toffee Pudding?","acceptedAnswer":{"@type":"Answer","text":"Sticky Toffee Pudding takes 45 minutes total (15 minutes prep) and yields 4 servings at 248 calories per serving."}},{"@type":"Question","name":"Can I make Sticky Toffee Pudding healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Sticky Toffee Pudding recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
