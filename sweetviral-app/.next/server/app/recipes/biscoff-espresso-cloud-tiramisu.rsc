10:T10e3,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/biscoff-espresso-cloud-tiramisu/","name":"Biscoff Espresso Cloud Tiramisu","image":["https://crave.devyy.com/ai-images/biscoff-espresso-cloud-tiramisu.jpg","https://crave.devyy.com/ai-images/biscoff-espresso-cloud-tiramisu.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_kitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Whipped mascarpone clouds layered with espresso-soaked biscuits & melted Biscoff drip. Ready in 15 mins (6 servings). 4.9★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT0M","totalTime":"PT15M","recipeYield":"6 servings","recipeCategory":"Cheesecake & Tiramisu","recipeCuisine":"Italian","keywords":"Biscoff Espresso Cloud Tiramisu, Italian, Cheesecake & Tiramisu, #Tiramisu, #CraveMadeMeDoIt, #ViralDesserts, #ItalianSweets","nutrition":{"@type":"NutritionInformation","calories":"360 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"reviewCount":354},"recipeIngredient":["8 oz Cold mascarpone cheese","1 cup Cold heavy whipping cream","0.33 cup Powdered icing sugar","18 pcs Savoiardi ladyfinger biscuits","1 cup Chilled strong espresso","0.33 cup Melted Biscoff cookie butter + cocoa dust"],"recipeInstructions":[{"@type":"HowToStep","name":"Line Pan & Prep Base Ingredients","text":"Line a loaf pan, baking dish, or serving glasses with parchment paper or chill them in the fridge for 5 minutes. Measure out 8 oz cold mascarpone cheese, 1 cup cold heavy whipping cream, and 0.33 cup powdered icing sugar so your base whips up thick, creamy, and clump-free.","url":"https://crave.devyy.com/recipes/biscoff-espresso-cloud-tiramisu/#step-1"},{"@type":"HowToStep","name":"Whip Cloud Cream to Soft Peaks","text":"Whip 8 oz cold mascarpone cheese, 1 cup cold heavy whipping cream, and 0.33 cup powdered icing sugar together for 3 minutes until thick, pillowy peaks hold. Line your chilling pan or tray with parchment paper for easy lifting, and keep 8 oz cold mascarpone cheese, 1 cup cold heavy whipping cream, and 0.33 cup powdered icing sugar measured and ready to combine.","url":"https://crave.devyy.com/recipes/biscoff-espresso-cloud-tiramisu/#step-2"},{"@type":"HowToStep","name":"Dip Ladyfingers (1 Second Each)","text":"Dip 18 pcs savoiardi ladyfinger biscuits briefly in 1 cup chilled strong espresso and line an 8x8 dish in an even layer. Gently press the coating onto every side so it adheres evenly, then let excess drip off before transferring to a clean tray.","url":"https://crave.devyy.com/recipes/biscoff-espresso-cloud-tiramisu/#step-3"},{"@type":"HowToStep","name":"Swirl Biscoff & Chill","text":"Spread half the mascarpone cream, drizzle warm 0.33 cup melted biscoff cookie butter + cocoa dust, repeat layers, and dust generously with dark cocoa powder. Chill or freeze until completely firm and set, then portion into 6 servings and store leftovers in an airtight container.","url":"https://crave.devyy.com/recipes/biscoff-espresso-cloud-tiramisu/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Cheesecake & Tiramisu","item":"https://crave.devyy.com/category/cheesecake-tiramisu/"},{"@type":"ListItem","position":3,"name":"Biscoff Espresso Cloud Tiramisu","item":"https://crave.devyy.com/recipes/biscoff-espresso-cloud-tiramisu/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Biscoff Espresso Cloud Tiramisu?","acceptedAnswer":{"@type":"Answer","text":"Biscoff Espresso Cloud Tiramisu takes 15 minutes total (15 minutes prep) and yields 6 servings at 360 calories per serving."}},{"@type":"Question","name":"Can I make Biscoff Espresso Cloud Tiramisu healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Biscoff Espresso Cloud Tiramisu recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
