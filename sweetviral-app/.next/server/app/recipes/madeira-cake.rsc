10:T1025,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/madeira-cake/","name":"Madeira Cake","image":["https://crave.devyy.com/ai-images/madeira-cake.jpg","https://crave.devyy.com/ai-images/madeira-cake.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"British-inspired madeira cake with 7 measured ingredients — zero sign-up, instant Cook Mode. Ready in 45 mins (6 servings). 4.7★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT30M","totalTime":"PT45M","recipeYield":"6 servings","recipeCategory":"Cakes & Mug Cakes","recipeCuisine":"British","keywords":"Madeira Cake, British, Cakes & Mug Cakes, #MadeiraCake, #CraveMadeMeDoIt, #ViralDesserts, #BritishSweets","nutrition":{"@type":"NutritionInformation","calories":"333 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.7,"reviewCount":80},"recipeIngredient":["11.7 tbsp Butter","11.7 tbsp Caster Sugar","3 whole Eggs","1.11 cup Self-raising Flour","3 tbs Milk","1 zest of 1 Lemon","1 to glaze Mixed Peel"],"recipeInstructions":[{"@type":"HowToStep","name":"Prep & Mix: Madeira Cake","text":"Pre-heat the oven to 180C/350F/Gas 4. Grease an 18cm/7in round cake tin, line the base with greaseproof paper and grease the paper. Cream the butter and sugar together in a bowl until pale and fluffy. Beat in the eggs, one at a time, beating the mixture well between each one and adding a tablespoon of the flour with the last egg to prevent the mixture curdling. Incorporate 11.7 tbsp butter, 11.7 tbsp caster sugar, 3 whole eggs, and 1.11 cup self-raising flour smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/madeira-cake/#step-1"},{"@type":"HowToStep","name":"Build Flavor: Madeira Cake","text":"Sift the flour and gently fold in, with enough milk to give a mixture that falls slowly from the spoon. Fold in the lemon zest. Spoon the mixture into the prepared tin and lightly level the top. Bake on the middle shelf of the oven for 30-40 minutes, or until golden-brown on top and a skewer inserted into the centre comes out clean. Incorporate 3 tbs milk, 1 zest of 1 lemon, and 1 to glaze mixed peel smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/madeira-cake/#step-2"},{"@type":"HowToStep","name":"Shape & Layer: Madeira Cake","text":"Remove from the oven and set aside to cool in the tin for 10 minutes, then turn it out on to a wire rack and leave to cool completely. To serve, decorate the cake with the candied peel.","url":"https://crave.devyy.com/recipes/madeira-cake/#step-3"},{"@type":"HowToStep","name":"Cool Completely, Garnish & Serve","text":"Transfer Madeira Cake to a wire cooling rack and let it cool for 15–20 minutes so the interior sets cleanly without crumbling. Lift out using the parchment overhang, garnish as desired, and slice into 6 portions.","url":"https://crave.devyy.com/recipes/madeira-cake/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Cakes & Mug Cakes","item":"https://crave.devyy.com/category/cakes-cupcakes/"},{"@type":"ListItem","position":3,"name":"Madeira Cake","item":"https://crave.devyy.com/recipes/madeira-cake/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Madeira Cake?","acceptedAnswer":{"@type":"Answer","text":"Madeira Cake takes 45 minutes total (15 minutes prep) and yields 6 servings at 333 calories per serving."}},{"@type":"Question","name":"Can I make Madeira Cake healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Madeira Cake recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
