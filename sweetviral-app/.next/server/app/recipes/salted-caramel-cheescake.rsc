10:T127a,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/salted-caramel-cheescake/","name":"Salted Caramel Cheescake","image":["https://crave.devyy.com/ai-images/salted-caramel-cheescake.jpg","https://crave.devyy.com/ai-images/salted-caramel-cheescake.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"United States-inspired salted caramel cheescake with 12 measured ingredients — zero sign-up, instant Cook Mode. Ready in 15 mins (6 servings). 4.8★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT0M","totalTime":"PT15M","recipeYield":"6 servings","recipeCategory":"Cakes & Mug Cakes","recipeCuisine":"United States","keywords":"Salted Caramel Cheescake, United States, Cakes & Mug Cakes, #SaltedCaramel, #CraveMadeMeDoIt, #ViralDesserts, #UnitedSweets","nutrition":{"@type":"NutritionInformation","calories":"298 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":142},"recipeIngredient":["1.11 cup Digestive Biscuits","5 tbsp Pretzels","9 tbsp Butter","2 cup Cream Cheese","1 tsp Vanilla Extract","6.7 tbsp Icing Sugar","10 tbsp Caramel","1 tsp Sea Salt","1.25 cup Double Cream","1 drizzle Caramel Sauce","1 top Toffee Popcorn","1 top Pretzels"],"recipeInstructions":[{"@type":"HowToStep","name":"Whisk & Combine Base Ingredients","text":"Blitz the biscuits and the pretzels in a food processor and mix the biscuits with the melted butter. Spread on the bottom of an 8″/20cm Deep Springform Tin and press down firmly. Leave to set in the fridge whilst you make the rest! Incorporate 1.11 cup digestive biscuits, 5 tbsp pretzels, 9 tbsp butter, and 2 cup cream cheese smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/salted-caramel-cheescake/#step-1"},{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Using an electric mixer, I use my KitchenAid with the whisk attachment, whisk together the cream cheese, vanilla, and icing sugar until smooth and then add the caramel and whisk again until smooth and lump free – this could take a couple of minutes, I whisk it at half speed so not too quick or slow! Incorporate 1 tsp vanilla extract, 6.7 tbsp icing sugar, 10 tbsp caramel, 1 tsp sea salt, 1.25 cup double cream, 1 drizzle caramel sauce, 1 top toffee popcorn, and 1 top pretzels smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/salted-caramel-cheescake/#step-2"},{"@type":"HowToStep","name":"Cream Butter & Sugar Fluffy","text":"Pour in the double cream & Salt flakes and continue to whisk for a couple of minutes until its very thick and mousse like (I mix it on a medium speed, level 6/10) – Now this could take up to 5 minutes depending on your mixer, but you seriously have to stick at it – it will hold itself completely when finished mixing (like a meringue does!) If you don’t mix it enough it will not set well enough, but don’t get impatient and whisk it really quick because that’ll make it split! Spread over the biscuit base and leave to set in the fridge overnight.","url":"https://crave.devyy.com/recipes/salted-caramel-cheescake/#step-3"},{"@type":"HowToStep","name":"Simmer & Dissolve Smoothly","text":"Remove the Cheesecake from the tin carefully and decorate the cheesecake – I drizzled over some of the spare caramel, and then some Toffee Popcorn and more Pretzels!","url":"https://crave.devyy.com/recipes/salted-caramel-cheescake/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Cakes & Mug Cakes","item":"https://crave.devyy.com/category/cakes-cupcakes/"},{"@type":"ListItem","position":3,"name":"Salted Caramel Cheescake","item":"https://crave.devyy.com/recipes/salted-caramel-cheescake/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Salted Caramel Cheescake?","acceptedAnswer":{"@type":"Answer","text":"Salted Caramel Cheescake takes 15 minutes total (15 minutes prep) and yields 6 servings at 298 calories per serving."}},{"@type":"Question","name":"Can I make Salted Caramel Cheescake healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Salted Caramel Cheescake recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
