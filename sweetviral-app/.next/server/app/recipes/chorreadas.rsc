10:Te7b,{"@context":"https://schema.org","@graph":[{"@type":"Recipe","mainEntityOfPage":"https://crave.devyy.com/recipes/chorreadas/","name":"Chorreadas","image":["https://crave.devyy.com/ai-images/chorreadas.jpg","https://crave.devyy.com/ai-images/chorreadas.jpg"],"datePublished":"2026-11-01","author":{"@type":"Person","name":"@crave_testkitchen"},"publisher":{"@type":"Organization","name":"Crave Recipes","url":"https://crave.devyy.com/","logo":{"@type":"ImageObject","url":"https://crave.devyy.com/icon-512.png","width":512,"height":512}},"description":"Global-inspired chorreadas with 9 measured ingredients — zero sign-up, instant Cook Mode. Ready in 15 mins (4 servings). 4.7★ rated with US/Metric scaling & hands-free Cook Mode.","prepTime":"PT15M","cookTime":"PT0M","totalTime":"PT15M","recipeYield":"4 servings","recipeCategory":"Global Classics","recipeCuisine":"Global","keywords":"Chorreadas, Global, Global Classics, #Chorreadas, #CraveMadeMeDoIt, #ViralDesserts, #GlobalSweets","nutrition":{"@type":"NutritionInformation","calories":"365 calories"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.7,"reviewCount":223},"recipeIngredient":["2 cups Sweetcorn","0.3333333333333333 cup Flour","0.25 cup Sugar","0.3333333333333333 cup Milk","2 whole Eggs","2 tbsp Butter","1 tsp Vanilla","0.25 tsp Cinnamon","1 pinch Salt"],"recipeInstructions":[{"@type":"HowToStep","name":"Prep & Mix: Chorreadas","text":"Using a food processor or a blender, combine all the ingredients, don't overdo it, the mixture should be crumby. Keep 2 cups sweetcorn, 0.3333333333333333 cup flour, 0.25 cup sugar, and 0.3333333333333333 cup milk prepped and measured within reach so each step comes together smoothly and evenly.","url":"https://crave.devyy.com/recipes/chorreadas/#step-1"},{"@type":"HowToStep","name":"Build Flavor: Chorreadas","text":"Heat a lightly oiled pan over medium-high heat. Pour 1/4 cup of the batter onto the pan. Cook until lightly brown on each side, just like making pancakes ;). Incorporate 2 whole eggs smoothly until evenly distributed.","url":"https://crave.devyy.com/recipes/chorreadas/#step-2"},{"@type":"HowToStep","name":"Shape & Layer: Chorreadas","text":"Traditionally you serve it with a spoon of sour cream on top. I just prefer to eat it plain. Plate into 4 generous servings while the flavors and textures are at their peak, and store any leftovers covered.","url":"https://crave.devyy.com/recipes/chorreadas/#step-3"},{"@type":"HowToStep","name":"Cool 1 Minute on Rack & Plate","text":"Transfer Chorreadas onto a wire rack for 60 seconds so steam escapes and the outside stays crisp. Top with 2 tbsp butter, 1 tsp vanilla, 0.25 tsp cinnamon, and 1 pinch salt and serve immediately into 4 portions.","url":"https://crave.devyy.com/recipes/chorreadas/#step-4"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://crave.devyy.com/"},{"@type":"ListItem","position":2,"name":"Global Classics","item":"https://crave.devyy.com/category/global-viral/"},{"@type":"ListItem","position":3,"name":"Chorreadas","item":"https://crave.devyy.com/recipes/chorreadas/"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does it take to make Chorreadas?","acceptedAnswer":{"@type":"Answer","text":"Chorreadas takes 15 minutes total (15 minutes prep) and yields 4 servings at 365 calories per serving."}},{"@type":"Question","name":"Can I make Chorreadas healthier or with zero refined sugar?","acceptedAnswer":{"@type":"Answer","text":"Yes! Toggle the Healthy Swap mode on this Chorreadas recipe page to convert ingredients into lower-sugar, higher-protein, or wholesome alternatives automatically."}}]}]}5:[["$","script",null,{"id":"crave-recipe-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11","$L12"]
